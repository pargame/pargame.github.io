      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">pointer_and_const.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;

int main() &#123;
    int a&#123;10&#125;;
    int b&#123;20&#125;;

    // 1. 상수 지시 포인터: 대상 수정 불가, 주소 변경 가능
    const int* p1 = &amp;a;
    // *p1 = 30; // 컴파일 에러! read-only variable is not assignable
    p1 = &amp;b;     // 정상: 다른 주소를 가리킴

    // 2. 상수 포인터: 대상 수정 가능, 주소 변경 불가
    int* const p2 = &amp;a;
    *p2 = 50;    // 정상: 원본 a의 값이 50으로 변경됨
    // p2 = &amp;b;  // 컴파일 에러! cannot assign to variable 'p2' with const-qualified type

    // 3. 상수 지시 상수 포인터: 둘 다 불가
    const int* const p3 = &amp;a;
    // *p3 = 99; // 컴파일 에러!
    // p3 = &amp;b;  // 컴파일 에러!

    std::println("최종 a: &#123;&#125;, b: &#123;&#125;, *p1: &#123;&#125;, *p2: &#123;&#125;, *p3: &#123;&#125;", a, b, *p1, *p2, *p3);
    return 0;
&#125;</code></pre>
