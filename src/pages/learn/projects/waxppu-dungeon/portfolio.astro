    <!-- 00. SYSTEM ARCHITECTURE DIAGRAM -->
    <section class="wp-section" id="arch">
      <div class="wp-section-head">
        <span class="wp-eyebrow">00 // SYSTEM ARCHITECTURE &amp; DATA FLOW</span>
        <h2>전체 시스템 아키텍처 구조도</h2>
      </div>

      <figure class="arch-figure" aria-labelledby="archDiagramTitle">
        <div class="arch-diagram">
          <div id="archDiagramTitle" class="arch-row-label">RUNTIME FLOW (플레이어의 한 번의 타격이 파괴 · 물리 · 소리로 이어지는 흐름)</div>
          <div class="arch-pipeline">
            <div class="arch-node accent-coral">
              <div class="node-tag">PLAYER</div>
              <div class="node-title">플레이어 입력 · 타게팅</div>
              <ul class="node-list">
                <li>조준 지점 주변을 구체 범위로 훑어 타격 대상을 찾음</li>
                <li>걸어가며 발밑 파편을 걷어참</li>
                <li>매 프레임 조준 위치를 계산해 셰이더에 전달</li>
              </ul>
            </div>

            <div class="arch-conn" aria-hidden="true">
              <span class="conn-fn">타격 전달</span>
              <span class="conn-arrow">→</span>
            </div>

            <div class="arch-node accent-mint">
              <div class="node-tag">MONSTER</div>
              <div class="node-title">몬스터 본체 (껍질 · 코어 · 눈알)</div>
              <ul class="node-list">
                <li>껍질·코어·눈알이 하나의 몸체 기준점에 묶여 함께 움직임</li>
                <li>두 눈알은 껍질과 따로 부서짐</li>
                <li>껍질이 무너지면 안쪽 코어가 튀어나옴</li>
              </ul>
            </div>

            <div class="arch-conn" aria-hidden="true">
              <span class="conn-fn">파괴 범위 · 힘</span>
              <span class="conn-fn">붕괴 신호</span>
              <span class="conn-arrow">→</span>
            </div>

            <div class="arch-node accent-peach">
              <div class="node-tag">DESTRUCTION</div>
              <div class="node-title">국소 파괴 제어</div>
              <ul class="node-list">
                <li>조준 범위 안쪽 조각만 골라 부숨</li>
                <li>껍질이 일정 비율 이상 깎이면 전체를 무너뜨림</li>
                <li>할 일이 있을 때만 갱신 루프를 켜 CPU 낭비를 줄임</li>
