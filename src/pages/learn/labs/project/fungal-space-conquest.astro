UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|Spatial")
float ChunkScanMoveThresholdCm = 250.0f; // 정지·미세 이동 시 스캔 스킵 거리

UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|Spatial")
