---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { Code } from 'astro:components';

const codeVictoryLoop = `// SpaceDrifterPawn.cpp — 포식자 10마리 처치 승리 판정 · V2(2마리)/V3(5마리) 처치 해금

void ASpaceDrifterPawn::NotifyEnemyDefeatedByPlayer()
{
	if (IsRunEnded())
	{
		return;
	}

	const bool bWasV2Unlocked = IsTendrilStyleUnlocked(ETendrilVisualStyle::GossamerSpores);
	const bool bWasV3Unlocked = IsTendrilStyleUnlocked(ETendrilVisualStyle::SporeJet);

	++DefeatedEnemyCount;

	const bool bUnlockedV2Now = !bWasV2Unlocked && IsTendrilStyleUnlocked(ETendrilVisualStyle::GossamerSpores);
	const bool bUnlockedV3Now = !bWasV3Unlocked && IsTendrilStyleUnlocked(ETendrilVisualStyle::SporeJet);

	if (DefeatedEnemyCount >= FMath::Max(TargetVictoryEnemyCount, 1))
	{
		EndRun(ESpaceRunState::Victory);
		return;
	}

	if (bUnlockedV2Now || bUnlockedV3Now)
	{
		if (const ASpaceDrifterPlayerController* PC = Cast<ASpaceDrifterPlayerController>(GetController()))
		{
			if (USpaceDrifterHUDWidget* HUD = PC->GetHUDWidget())
			{
				if (bUnlockedV3Now)
				{
					HUD->TriggerAbilityUnlockEffect(ETendrilVisualStyle::SporeJet);
				}
				else if (bUnlockedV2Now)
				{
					HUD->TriggerAbilityUnlockEffect(ETendrilVisualStyle::GossamerSpores);
				}
			}
		}
	}
}

bool ASpaceDrifterPawn::IsTendrilStyleUnlocked(ETendrilVisualStyle Style) const
{
	switch (Style)
	{
	case ETendrilVisualStyle::GossamerSpores:
		return DefeatedEnemyCount >= FMath::Max(V2UnlockDefeatedEnemyCount, 0);
	case ETendrilVisualStyle::SporeJet:
		return DefeatedEnemyCount >= FMath::Max(V3UnlockDefeatedEnemyCount, 0);
	case ETendrilVisualStyle::MyceliumWeb:
	default:
		return true;
	}
}`;

const codeLeaderboard = `// SpaceDrifterPawn.cpp (EndRun 발췌) — 판 종료 시 USaveGame 리더보드 영구 등록

// 리더보드에 이번 판 점수(적 처치 횟수 + 최대 반지름) 영구 등록
FString PlayerName = TEXT("익명 곰팡이");
if (ASpaceDrifterPlayerController* PC = Cast<ASpaceDrifterPlayerController>(GetController()))
{
	PlayerName = PC->GetCurrentPlayerName();
}

if (USpaceDrifterLeaderboardSave* SaveObj = USpaceDrifterLeaderboardSave::LoadOrCreate())
{
	FSpaceLeaderboardEntry Entry;
	Entry.PlayerName = PlayerName;
	Entry.DefeatedEnemies = DefeatedEnemyCount;
	Entry.MaxRadiusMeters = MaxReachedBodyRadiusCm * 0.01f;
	Entry.AbsorbedMinerals = ConsumedMineralCount;
	Entry.bClearedGoal = (NewState == ESpaceRunState::Victory);
	Entry.ClearTimeSeconds = ElapsedSurvivalSeconds;
	Entry.bSurvivedFullTime = Entry.bClearedGoal;
	SaveObj->AddScoreAndSave(Entry);
}

// SpaceDrifterLeaderboardSave.h — 10마리 완주 최단 시간 최우선 → 미완주는 처치 수 순 정렬

void SortEntries()
{
	Entries.Sort([](const FSpaceLeaderboardEntry& A, const FSpaceLeaderboardEntry& B)
	{
		if (A.bClearedGoal != B.bClearedGoal)
		{
			return A.bClearedGoal;
		}
		if (A.bClearedGoal && B.bClearedGoal)
		{
			if (!FMath::IsNearlyEqual(A.ClearTimeSeconds, B.ClearTimeSeconds, 0.005f))
			{
				return A.ClearTimeSeconds < B.ClearTimeSeconds;
			}
		}
		if (A.DefeatedEnemies != B.DefeatedEnemies)
		{
			return A.DefeatedEnemies > B.DefeatedEnemies;
		}
		if (A.AbsorbedMinerals != B.AbsorbedMinerals)
		{
			return A.AbsorbedMinerals > B.AbsorbedMinerals;
		}
		return A.MaxRadiusMeters > B.MaxRadiusMeters;
	});
}`;

const codeAttackTickets = `// EnemyMoldManager.cpp — 공격 티켓(MaxAttackingEnemies=2) · 비위협 0.5s 유예 · V2 둔화 보호 · 히스테리시스 교체

void AEnemyMoldManager::UpdateAttackTickets(const ASpaceDrifterPawn* PlayerPawn, const FVector& PlayerLoc, float DeltaTime)
{
	const int32 MaxTickets = FMath::Max(MaxAttackingEnemies, 1);

	// 1. 휴면·전염/배양 중인 보유자는 즉시 반납, 사냥 가능 전환은 유예 시간 경과 후 반납
	for (int32 Idx = AttackTicketHolders.Num() - 1; Idx >= 0; --Idx)
	{
		ASpaceEnemyMold* Holder = AttackTicketHolders[Idx].Enemy.Get();
		if (!IsValid(Holder) || Holder->IsDormant()
			|| Holder->GetColonizationState() != EEnemyMoldColonizationState::Uncolonized)
		{
			AttackTicketHolders.RemoveAtSwap(Idx);
			continue;
		}

		if (IsEnemyThreatToPlayer(Holder, PlayerPawn))
		{
			AttackTicketHolders[Idx].NonThreatElapsed = 0.0f;
		}
		else
		{
			AttackTicketHolders[Idx].NonThreatElapsed += DeltaTime;
			if (AttackTicketHolders[Idx].NonThreatElapsed >= TicketNonThreatGraceSeconds)
			{
				AttackTicketHolders.RemoveAtSwap(Idx);
			}
		}
	}

	// 2. MaxAttackingEnemies가 런타임에 줄어든 경우 초과분 정리 (둔화되지 않은 먼 적 우선)
	while (AttackTicketHolders.Num() > MaxTickets)
	{
		int32 RemoveIdx = 0;
		float MaxDistSq = -1.0f;
		for (int32 Idx = 0; Idx < AttackTicketHolders.Num(); ++Idx)
		{
			const ASpaceEnemyMold* Holder = AttackTicketHolders[Idx].Enemy.Get();
			const float DistSq = FVector::DistSquared(Holder->GetActorLocation(), PlayerLoc);
			const float Score = Holder->IsWebSlowed() ? (DistSq * 0.01f) : DistSq;
			if (Score > MaxDistSq)
			{
				MaxDistSq = Score;
				RemoveIdx = Idx;
			}
		}
		AttackTicketHolders.RemoveAtSwap(RemoveIdx);
	}

	// 3. 비보유 위협 적 후보군 수집 후 거리 오름차순 정렬
	struct FCandidateInfo
	{
		ASpaceEnemyMold* Enemy = nullptr;
		float DistCm = 0.0f;
	};
	TArray<FCandidateInfo> Candidates;
	for (ASpaceEnemyMold* Enemy : EnemyPool)
	{
		if (!IsValid(Enemy) || Enemy->IsDormant() || HasAttackTicket(Enemy))
		{
			continue;
		}
		if (!IsEnemyThreatToPlayer(Enemy, PlayerPawn))
		{
			continue;
		}
		Candidates.Add({ Enemy, static_cast<float>(FVector::Distance(Enemy->GetActorLocation(), PlayerLoc)) });
	}
	Candidates.Sort([](const FCandidateInfo& A, const FCandidateInfo& B)
	{
		return A.DistCm < B.DistCm;
	});

	// 4. 빈 슬롯 보충
	int32 CandidateCursor = 0;
	while (AttackTicketHolders.Num() < MaxTickets && CandidateCursor < Candidates.Num())
	{
		FAttackTicketEntry NewEntry;
		NewEntry.Enemy = Candidates[CandidateCursor++].Enemy;
		NewEntry.NonThreatElapsed = 0.0f;
		AttackTicketHolders.Add(NewEntry);
	}

	// 5. 만석 시 히스테리시스 기반 교체 (V2 둔화 중인 보유자는 교체 대상에서 보호, 둔화 해제 시 즉시 복귀)
	while (CandidateCursor < Candidates.Num())
	{
		int32 FarthestSwappableIdx = INDEX_NONE;
		float FarthestDistCm = -1.0f;
		for (int32 Idx = 0; Idx < AttackTicketHolders.Num(); ++Idx)
		{
			const ASpaceEnemyMold* Holder = AttackTicketHolders[Idx].Enemy.Get();
			if (!IsValid(Holder) || Holder->IsWebSlowed())
			{
				continue;
			}
			const float DistCm = FVector::Distance(Holder->GetActorLocation(), PlayerLoc);
			if (DistCm > FarthestDistCm)
			{
				FarthestDistCm = DistCm;
				FarthestSwappableIdx = Idx;
			}
		}

		if (FarthestSwappableIdx == INDEX_NONE)
		{
			break;
		}

		const FCandidateInfo& ClosestCandidate = Candidates[CandidateCursor];
		if (FarthestDistCm > ClosestCandidate.DistCm + TicketSwapHysteresisCm)
		{
			AttackTicketHolders[FarthestSwappableIdx].Enemy = ClosestCandidate.Enemy;
			AttackTicketHolders[FarthestSwappableIdx].NonThreatElapsed = 0.0f;
			++CandidateCursor;
		}
		else
		{
			break;
		}
	}
}`;

const codeStandoffRing = `// EnemyMoldManager.cpp (Tick 발췌) — 카메라 침투 방지 + 티켓 보유자 리드 추격 vs 비티켓 포위 링 선회

// 카메라가 포식자(WPO 가시 포함) 내부/초근접 영역에 진입하면 시각 메시만 임시 숨겨 화면 가림·어지럼 방지
const float CamHideThreshold = EnemyRadius * FMath::Max(CameraOcclusionHideRadiusMultiplier, 1.0f) + 45.0f;
const bool bCameraInsideEnemy = FVector::DistSquared(CamLoc, EnemyLoc) < FMath::Square(CamHideThreshold);
Enemy->SetCameraProximityHidden(bCameraInsideEnemy);

if (HasAttackTicket(Enemy))
{
	// 공격 티켓 보유자: 리드 추격(Lead Pursuit) 돌진 + 서로 뭉치지 않도록 측면 분산 반발
	const float LeadScale = FMath::Clamp(DistToPlayer / FMath::Max(EffectiveMaxSpeed, 100.0f), 0.0f, LeadPursuitSeconds);
	const FVector PredictedTarget = PlayerLoc + PlayerVel * LeadScale;
	const FVector RawChaseDir = (PredictedTarget - EnemyLoc).GetSafeNormal();
	const FVector ChaseDir = (RawChaseDir + SeparationVector * (EnemySeparationWeight * 0.75f)).GetSafeNormal();

	if (!ChaseDir.IsNearlyZero())
	{
		EnemySphere->AddForce(ChaseDir * EffectiveAccel, NAME_None, true);
	}
}
else
{
	// 비티켓 적(대기 포식자·사냥 가능 적): 넓은 포위 링(Standoff) 거리를 유지하며 선회 추종
	FVector RadialFromPlayer = (EnemyLoc - PlayerLoc).GetSafeNormal();
	if (RadialFromPlayer.IsNearlyZero())
	{
		RadialFromPlayer = FVector::ForwardVector;
	}

	const FVector RefAxis = (PoolIndex % 3 == 0)
		? FVector::UpVector
		: ((PoolIndex % 3 == 1) ? FVector::RightVector : FVector::ForwardVector);
	FVector OrbitDir = FVector::CrossProduct(RadialFromPlayer, RefAxis).GetSafeNormal();
	if (OrbitDir.IsNearlyZero())
	{
		OrbitDir = FVector::CrossProduct(RadialFromPlayer, FVector::UpVector).GetSafeNormal();
	}
	if (PoolIndex % 2 != 0)
	{
		OrbitDir = -OrbitDir;
	}

	if (SurfaceDist > StandoffMax)
	{
		const float LeadScale = FMath::Clamp(DistToPlayer / FMath::Max(EffectiveMaxSpeed, 100.0f), 0.0f, LeadPursuitSeconds);
		const FVector PredictedTarget = PlayerLoc + PlayerVel * LeadScale;
		const FVector ApproachDir = ((PredictedTarget - EnemyLoc).GetSafeNormal() + SeparationVector * EnemySeparationWeight).GetSafeNormal();
		if (!ApproachDir.IsNearlyZero())
		{
			EnemySphere->AddForce(ApproachDir * EffectiveAccel, NAME_None, true);
		}
	}
	else if (SurfaceDist < StandoffMin)
	{
		const FVector RetreatDir = (RadialFromPlayer * 0.85f + OrbitDir * 0.45f + SeparationVector * EnemySeparationWeight).GetSafeNormal();
		if (!RetreatDir.IsNearlyZero())
		{
			EnemySphere->AddForce(RetreatDir * EffectiveAccel, NAME_None, true);
		}
	}
	else
	{
		const float RadialCorrection = FMath::Clamp((StandoffMid - SurfaceDist) / StandoffHalfSpan, -1.0f, 1.0f);
		const FVector DesiredOrbitDir = (RadialFromPlayer * (RadialCorrection * 0.65f)
			+ OrbitDir * 0.85f
			+ SeparationVector * EnemySeparationWeight).GetSafeNormal();
		const float RingSpeed = FMath::Max(EffectiveMaxSpeed * FMath::Clamp(StandoffOrbitSpeedRatio, 0.1f, 1.5f), 40.0f);
		const FVector CurVel = EnemySphere->GetPhysicsLinearVelocity();
		const FVector DesiredVel = PlayerVel.GetClampedToMaxSize(EffectiveMaxSpeed) + DesiredOrbitDir * RingSpeed;
		const FVector VelError = DesiredVel - CurVel;
		if (!VelError.IsNearlyZero())
		{
			EnemySphere->AddForce(VelError.GetSafeNormal() * EffectiveAccel, NAME_None, true);
		}
	}
}
`;

const codeSpawnRespawn = `// EnemyMoldManager.cpp — 최대 도달 크기 기준 스폰 · 빈 필드 2초 리스폰 · 단일 진실 위협 판정

// TrySpawnOneEnemy 발췌: 현재 크기가 아닌 MaxReachedBodyRadiusCm 기준으로 포식자 크기를 산출

const float ReferenceRadius = PlayerPawn->MaxReachedBodyRadiusCm;
const float MinMul = FMath::Min(SpawnRadiusMultiplierRange.X, SpawnRadiusMultiplierRange.Y);
const float MaxMul = FMath::Max(SpawnRadiusMultiplierRange.X, SpawnRadiusMultiplierRange.Y);
const float RadiusMul = FMath::FRandRange(MinMul, MaxMul);
const float EnemyRadius = FMath::Clamp(ReferenceRadius * RadiusMul, 45.0f, PlayerPawn->MaxBodyRadiusCm * 1.15f);

const float RadiusExp = FMath::Clamp(PlayerPawn->BiomassToRadiusExponent, 0.2f, 0.8f);
const float InvExp = 1.0f / RadiusExp;
const float BaseRadius = FMath::Max(PlayerPawn->InitialBodyRadiusCm, 10.0f);
const float EnemyBiomass = FMath::Max(PlayerPawn->InitialBiomass, 10.0f) * FMath::Pow(EnemyRadius / BaseRadius, InvExp);

FreeEnemy->ActivateAt(this, SpawnLoc, EnemyBiomass, EnemyRadius);

void AEnemyMoldManager::NotifyEnemyDefeated(ASpaceEnemyMold* DefeatedEnemy)
{
	AttackTicketHolders.RemoveAll([DefeatedEnemy](const FAttackTicketEntry& Entry)
	{
		return !Entry.Enemy.IsValid() || Entry.Enemy.Get() == DefeatedEnemy;
	});
	const float NextDelay = (GetActiveEnemyCount() == 0)
		? FMath::Max(EmptyFieldRespawnCooldownSeconds, 0.5f)
		: DefeatRespawnCooldownSeconds;
	ScheduleNextSpawn(NextDelay, true);
}

bool AEnemyMoldManager::IsEnemyThreatToPlayer(const ASpaceEnemyMold* Enemy, const ASpaceDrifterPawn* PlayerPawn) const
{
	if (!IsValid(Enemy) || !IsValid(PlayerPawn) || Enemy->IsDormant())
	{
		return false;
	}
	if (Enemy->GetColonizationState() != EEnemyMoldColonizationState::Uncolonized)
	{
		return false;
	}

	// V1으로 전염(사냥) 가능한 상태(필요 생체량 < 가용 생체량)면 위협이 아니며 피격되지 않음
	const float PlayerUsable = FMath::Max(PlayerPawn->CurrentBiomass - PlayerPawn->GetTendrilMinGameOverBiomass(), 0.0f)
		+ PlayerPawn->GetInvestedColonizeBiomass();
	const float RequiredToHunt = Enemy->GetRequiredColonizeBiomass();
	return RequiredToHunt >= PlayerUsable;
}`;

const codePawnCamera = `// SpaceDrifterPawn.cpp — FQuat 6-DoF 궤도 카메라 · 속력/본체 크기 비례 스프링암

void ASpaceDrifterPawn::DoLook(float Yaw, float Pitch)
{
	AController* PC = GetController();
	if (!PC || PC->IsLookInputIgnored())
	{
		return;
	}
	if (const ASpaceDrifterPlayerController* DrifterPC = Cast<ASpaceDrifterPlayerController>(GetController()))
	{
		if (DrifterPC->IsInTitleScreen() || IsRunEnded())
		{
			return;
		}
	}

	const float ScaledYawRad = FMath::DegreesToRadians(Yaw * OrbitLookSensitivity);
	const float ScaledPitchRad = FMath::DegreesToRadians(Pitch * OrbitLookSensitivity);

	const FQuat YawDelta(FVector::UpVector, ScaledYawRad);
	const FQuat PitchDelta(FVector::RightVector, ScaledPitchRad);
	TargetCameraOrbitQuat = (TargetCameraOrbitQuat * YawDelta * PitchDelta).GetNormalized();

	if (OrbitRotationLagSpeed <= 0.0f && CameraPivot)
	{
		SmoothedCameraOrbitQuat = TargetCameraOrbitQuat;
		CameraPivot->SetRelativeRotation(SmoothedCameraOrbitQuat);
	}
}

void ASpaceDrifterPawn::UpdateCameraOrbit(float DeltaTime)
{
	if (!CameraPivot)
	{
		return;
	}

	const ASpaceDrifterPlayerController* DrifterPC = Cast<ASpaceDrifterPlayerController>(GetController());
	const bool bShouldAutoOrbit = (DrifterPC && DrifterPC->IsInTitleScreen()) || IsRunEnded();
	if (bShouldAutoOrbit && TitleCameraOrbitSpeedDegPerSec > KINDA_SMALL_NUMBER)
	{
		const float AutoYawRad = FMath::DegreesToRadians(TitleCameraOrbitSpeedDegPerSec * DeltaTime);
		const FQuat AutoYawDelta(FVector::UpVector, AutoYawRad);
		TargetCameraOrbitQuat = (TargetCameraOrbitQuat * AutoYawDelta).GetNormalized();
	}

	if (OrbitRotationLagSpeed > 0.0f)
	{
		SmoothedCameraOrbitQuat = FMath::QInterpTo(SmoothedCameraOrbitQuat, TargetCameraOrbitQuat, DeltaTime, OrbitRotationLagSpeed).GetNormalized();
	}
	else
	{
		SmoothedCameraOrbitQuat = TargetCameraOrbitQuat;
	}

	CameraPivot->SetRelativeRotation(SmoothedCameraOrbitQuat);

	if (CameraBoom)
	{
		const FVector CurrentVel = GetTendrilBodyVelocity();
		const float SpeedAlpha = FMath::Clamp(CurrentVel.Size() / FMath::Max(SpeedCameraReferenceSpeed, 200.0f), 0.0f, 1.0f);
		const float BodyScale = GetTendrilBodyScale();
		const float CameraSizeScale = FMath::Pow(BodyScale, FMath::Max(CameraArmBodyScaleExponent, 0.0f));
		const float SocketOffsetScale = FMath::Pow(BodyScale, FMath::Max(CameraSocketOffsetBodyScaleExponent, 0.0f));
		const float ScaledBaseArm = BaseCameraArmLength * CameraSizeScale;
		const float DesiredArmLen = bEnableSpeedDynamicCameraArm
			? (ScaledBaseArm + FMath::Max(SpeedCameraMaxExtensionCm, 0.0f) * CameraSizeScale * SpeedAlpha)
			: ScaledBaseArm;

		CameraBoom->TargetArmLength = FMath::FInterpTo(
			CameraBoom->TargetArmLength,
			DesiredArmLen,
			DeltaTime,
			FMath::Max(SpeedCameraInterpSpeed, 0.5f)
		);
		CameraBoom->SocketOffset = BaseCameraSocketOffset * SocketOffsetScale;

		CameraBoom->CameraLagSpeed = FMath::Lerp(
			FMath::Max(BaseCameraLagSpeed, 1.0f),
			FMath::Max(MaxSpeedCameraLagSpeed, BaseCameraLagSpeed),
			SpeedAlpha
		);
		CameraBoom->CameraLagMaxDistance = FMath::Max(MaxCameraLagDistanceCm, 0.0f) * CameraSizeScale;
	}
}`;

const codeBodyScale = `// SpaceDrifterPawn.cpp — 생체량 → 반지름(지수 0.40) 성장 · 질량 s³ 연동 · 최대 도달 크기 기록

void ASpaceDrifterPawn::UpdateBodyScaleFromBiomass()
{
	const float BaseBiomass = FMath::Max(InitialBiomass, 10.0f);
	const float BaseRadius = FMath::Max(InitialBodyRadiusCm, 10.0f);
	const float MinRadius = FMath::Clamp(MinGameOverBodyRadiusCm, 5.0f, BaseRadius - 1.0f);
	const float MaxRadius = FMath::Max(MaxBodyRadiusCm, BaseRadius);

	const float RadiusExp = FMath::Clamp(BiomassToRadiusExponent, 0.2f, 0.8f);
	const float InvRadiusExp = 1.0f / RadiusExp;
	const float MaxBiomass = BaseBiomass * FMath::Pow(MaxRadius / BaseRadius, InvRadiusExp);
	CurrentBiomass = FMath::Clamp(CurrentBiomass, GetTendrilMinGameOverBiomass(), MaxBiomass);

	const float BiomassRatio = FMath::Max(CurrentBiomass / BaseBiomass, 0.001f);
	CurrentBodyRadiusCm = FMath::Clamp(BaseRadius * FMath::Pow(BiomassRatio, RadiusExp), MinRadius, MaxRadius);
	MaxReachedBodyRadiusCm = FMath::Max(MaxReachedBodyRadiusCm, CurrentBodyRadiusCm);

	const float ScaleFactor = CurrentBodyRadiusCm / BaseRadius;
	const float PhysicalVolumeRatio = FMath::Pow(ScaleFactor, 3.0f);

	if (CollisionSphere)
	{
		CollisionSphere->SetSphereRadius(CurrentBodyRadiusCm, true);
		CollisionSphere->SetMassOverrideInKg(NAME_None, FMath::Max(PlayerMassKg * PhysicalVolumeRatio, 30.0f), true);
	}
	if (DrifterMesh)
	{
		DrifterMesh->SetRelativeScale3D(InitialMeshRelativeScale * ScaleFactor);
	}
}`;

const codeElasticity = `// SpaceDrifterPawn.cpp — Chaos 속도 기반 가속도 감지 + 능력별 본체 스트레치 + 2차 감쇠 스프링

void ASpaceDrifterPawn::UpdateElasticity(float DeltaTime)
{
	const float SimDt = FMath::Min(DeltaTime, 0.05f);
	if (SimDt <= KINDA_SMALL_NUMBER)
	{
		return;
	}

	const FVector CurrentLocation = GetActorLocation();
	const bool bUsePhysicsVelocity = (bEnableChaosPhysics && CollisionSphere && CollisionSphere->IsSimulatingPhysics());
	const FVector CurrentVelocity = bUsePhysicsVelocity
		? CollisionSphere->GetPhysicsLinearVelocity()
		: (CurrentLocation - PreviousActorLocation) / SimDt;
	float TargetDeform = 0.0f;

	if (bSuppressAccelDeformThisTick)
	{
		bSuppressAccelDeformThisTick = false;
	}
	else if (bHasVelocityHistory)
	{
		const FVector Acceleration = (CurrentVelocity - PreviousWorldVelocity) / SimDt;
		const float AccelMag = Acceleration.Size();
		if (AccelMag > AccelerationDeadzone)
		{
			const FVector AccelDir = Acceleration / AccelMag;
			const FVector AlignedDir = (FVector::DotProduct(DeformAxis, AccelDir) < 0.0f) ? -AccelDir : AccelDir;
			DeformAxis = FMath::VInterpTo(DeformAxis, AlignedDir, SimDt, 12.0f).GetSafeNormal();
			TargetDeform = FMath::Clamp((AccelMag - AccelerationDeadzone) * AccelerationDeformScale, 0.0f, MaxDeformAmount);
		}
	}

	PreviousActorLocation = CurrentLocation;
	PreviousWorldVelocity = CurrentVelocity;
	bHasVelocityHistory = true;

	if (ActiveTendrilAbility)
	{
		FVector StretchDir = FVector::ForwardVector;
		const float TendrilDeform = ActiveTendrilAbility->EvaluateHostBodyStretch(ElapsedFloatTime, StretchDir);
		if (TendrilDeform > TargetDeform)
		{
			const FVector AlignedDir = (FVector::DotProduct(DeformAxis, StretchDir) < 0.0f) ? -StretchDir : StretchDir;
			DeformAxis = FMath::VInterpTo(DeformAxis, AlignedDir, SimDt, 14.0f).GetSafeNormal();
			TargetDeform = FMath::Clamp(TendrilDeform, 0.0f, MaxDeformAmount);
		}
	}

	const float SpringForce = SpringStiffness * (TargetDeform - DeformValue);
	const float DampingForce = -SpringDamping * DeformVelocity;
	DeformVelocity += (SpringForce + DampingForce) * SimDt;

	constexpr float MinDeform = -0.45f;
	const float RawNextDeform = DeformValue + DeformVelocity * SimDt;
	if (RawNextDeform <= MinDeform)
	{
		DeformValue = MinDeform;
		if (DeformVelocity < 0.0f)
		{
			DeformVelocity = -DeformVelocity * 0.65f;
		}
	}
	else if (RawNextDeform >= MaxDeformAmount)
	{
		DeformValue = MaxDeformAmount;
		if (DeformVelocity > 0.0f)
		{
			DeformVelocity = 0.0f;
		}
	}
	else
	{
		DeformValue = RawNextDeform;
	}
}`;

