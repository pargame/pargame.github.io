void AAsteroidFieldManager::ComputeDirectionalRadii(
	const FVector& OffsetFromPlayer,
	const FVector& ForwardDir,
	float ForwardExtensionCm,
	float& OutMinSpawnRadiusCm,
	float& OutMaxDespawnRadiusCm) const
{
	const float Dist = OffsetFromPlayer.Size();
	const float ForwardAlign = (Dist > KINDA_SMALL_NUMBER)
		? FVector::DotProduct(OffsetFromPlayer / Dist, ForwardDir)
		: 0.0f;

	// 전방 반구(-0.20 ~ +0.85) 구간에 걸쳐 A와 B를 진행 방향으로 확장 (후방은 기본 A/B 고정)
	const float ForwardLobe = FMath::SmoothStep(-0.20f, 0.85f, ForwardAlign);
	const float OuterExt = FMath::Max(ForwardExtensionCm, 0.0f) * ForwardLobe;
	const float InnerExt = OuterExt * FMath::Clamp(ForwardInnerExtensionFraction, 0.0f, 1.0f);

	OutMinSpawnRadiusCm = InnerNoSpawnRadiusCm + InnerExt;
	OutMaxDespawnRadiusCm = FMath::Max(OuterDespawnRadiusCm + OuterExt, OutMinSpawnRadiusCm + 1200.0f);
}

// [규칙 5·6] 삭제 대기 큐 평가 및 <= B 재진입 시 구제 (RunFieldLifecycleStep 발췌)
if (DistSq <= OuterBSq)
{
	if (Entry.bPendingDespawn)
	{
		Entry.bPendingDespawn = false;
		Entry.DespawnQueuedTime = 0.0;
		++TotalDespawnRescuesCount; // 유예 시간 내 재진입으로 삭제 큐에서 탈출
	}
}
else if (!Entry.bPendingDespawn)
{
	Entry.bPendingDespawn = true;
	Entry.DespawnQueuedTime = NowTime;
	PendingDespawnQueue.Add(PoolIdx);
}

FVector AAsteroidFieldManager::SampleDirectionInShell(
	const FVector& ForwardDir,
	bool bUseForwardBias,
	FRandomStream& Stream) const
{
	if (!bUseForwardBias || ForwardSpawnBiasWeight <= KINDA_SMALL_NUMBER || Stream.GetFraction() > ForwardSpawnBiasWeight)
	{
		FVector UnitDir = Stream.VRand();
		return UnitDir.IsNearlyZero() ? FVector::ForwardVector : UnitDir.GetSafeNormal();
	}

	// 코사인 가중 원뿔(전방 중심 밀집)로 샘플링하여 88.4% 이상을 플레이어 전방 반구에 집중 배치
	const FVector SafeFwd = ForwardDir.IsNearlyZero() ? FVector::ForwardVector : ForwardDir.GetSafeNormal();
	const FVector UpRef = (FMath::Abs(SafeFwd.Z) < 0.92f) ? FVector::UpVector : FVector::RightVector;
	const FVector BasisRight = FVector::CrossProduct(UpRef, SafeFwd).GetSafeNormal();
	const FVector BasisUp = FVector::CrossProduct(SafeFwd, BasisRight).GetSafeNormal();

	const float U = Stream.GetFraction();
	const float CosTheta = FMath::Lerp(-0.08f, 1.0f, FMath::Pow(U, 0.58f));
	const float SinTheta = FMath::Sqrt(FMath::Max(0.0f, 1.0f - CosTheta * CosTheta));
	const float Phi = Stream.FRandRange(0.0f, UE_TWO_PI);

	const FVector Dir = SafeFwd * CosTheta + (BasisRight * FMath::Cos(Phi) + BasisUp * FMath::Sin(Phi)) * SinTheta;
	return Dir.IsNearlyZero() ? SafeFwd : Dir.GetSafeNormal();
}`;

const codeTendrilBranchAndRetract = `// Source/UEStudy/Sandbox/MiniProject/SpaceDrifterPawn.h & .cpp — 근거리 가지 억제 & 형태 고정 체내 수축
UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "SpaceDrifter|LongTendril")
float LongTendrilBranchMinTrunkCm = 420.0f; // 4.2m 이하 근거리 발사 시 곁가지 0개 보장

int32 ASpaceDrifterPawn::ComputeLongTendrilBranchCountForLength(float TargetTrunkLenCm) const
{
	if (LongTendrilBranchFrequency <= KINDA_SMALL_NUMBER || TargetTrunkLenCm <= LongTendrilBranchMinTrunkCm)
	{
		return 0; // 근거리 착탄 시 빗자루 뭉침 방지
	}
	const float FullMaxLen = FMath::Max(LongTendrilMaxLength, LongTendrilBranchMinTrunkCm + 100.0f);
	const int32 FullCount = FMath::Clamp(FMath::RoundToInt((FullMaxLen / 100.0f) * LongTendrilBranchFrequency), 0, 64);
	const float LenRatio = FMath::Clamp(
		(TargetTrunkLenCm - LongTendrilBranchMinTrunkCm) / FMath::Max(FullMaxLen - LongTendrilBranchMinTrunkCm, 100.0f),
		0.0f, 1.0f);
	return FMath::Clamp(FMath::RoundToInt(static_cast<float>(FullCount) * FMath::Pow(LenRatio, 1.35f)), 0, 64);
}

// 회수 및 인양(Reeling In) 시 줄기 길이 단축에 따라 가지가 깜빡이지 않고 체내로 슬라이딩 흡수
if (!bIsExtendingTendril || (bHasLatchedTarget && TendrilExtendAlpha >= TendrilPullActivationAlpha && CurrentLiveLenCm < PeakTrunkLengthCm - 1.0f))
{
	bIsTendrilReelingIn = true; // 형태 고정 플래그 ON
}
const float DeployedRefLenCm = bHasLockedTendrilAim
	? FMath::Max(bIsTendrilReelingIn ? PeakTrunkLengthCm : LockedInitialTargetLenCm, 50.0f)
	: FMath::Max(LongTendrilMaxLength, 50.0f);

// Niagara FX로 전달: 조형 고정 + 몸체 안쪽 진입 오프셋만 전달
TargetFX->SetIntParameter(TEXT("User.SideBranchCount"), DesiredBranchCount);
TargetFX->SetFloatParameter(TEXT("User.DeployedRefLengthCm"), DeployedRefLenCm);
TargetFX->SetFloatParameter(TEXT("User.TrunkRetractOffsetCm"), TrunkRetractOffsetCm);`;

const codePhysicsTierAndAbilityOOP = `// 1. Source/UEStudy/Sandbox/MiniProject/AsteroidFieldManager.cpp — 2-Tier Chaos 물리 풀 & 원거리 Kinematic 분리
void AAsteroidFieldManager::UpdatePhysicsSimulationTiers(const FVector& PlayerLocation, AActor* LatchedTarget)
{
	const double ActRadiusSq = FMath::Square(static_cast<double>(PhysicsActivationRadiusCm)); // 35m 이내 Chaos 진입
	const double DeactRadiusSq = FMath::Square(static_cast<double>(PhysicsActivationRadiusCm + PhysicsHysteresisCm)); // 42m 이탈 시 강등

	TArray<FPhysicsCandidate> Candidates;
	for (const int32 PoolIdx : ActivePoolIndices)
	{
		ASpaceAsteroid* Asteroid = PoolEntries[PoolIdx].Asteroid.Get();
		if (!IsValid(Asteroid)) continue;

		const bool bProtected = (LatchedTarget && Asteroid == LatchedTarget);
		const double DistSq = FVector::DistSquared(Asteroid->GetActorLocation(), PlayerLocation);
		const bool bCurrentlyChaos = Asteroid->IsPhysicsTierActive();
		const bool bEligible = bProtected || (bCurrentlyChaos ? (DistSq <= DeactRadiusSq) : (DistSq <= ActRadiusSq));

		if (bEligible) Candidates.Add({ PoolIdx, DistSq, bProtected });
		else if (bCurrentlyChaos) Asteroid->SetPhysicsSimulationTier(false); // 원거리는 Chaos 솔버에서 즉시 제외
	}

	// 플레이어 기준 가장 가까운 상위 MaxActivePhysicsAsteroids(48개)만 Chaos 솔버에 등록
	if (Candidates.Num() > MaxActivePhysicsAsteroids)
	{
		Candidates.Sort([](const FPhysicsCandidate& A, const FPhysicsCandidate& B) {
			return (A.bProtected != B.bProtected) ? A.bProtected : (A.DistSq < B.DistSq);
		});
		for (int32 i = MaxActivePhysicsAsteroids; i < Candidates.Num(); ++i)
		{
			PoolEntries[Candidates[i].PoolIdx].Asteroid->SetPhysicsSimulationTier(false);
		}
		Candidates.SetNum(MaxActivePhysicsAsteroids, EAllowShrinking::No);
	}
	for (const FPhysicsCandidate& Cand : Candidates)
	{
		PoolEntries[Cand.PoolIdx].Asteroid->SetPhysicsSimulationTier(true);
	}
}

// 2. Source/UEStudy/Sandbox/MiniProject/SpaceTendrilAbility.h & SpaceDrifterPawn.cpp — 언리얼 표준 0-Tick Ability 다형성
UCLASS(Abstract, BlueprintType, Blueprintable, EditInlineNew, DefaultToInstanced)
class UESTUDY_API USpaceTendrilAbility : public UObject
{
	GENERATED_BODY()
public:
	virtual void InitializeAbility(TScriptInterface<ISpaceTendrilHostInterface> InHost);
	virtual bool CanActivateAbility() const;
	virtual bool OnInputStarted();
	virtual void OnInputEnded();
	virtual void TickActiveAbility(float DeltaTime);

	// Idle 상태일 때는 false를 반환해 ASpaceDrifterPawn::Tick에서 아예 호출되지 않음 (0-Tick)
	FORCEINLINE bool IsAbilityTickActive() const
	{
		return AbilityState != ETendrilAbilityState::Idle || ExtendAlpha > KINDA_SMALL_NUMBER || HasPendingActiveWork();
	}
};

// ASpaceDrifterPawn::Tick — 평상시(Idle)에는 촉수 Tick 비용 0, 발동 중에만 현재 장착된 Ability 1개 구동
if (ActiveTendrilAbility && ActiveTendrilAbility->IsAbilityTickActive())
{
	ActiveTendrilAbility->TickActiveAbility(DeltaTime);
}`;

const codeBuiltInFirstMilestone14 = `// 1. V3 분사 촉수: 수동 UStaticMeshComponent 48개 풀링 240줄 삭제 -> 내장 나이아가라(bLocalSpace=true + MeshRenderer) 위임
void UJetTendrilAbility::OnActiveTick(float DeltaTime, const FVector& VisualOrigin, const FVector& StartPos, const FVector& EndPos, float EasedReach)
{
	ISpaceTendrilHostInterface* HostIfc = Host.GetInterface();
	if (!HostIfc) return;

	float ActiveSpawnRate = 0.0f;
	if (IsExtending())
	{
		if (!ConsumeJetResource(DeltaTime)) { BeginRetract(true); }
		else
		{
			LatchCameraAimBasis();
			if (UPrimitiveComponent* HostPhys = HostIfc->GetTendrilPhysicsComponent())
			{
				HostPhys->WakeRigidBody();
				HostPhys->AddImpulse(-LockedAimDir * (ThrustAccelerationCmPerSec2 * DeltaTime), NAME_None, true);
			}
			ActiveSpawnRate = FMath::Clamp(ProjectileSpawnRateScale * 0.45f, 30.0f, 96.0f);
		}
	}

	if (UFXSystemComponent* FX = HostIfc->GetTendrilFXComponent(ETendrilVisualStyle::SporeJet))
	{
		FX->SetWorldLocationAndRotation(VisualOrigin + LockedAimDir * 3.0f, LockedAimDir.Rotation());
		FX->SetFloatParameter(TEXT("User.TendrilAlpha"), ExtendAlpha);
		FX->SetFloatParameter(TEXT("User.SporeSpawnRate"), ActiveSpawnRate);
		if (!FX->IsActive()) FX->Activate(true);
	}
}

// 2. ASpaceAsteroid: 하드코딩 수식 -> 내장 FRuntimeFloatCurve(SizeDistributionCurve / SpeedDistributionCurve) 위임
