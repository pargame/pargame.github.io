---
import '../../../styles/projects/nav-breadcrumb.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const unrealProjects = [
  {
    slug: 'fungal-space-conquest',
    title: '곰팡이 우주 정복 대작전',
    status: 'COMPLETED · UE 5.9 (macOS / Windows)',
    path: 'C++ · 6-Kill & 200-Mineral Time Attack',
    date: 'Updated 2026. 11. 20',
    accent: 'var(--success)',
    tagColor: 'var(--accent-2)',
    cta: 'var(--accent)',
    ctaText: 'var(--text-inverse)',
    summary:
      '무중력 6-DoF 환경에서 <strong>포식자 6마리 처치 &amp; 미네랄 200개 타임어택</strong>을 구현한 UE 5.9 C++ 게임 클라이언트. <strong>TickGroup 실행 순서 고정</strong>, <strong>UInterface 기반 0-Tick 능력 객체</strong>, <strong>공격 티켓 · 포위 링 AI</strong>, <strong>1,150 소행성 2-Tier 물리 스트리밍</strong>, <strong>M4 16GB 통합 메모리 실측 최적화</strong>를 각 섹션마다 설계 배경 · 결정 · 검증 순으로 정리했습니다.',
    tags: ['#UE5_9', '#AttackTicketAI', '#ZeroTickAbilityOOP', '#UInterface', '#TwoTierChaosPhysics', '#M4_16GB_Optimization'],
    image: {
      src: '/images/projects/fungal-space-conquest/blog-pie-idle.png',
      alt: 'UE 5.9 Lvl_Main 우주 공간에서 부유 중인 곰팡이 우주 정복 대작전 BP_SpaceDrifterPawn PIE 뷰포트',
    },
    caption: 'PIE Capture (1920×1080) · Lvl_Main + BP_SpaceDrifterPawn',
    note: '"구현은 AI가, 설계는 인간이" — 기획서와 UE 5.9 C++ 포트폴리오를 프로젝트 홈에서 선택해 볼 수 있습니다.',
    github: 'https://github.com/pargame/FungalSpaceConquest',
  },
  {
    slug: 'waxppu-dungeon',
    title: '왁뿌던전 탈출 (WaxPpuLab)',
    status: 'PROTOTYPING · UE 5.9',
    path: 'Chaos Solver · ACharacter · MetaSound',
    date: 'Updated 2026. 11. 24',
    accent: '#ff5e9c',
    tagColor: '#ff9f43',
    cta: 'linear-gradient(135deg, #ff5e9c, #ff8a3d)',
    ctaText: '#ffffff',
    summary:
      '언리얼 엔진 내장 <strong>Chaos 물리 솔버</strong>와 <strong>ACharacter</strong>를 적극 활용하는 3D 물리 파괴 웨이브 디펜스. UE 5.9 C++ 프로토타입(<code>WaxPpuLab</code>)의 실시간 왁스 파괴, 버터 양방향 텀블링, Weber-Fechner 하이브리드 ASMR 오디오, Subsurface 셰이딩과 M4 16GB 최적화 기록을 담았습니다.',
    tags: ['#UE5_9', '#ChaosDestruction', '#ACharacter', '#MetaSound', '#WaxPpuLab'],
    image: null,
    caption: 'UE 5.9 Prototype · Chaos Destruction + Hybrid ASMR',
    note: '기획서(DOC 01)와 WaxPpuLab 기술 개발기(DOC 02)를 프로젝트 홈에서 확인할 수 있습니다.',
    github: 'https://github.com/pargame/WaxPpuLab',
  },
];

const otherProjects = [
  {
    slug: 'metal-cube',
    title: 'Metal Cube (3D Rotating Cube)',
    status: 'COMPLETED · C++26 · metal-cpp',
    accent: '#38bdf8',
    summary:
      'Objective-C 브릿지 없이 순수 C++26과 Apple 공식 metal-cpp로 구현한 9단계 의미론적 3D 회전 큐브 렌더링 파이프라인.',
    tags: ['#Cpp26', '#MetalCpp', '#MSL', '#3DGraphics', '#RAII'],
    github: 'https://github.com/pargame/metal-cube',
    live: null,
  },
  {
    slug: 'pocopia',
    title: '포코피아 (Pokopia)',
    status: 'COMPLETED · LIVE SERVICE',
    accent: '#10b981',
    summary:
      '닌텐도 스위치2 게임 「포코피아」의 써드파티 클라우드섬 실시간 공유 웹 플랫폼. Flask API, 다국어(ko/en/ja), Cloudflare Tunnel로 운영.',
    tags: ['#Python', '#Flask', '#CloudflareTunnel', '#i18n', '#pokoclouds'],
    github: 'https://github.com/pargame/pocopia',
    live: 'https://pokoclouds.com',
  },
  {
    slug: 'nung-lang',
    title: 'nung_lang (눙 언어)',
    status: 'DESIGN · LANGUAGE',
    accent: '#a78bfa',
    summary:
      '언어가 막을 수 있는 문제는 모두 막고 초고속 실행을 지향하는 자체 프로그래밍 언어 및 추상 머신 설계 프로젝트.',
    tags: ['#LanguageDesign', '#AbstractMachine', '#TypeSystem', '#StaticSafety'],
    github: null,
    live: null,
  },
  {
    slug: 'whynode',
    title: 'WhyNode (와이노드)',
    status: 'COMPLETED · NATIVE APP',
    accent: '#f59e0b',
    summary:
      '소크라테스식 재귀 질문을 무한 캔버스 위 지식 트리로 확장하는 macOS 네이티브 마인드맵 앱.',
    tags: ['#SwiftUI', '#macOS', '#Canvas', '#ForceDirectedGraph'],
    github: 'https://github.com/pargame/whynode',
    live: null,
  },
  {
    slug: 'biz-agent-sim',
    title: 'BizAgentSim',
    status: 'DESIGN · SIMULATION',
    accent: '#6366f1',
    summary:
      '비즈니스 업무 자동화 AI 에이전트를 가상 시뮬레이션 환경에서 사전 검증하는 이산 사건 시뮬레이션(DES) 테스트베드 설계 프로젝트.',
    tags: ['#AIAgents', '#DES', '#MultiAgent', '#ReliabilityTesting'],
    github: null,
    live: null,
  },
];

// 완료된 프로젝트를 위층, 진행 중인 프로젝트를 아래층에 둔다. 상태 문자열이 COMPLETED로 시작하면 완료다.
const isCompleted = (project: { status: string }) => project.status.startsWith('COMPLETED');
const tiers = [
  {
    id: 'completed',
    badge: 'COMPLETED',
    title: '완료된 프로젝트',
    desc: '구현과 검증을 마친 프로젝트입니다. 프로젝트 홈에서 문서와 저장소를 볼 수 있습니다.',
    unreal: unrealProjects.filter(isCompleted),
    other: otherProjects.filter(isCompleted),
  },
  {
    id: 'in-progress',
    badge: 'IN PROGRESS',
    title: '진행 중인 프로젝트',
    desc: '설계 또는 프로토타입 단계의 프로젝트입니다. PRIVATE 표시는 비공개 리포지토리입니다.',
    unreal: unrealProjects.filter((p) => !isCompleted(p)),
    other: otherProjects.filter((p) => !isCompleted(p)),
  },
];
---

<BaseLayout
  title="Projects: 개발 프로젝트"
  description="pargame 개발 프로젝트 아카이브 — 게임 엔진, 3D 그래픽스, 웹 플랫폼, 자체 언어, 네이티브 앱 및 AI 시뮬레이션"
>
  <div class="note-header">
    <nav class="breadcrumb" aria-label="이동 경로">
      <a href="/">Home</a>
      <span>/</span>
      <span class="current">Projects</span>
    </nav>

    <div class="topic-tag">TRACK // PROJECTS</div>
    <h1>Projects: 개발 프로젝트</h1>
    <p class="topic-desc">
      게임 엔진과 3D 그래픽스 파이프라인부터 웹 플랫폼, 자체 프로그래밍 언어, 네이티브 앱, AI 에이전트 시뮬레이션까지 개별 리포지토리 단위로 설계하고 구현한 프로젝트 아카이브입니다.
    </p>
  </div>

  {tiers.map((tier) => (
    <section class="projects-section" id={tier.id}>
      <div class="section-title-wrap">
        <span class="badge">{tier.badge}</span>
        <h2>{tier.title}</h2>
        <p>{tier.desc}</p>
      </div>

      {tier.unreal.length > 0 && (
        <div class="showcase-list">
          {tier.unreal.map((project) => (
            <article
              class="project-showcase"
              style={`--sc-accent: ${project.accent}; --sc-tag: ${project.tagColor}; --sc-cta: ${project.cta}; --sc-cta-text: ${project.ctaText}`}
            >
              <div class="showcase-top">
                <div class="showcase-badges">
                  <span class="status-pill">
                    <span class="pulse-dot"></span>
                    {project.status}
                  </span>
                  <span class="path-pill">{project.path}</span>
                </div>
                <span class="updated-meta">{project.date}</span>
              </div>

              <div class="showcase-body">
                <div class="showcase-copy">
                  <h2>
                    <a href={`/learn/projects/${project.slug}`}>{project.title}</a>
                  </h2>
                  <p class="project-subtitle" set:html={project.summary} />
                  <div class="stack-tags">
                    {project.tags.map((tag) => (
                      <span class="stack-tag showcase-tag">{tag}</span>
                    ))}
                  </div>
                </div>

                <a
                  href={`/learn/projects/${project.slug}`}
                  class="showcase-preview"
                  aria-label={`${project.title} 프로젝트 홈 열기`}
                >
                  {project.image ? (
                    <img src={project.image.src} alt={project.image.alt} loading="eager" />
                  ) : (
                    <div class="waxppu-art">
                      <span class="wax-orb"></span>
                      <span class="wax-art-label">CHAOS × ACHARACTER</span>
                    </div>
                  )}
                  <span class="preview-caption">{project.caption}</span>
                </a>
              </div>

              <div class="showcase-footer">
                <div class="footer-note">{project.note}</div>
                <div class="footer-actions">
                  {project.github && (
                    <a href={project.github} class="cta-btn secondary" target="_blank" rel="noopener noreferrer">
                      GitHub ↗
                    </a>
                  )}
                  <a href={`/learn/projects/${project.slug}`} class="cta-btn">
                    프로젝트 보기 →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}

      {tier.other.length > 0 && (
        <div class={`compact-grid${tier.unreal.length > 0 ? ' after-showcase' : ''}`}>
          {tier.other.map((project) => (
            <article class="compact-card" style={`--card-accent: ${project.accent}`}>
              <div class="compact-top">
                <span class="compact-status">
                  <span class="compact-dot"></span>
                  {project.status}
                </span>
                {!project.github && <span class="private-pill">PRIVATE</span>}
              </div>
              <h3>
                <a href={`/learn/projects/${project.slug}`}>{project.title}</a>
              </h3>
              <p class="compact-summary">{project.summary}</p>
              <div class="stack-tags">
                {project.tags.map((tag) => (
                  <span class="stack-tag compact-tag">{tag}</span>
                ))}
              </div>
              <div class="compact-actions">
                <a href={`/learn/projects/${project.slug}`} class="compact-btn primary">
                  프로젝트 보기 →
                </a>
                {project.live && (
                  <a href={project.live} class="compact-btn secondary" target="_blank" rel="noopener noreferrer">
                    Live ↗
                  </a>
                )}
                {project.github && (
                  <a href={project.github} class="compact-btn secondary" target="_blank" rel="noopener noreferrer">
                    GitHub ↗
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  ))}
</BaseLayout>

<style>
.compact-grid.after-showcase {
  margin-top: 1.5rem;
}
.note-header {
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border-subtle);
  margin-bottom: 3rem;
}
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  color: var(--text-3);
  margin-bottom: 1rem;
}
.topic-tag {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--accent-2);
  letter-spacing: 0.08em;
  margin-bottom: 0.5rem;
}
.note-header h1 {
  margin: 0 0 1rem;
  font-size: clamp(1.8rem, 1.5rem + 1.5vw, 2.6rem);
}
.topic-desc {
  font-size: 1.05rem;
  color: var(--text-2);
  line-height: 1.7;
  max-width: 820px;
}
.projects-section {
  margin-bottom: 4rem;
}
.section-title-wrap {
  margin-bottom: 1.8rem;
}
.section-title-wrap .badge {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent-2);
  margin-bottom: 0.4rem;
}
.section-title-wrap h2 {
  margin: 0 0 0.4rem;
}
.section-title-wrap p {
  color: var(--text-3);
  margin: 0;
}
.showcase-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.project-showcase {
  border-color: color-mix(in srgb, var(--sc-accent) 32%, var(--border));
  background: radial-gradient(circle at 92% 14%, color-mix(in srgb, var(--sc-accent) 10%, transparent), transparent 42%), var(--surface-1);
  border-width: 1px;
  border-style: solid;
  border-radius: var(--radius-lg);
  padding: 2rem;
  box-shadow: var(--shadow-1);
  display: flex;
  flex-direction: column;
  gap: 1.8rem;
}
.showcase-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.8rem;
  padding-bottom: 1.2rem;
  border-bottom: 1px solid var(--border-subtle);
}
.showcase-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  align-items: center;
}
.status-pill,
.path-pill {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 700;
  padding: 0.28rem 0.65rem;
  border-radius: 999px;
  border: 1px solid var(--border-subtle);
}
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: var(--sc-accent);
  background: color-mix(in srgb, var(--sc-accent) 12%, transparent);
  border-color: color-mix(in srgb, var(--sc-accent) 35%, transparent);
}
.pulse-dot {
  width: 0.45rem;
  height: 0.45rem;
  border-radius: 50%;
  background: var(--sc-accent);
  box-shadow: 0 0 8px var(--sc-accent);
}
.path-pill {
  color: var(--text-2);
  background: var(--surface-2);
}
.showcase-body {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: 2rem;
  align-items: center;
}
.showcase-copy h2 {
  margin: 0 0 0.8rem;
  font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
}
.showcase-copy h2 a {
  color: var(--text-1);
  text-decoration: none;
}
.showcase-copy h2 a:hover {
  color: var(--accent);
}
.project-subtitle {
  color: var(--text-2);
  line-height: 1.75;
  margin-bottom: 1.4rem;
}
.project-subtitle strong {
  color: var(--text-1);
}
.stack-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}
.stack-tag {
  font-family: var(--font-mono);
  font-size: 0.76rem;
  padding: 0.2rem 0.55rem;
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  border: 1px solid var(--border-subtle);
  color: var(--accent-2);
}
.showcase-tag {
  color: var(--sc-tag);
  border-color: color-mix(in srgb, var(--sc-tag) 28%, var(--border-subtle));
}
.showcase-preview {
  display: block;
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  border: 1px solid var(--border);
  background: var(--code-bg);
  text-decoration: none;
  transition: transform var(--dur), border-color var(--dur), box-shadow var(--dur);
}
.showcase-preview:hover {
  transform: translateY(-2px);
  border-color: var(--sc-accent);
  box-shadow: 0 10px 28px -10px color-mix(in srgb, var(--sc-accent) 45%, transparent);
}
.showcase-preview img {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 10;
  object-fit: cover;
}
.preview-caption {
  display: block;
  padding: 0.55rem 0.9rem;
  background: var(--surface-2);
  border-top: 1px solid var(--border-subtle);
  font-family: var(--font-mono);
  font-size: 0.74rem;
  color: var(--text-3);
}
.showcase-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  padding-top: 1.2rem;
  border-top: 1px solid var(--border-subtle);
}
.footer-note {
  font-size: 0.86rem;
  color: var(--text-3);
}
.cta-btn {
  display: inline-flex;
  align-items: center;
  padding: 0.7rem 1.35rem;
  border-radius: var(--radius-sm);
  background: var(--sc-cta);
  color: var(--sc-cta-text);
  font-weight: 700;
  font-size: 0.92rem;
  text-decoration: none;
  transition: all var(--dur-fast);
}
.footer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
}
.cta-btn.secondary {
  background: var(--surface-2);
  color: var(--text-1);
  border: 1px solid var(--border);
}
.cta-btn.secondary:hover {
  background: var(--surface-2);
  border-color: var(--sc-accent);
  color: var(--sc-accent);
  box-shadow: none;
  filter: none;
}
.cta-btn:hover {
  background: var(--sc-cta);
  color: var(--sc-cta-text);
  filter: brightness(1.08);
  box-shadow: var(--glow);
}
.waxppu-art {
  aspect-ratio: 16 / 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.85rem;
  background: radial-gradient(circle at 30% 25%, rgba(255, 94, 156, 0.24), transparent 52%), radial-gradient(circle at 75% 75%, rgba(255, 159, 67, 0.22), transparent 52%), var(--surface-2);
}
.wax-orb {
  width: 82px;
  height: 82px;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, #ffd1e6 0%, #ff5e9c 48%, #ff8a3d 100%);
  box-shadow: inset -8px -10px 18px rgba(130, 18, 66, 0.35), inset 6px 6px 14px rgba(255, 255, 255, 0.45), 0 10px 24px -6px rgba(255, 94, 156, 0.55);
}
.wax-art-label {
  font-family: var(--font-mono);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #ff5e9c;
}
.compact-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.35rem;
}
.compact-card {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-top: 3px solid var(--card-accent);
  border-radius: var(--radius-lg);
  padding: 1.55rem;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
  transition: transform var(--dur-fast), border-color var(--dur-fast), box-shadow var(--dur-fast);
}
.compact-card:hover {
  transform: translateY(-2px);
  border-color: var(--card-accent);
  box-shadow: 0 10px 26px -14px color-mix(in srgb, var(--card-accent) 40%, transparent);
}
.compact-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}
.compact-status {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.22rem 0.58rem;
  border-radius: 999px;
  color: var(--card-accent);
  background: color-mix(in srgb, var(--card-accent) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--card-accent) 32%, transparent);
}
.compact-dot {
  width: 0.4rem;
  height: 0.4rem;
  border-radius: 50%;
  background: var(--card-accent);
  box-shadow: 0 0 6px var(--card-accent);
}
.private-pill {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  padding: 0.16rem 0.5rem;
