      <p id="lightboxCaption" class="lightbox-caption"></p>
    </div>
  </dialog>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1) 코드 복사 버튼
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy') || '';
          try {
            await navigator.clipboard.writeText(text);
            const prev = btn.textContent;
            btn.textContent = 'Copied ✓';
            btn.setAttribute('data-copied', 'true');
            setTimeout(() => {
              btn.textContent = prev || 'Copy';
              btn.removeAttribute('data-copied');
            }, 1600);
          } catch (_) {
            btn.textContent = 'Failed';
          }
        });
      });

      // 2) 이미지 라이트박스
      const dialog = document.getElementById('imgLightbox');
      const dialogImg = document.getElementById('lightboxImg');
      const dialogCap = document.getElementById('lightboxCaption');
      const closeBtn = document.getElementById('closeLightboxBtn');

      document.querySelectorAll('.zoomable-img').forEach((img) => {
        img.addEventListener('click', () => {
          if (!dialog || !dialogImg || !dialogCap) return;
          dialogImg.src = img.getAttribute('src') || '';
          dialogImg.alt = img.getAttribute('alt') || '';
          const figcap = img.closest('figure')?.querySelector('figcaption')?.textContent || img.alt || '';
          dialogCap.textContent = figcap;
          dialog.showModal();
        });
      });

      closeBtn?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });

      // 3) 플로팅 TOC ScrollSpy (cpp.astro 동일 UX)
      const topBtn = document.getElementById('scrollTopBtn');
      const bottomBtn = document.getElementById('scrollBottomBtn');
      const navCard = document.querySelector('.floating-nav-card');
      const tocLinks = document.querySelectorAll('.floating-toc-link');
      const sections = Array.from(document.querySelectorAll('.lesson-section'));

      let currentActiveId = null;
      let isNavHovered = false;
      let isManualClick = false;
      let clickTimeout = null;

      if (navCard) {
        navCard.addEventListener('mouseenter', () => { isNavHovered = true; });
        navCard.addEventListener('mouseleave', () => { isNavHovered = false; });
      }

      function scrollNavCardToActive(linkEl, force = false) {
        if (!navCard || !linkEl) return;
        if (window.innerWidth <= 1180) return;
        if (isNavHovered && !force) return;

        const cardRect = navCard.getBoundingClientRect();
        const linkRect = linkEl.getBoundingClientRect();
        const isPartiallyHidden = linkRect.top < cardRect.top + 45 || linkRect.bottom > cardRect.bottom - 45;
        if (isPartiallyHidden || force) {
          const relativeTop = linkRect.top - cardRect.top;
          const targetScrollTop = navCard.scrollTop + relativeTop - (navCard.clientHeight / 2) + (linkRect.height / 2);
          navCard.scrollTo({ top: targetScrollTop, behavior: 'smooth' });
        }
      }

      function setActiveLink(targetId, forceScroll = false) {
        if (!targetId) return;
        if (targetId === currentActiveId && !forceScroll) return;
        currentActiveId = targetId;

        let activeLinkEl = null;
        tocLinks.forEach((link) => {
          if (link.getAttribute('data-target') === targetId) {
            link.classList.add('active');
            activeLinkEl = link;
          } else {
            link.classList.remove('active');
          }
        });

        if (activeLinkEl) {
          scrollNavCardToActive(activeLinkEl, forceScroll);
        }
      }

      topBtn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      bottomBtn?.addEventListener('click', () => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }));

      tocLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const targetId = link.getAttribute('data-target');
          isManualClick = true;
          clearTimeout(clickTimeout);
          setActiveLink(targetId, true);
          clickTimeout = setTimeout(() => { isManualClick = false; }, 1000);
        });
      });

      function onScroll() {
        if (isManualClick) return;
        const scrollY = window.scrollY;
        const offset = window.innerHeight * 0.35;
        let currentSectionId = null;

        for (let i = sections.length - 1; i >= 0; i--) {
          const sec = sections[i];
          const top = sec.getBoundingClientRect().top + scrollY;
          if (scrollY + offset >= top) {
            currentSectionId = sec.getAttribute('id');
            break;
          }
        }

        if (currentSectionId) {
          setActiveLink(currentSectionId);
        } else if (sections.length > 0 && scrollY < 250) {
          setActiveLink(sections[0].getAttribute('id'));
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    });
  </script>
