const codeCameraOrbit = `// SpaceDrifterPawn.cpp — 쿼터니언 기반 360도 궤도 카메라 회전 & 보간
void ASpaceDrifterPawn::DoLook(float Yaw, float Pitch)
{
	AController* PC = GetController();
	if (!PC || PC->IsLookInputIgnored())
	{
		return;
	}

	const float ScaledYawRad = FMath::DegreesToRadians(Yaw * OrbitLookSensitivity);
	const float ScaledPitchRad = FMath::DegreesToRadians(Pitch * OrbitLookSensitivity);

	const FQuat YawDelta(FVector::UpVector, ScaledYawRad);
	const FQuat PitchDelta(FVector::RightVector, ScaledPitchRad);
	TargetCameraOrbitQuat = (TargetCameraOrbitQuat * YawDelta * PitchDelta).GetNormalized();

	if (OrbitRotationLagSpeed <= 0.0f && CameraPivot)
	{
		SmoothedCameraOrbitQuat = TargetCameraOrbitQuat;
		CameraPivot->SetRelativeRotation(SmoothedCameraOrbitQuat);
	}
}

void ASpaceDrifterPawn::UpdateCameraOrbit(float DeltaTime)
{
	if (!CameraPivot) { return; }

	if (OrbitRotationLagSpeed > 0.0f)
	{
		SmoothedCameraOrbitQuat = FMath::QInterpTo(
			SmoothedCameraOrbitQuat, TargetCameraOrbitQuat, DeltaTime, OrbitRotationLagSpeed
		).GetNormalized();
	}
	else
	{
		SmoothedCameraOrbitQuat = TargetCameraOrbitQuat;
	}

	CameraPivot->SetRelativeRotation(SmoothedCameraOrbitQuat);
}`;

const codeElasticity = `// SpaceDrifterPawn.cpp — 가속도 자동 감지 + 촉수 연동 + 2차 감쇠 스프링
void ASpaceDrifterPawn::UpdateElasticity(float DeltaTime)
{
	const float SimDt = FMath::Min(DeltaTime, 0.05f);
	if (SimDt <= KINDA_SMALL_NUMBER) { return; }

	// 1) 프레임 간 액터 위치 변화로 월드 가속도 자동 감지
	const FVector CurrentLocation = GetActorLocation();
	const FVector CurrentVelocity = (CurrentLocation - PreviousActorLocation) / SimDt;
	float TargetDeform = 0.0f;

	if (bHasVelocityHistory)
	{
		const FVector Acceleration = (CurrentVelocity - PreviousWorldVelocity) / SimDt;
		const float AccelMag = Acceleration.Size();
		if (AccelMag > AccelerationDeadzone)
		{
			const FVector AccelDir = Acceleration / AccelMag;
			const FVector AlignedDir = (FVector::DotProduct(DeformAxis, AccelDir) < 0.0f) ? -AccelDir : AccelDir;
			DeformAxis = FMath::VInterpTo(DeformAxis, AlignedDir, SimDt, 12.0f).GetSafeNormal();
			TargetDeform = FMath::Clamp((AccelMag - AccelerationDeadzone) * AccelerationDeformScale, 0.0f, MaxDeformAmount);
		}
	}

	PreviousActorLocation = CurrentLocation;
	PreviousWorldVelocity = CurrentVelocity;
	bHasVelocityHistory = true;

	// 2) 촉수 전개 중 조준 방향으로 본체 스트레치 연동
	const float TendrilDeform = (TendrilExtendAlpha > KINDA_SMALL_NUMBER && bIsExtendingTendril)
		? (TendrilBodyStretch * TendrilExtendAlpha)
		: 0.0f;
	if (TendrilDeform > TargetDeform)
	{
		const FVector AlignedDir = (FVector::DotProduct(DeformAxis, LastTendrilDir) < 0.0f) ? -LastTendrilDir : LastTendrilDir;
		DeformAxis = FMath::VInterpTo(DeformAxis, AlignedDir, SimDt, 14.0f).GetSafeNormal();
		TargetDeform = FMath::Clamp(TendrilDeform, 0.0f, MaxDeformAmount);
	}

	// 3) 2차 감쇠 스프링-댐퍼 적분 & 부호 있는 클램핑
	const float SpringForce = SpringStiffness * (TargetDeform - DeformValue);
	const float DampingForce = -SpringDamping * DeformVelocity;
	DeformVelocity += (SpringForce + DampingForce) * SimDt;
	DeformValue = FMath::Clamp(DeformValue + DeformVelocity * SimDt, -0.45f, MaxDeformAmount);
}`;

const codeTendrilParams = `// SpaceDrifterPawn.cpp — 긴 촉수(V1) 동적 곁가지 개수 계산 및 Niagara User.* 파라미터 푸시
int32 ASpaceDrifterPawn::ComputeLongTendrilBranchCount() const
{
	if (LongTendrilBranchFrequency <= KINDA_SMALL_NUMBER)
	{
		return 0;
	}
	const float TrunkMeters = FMath::Max(LongTendrilMaxLength, 0.0f) / 100.0f;
	return FMath::Clamp(FMath::RoundToInt(TrunkMeters * LongTendrilBranchFrequency), 0, 64);
}

void ASpaceDrifterPawn::PushLongTendrilUserParameters(UFXSystemComponent* TargetFX)
{
	if (!TargetFX) { return; }

	const int32 DesiredBranchCount = ComputeLongTendrilBranchCount();
	LastPushedSideBranchCount = DesiredBranchCount;

	TargetFX->SetIntParameter(TEXT("User.SideBranchCount"), DesiredBranchCount);
	TargetFX->SetFloatParameter(TEXT("User.TrunkWidth"), FMath::Max(LongTendrilTrunkWidth, 0.2f));
	TargetFX->SetFloatParameter(TEXT("User.TipWidthRatio"), FMath::Clamp(LongTendrilTipWidthRatio, 0.0f, 3.0f));
	TargetFX->SetFloatParameter(TEXT("User.SideBranchLength"), FMath::Max(LongTendrilBranchLength, 1.0f));
	TargetFX->SetFloatParameter(TEXT("User.SideBranchWidth"), FMath::Max(LongTendrilBranchWidth, 0.1f));
	TargetFX->SetFloatParameter(TEXT("User.BranchBaseToTipRatio"), FMath::Clamp(LongTendrilBaseToTipLengthRatio, 0.0f, 4.0f));
	TargetFX->SetFloatParameter(TEXT("User.BranchStartRatio"), FMath::Clamp(LongTendrilBranchStartRatio, 0.02f, 0.90f));
	TargetFX->SetFloatParameter(TEXT("User.BranchSpreadScale"), FMath::Max(LongTendrilBranchSpreadScale, 0.05f));
}`;

const codeHoldAndNet = `// SpaceDrifterPawn.cpp — V1(홀드+최대유지제한) vs V2(단발 최대 전개) 입력 및 타이머 분기
void ASpaceDrifterPawn::OnExtendTendrilEnded(const FInputActionValue& Value)
{
	bIsExtendInputHeld = false;
	// V2 (그물 촉수)는 단발 발사이므로 키를 떼도 최대 전개 및 유지 후 자동 수축을 끝까지 진행
	if (TendrilVisualStyle == ETendrilVisualStyle::GossamerSpores)
	{
		return;
	}
	SetTendrilExtending(false);
}

float ASpaceDrifterPawn::GetActiveHoldDurationLimit() const
{
	if (TendrilVisualStyle == ETendrilVisualStyle::GossamerSpores)
	{
		return FMath::Max(NetTendrilHoldDuration, 0.0f);
	}
	return bLimitLongTendrilHoldDuration ? FMath::Max(LongTendrilMaxHoldDuration, 0.0f) : -1.0f;
}

// UpdateTendril() 내부: 최대 전개(1.0) 도달 후 허용 유지시간 차감 및 자동 회수
if (bIsExtendingTendril && bHoldLimitArmed)
{
	if (TendrilExtendAlpha >= 1.0f - KINDA_SMALL_NUMBER)
	{
		TendrilExtendAlpha = 1.0f;
		MaxExtendHoldTimeRemaining -= DeltaTime;
		if (MaxExtendHoldTimeRemaining <= 0.0f)
		{
			SetTendrilExtending(false);
		}
	}
}`;

