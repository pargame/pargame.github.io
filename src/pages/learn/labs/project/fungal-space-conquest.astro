// .uproject 인자 없이 에디터 바이너리만 실행하면 FApp::HasProjectName()이 false가 되어
// ProjectBinariesRootDirectory가 비워진 채 모듈 탐색이 진행됨 -> 모듈 누락 팝업 유발
FString ProjectBinariesRootDirectory;
if (FApp::HasProjectName())
{
	ProjectBinariesRootDirectory = FPlatformMisc::ProjectDir();
#if !IS_MONOLITHIC
#if !IS_PROGRAM
	FPlatformMisc::GetEngineAndProjectAbsoluteDirsFromExecutable(
		ProjectBinariesRootDirectory, EngineBinariesRootDirectory
	);
#endif`;

