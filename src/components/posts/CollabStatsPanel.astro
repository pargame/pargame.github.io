---
const daily = [
  { date: '11/18', count: 18, note: '스킬 설계 10건', highlight: 'skill' },
  { date: '11/19', count: 17, note: '' },
  { date: '11/20', count: 17, note: '' },
  { date: '11/23', count: 26, note: '최다', highlight: 'peak' },
  { date: '11/24', count: 15, note: '' },
  { date: '11/25', count: 15, note: '본 글 제외' },
];

const maxDaily = 26;

const rounds = [
  { label: '1라운드 종료', count: 99, pct: 91.7, tone: 'cyan', detail: '첫 답변 [합의] 8건 · 보완안 수용 91건' },
  { label: '2라운드 종료', count: 8, pct: 7.4, tone: 'violet', detail: '추가 반론 및 근거 재검증' },
  { label: '3라운드 종료', count: 1, pct: 0.9, tone: 'amber', detail: '다회차 쟁점 수렴' },
];
---

<figure class="stats-panel visual-wide" aria-label="일자별 협업 세션 수와 라운드별 종료 분포">
  <div class="stats-grid">
    <section class="panel-box">
      <div class="panel-head">
        <span class="panel-eyebrow">DAILY VOLUME</span>
        <h3>영업일 6일 일자별 종료 세션 (총 108건)</h3>
      </div>

      <div class="daily-bars" role="list" aria-label="일자별 종료 세션 수">
        {daily.map((d) => {
          const heightPct = Math.round((d.count / maxDaily) * 100);
          return (
            <div class="daily-col" role="listitem">
              <span class="daily-val">{d.count}</span>
              <div class="daily-track">
                <div
                  class={`daily-fill ${d.highlight ?? ''}`}
                  style={`height: ${heightPct}%`}
                >
                  {d.highlight === 'skill' && <span class="skill-sub" style="height: 55.6%" title="스킬 설계·점검 10건" />}
                </div>
              </div>
              <span class="daily-date">{d.date}</span>
              <span class="daily-note">{d.note || '\u00A0'}</span>
            </div>
          );
        })}
      </div>

      <p class="panel-foot">
        첫날(11/18) 18건 중 <strong>10건</strong>은 <code>collab</code> 스킬 자체의 설계·점검에 쓰였고, 11/25 수치는 이번 글 작업 세션을 제외한 값입니다.
      </p>
    </section>

    <section class="panel-box">
      <div class="panel-head">
        <span class="panel-eyebrow">CONVERGENCE</span>
        <h3>라운드별 종료 분포 &amp; 개입 빈도</h3>
      </div>

      <div class="round-list" role="list" aria-label="라운드별 종료 분포">
        {rounds.map((r) => (
          <div class="round-item" role="listitem">
            <div class="round-top">
              <span class="round-label">{r.label}</span>
              <span class="round-num"><strong>{r.count}건</strong> ({r.pct}%)</span>
            </div>
            <div class="round-track">
              <div class={`round-fill ${r.tone}`} style={`width: ${Math.max(2, r.pct)}%`} />
            </div>
            <span class="round-detail">{r.detail}</span>
          </div>
        ))}
      </div>

      <div class="mini-metrics">
        <div class="mini-metric">
          <span class="mini-k">발의 비율</span>
          <strong class="mini-v">Gemini 83 : Claude 25</strong>
        </div>
        <div class="mini-metric">
          <span class="mini-k">중간 <code>note</code> 개입</span>
          <strong class="mini-v">4건 / 108건</strong>
        </div>
      </div>
    </section>
  </div>
</figure>

<style>
  .stats-panel {
    margin-block: 2rem;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .panel-box {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.35rem 1.45rem;
    display: flex;
    flex-direction: column;
  }
  .panel-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }
  .panel-head h3 {
    margin: 0 0 1.1rem;
    font-size: 1.02rem;
    color: var(--text-1);
  }

  .daily-bars {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.55rem;
    align-items: end;
    flex: 1;
    padding-top: 0.4rem;
  }
  .daily-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.32rem;
  }
  .daily-val {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }
  .daily-track {
    width: 100%;
    max-width: 44px;
    height: 128px;
    display: flex;
    align-items: flex-end;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: 7px;
    padding: 3px;
  }
  .daily-fill {
    position: relative;
    width: 100%;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 62%, var(--surface-3));
    overflow: hidden;
  }
  .daily-fill.peak {
    background: var(--accent);
  }
  .daily-fill.skill {
    background: color-mix(in srgb, var(--accent) 55%, var(--surface-3));
  }
  .skill-sub {
    position: absolute;
    inset: auto 0 0 0;
    background: var(--accent-2);
  }
  .daily-date {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .daily-note {
    font-size: 0.66rem;
    color: var(--text-3);
    text-align: center;
    line-height: 1.25;
    min-height: 1rem;
  }
  .panel-foot {
    margin: 1rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--text-3);
  }

  .round-list {
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    flex: 1;
  }
  .round-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .round-label {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-1);
  }
  .round-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .round-num strong {
    color: var(--text-1);
  }
  .round-track {
    height: 12px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    overflow: hidden;
  }
  .round-fill {
    height: 100%;
    border-radius: 999px;
  }
  .round-fill.cyan { background: var(--accent); }
  .round-fill.violet { background: var(--accent-2); }
  .round-fill.amber { background: var(--warn); }
  .round-detail {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.76rem;
    color: var(--text-3);
  }

  .mini-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1.15rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border-subtle);
  }
  .mini-metric {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .mini-k {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-3);
  }
  .mini-v {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 820px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
    .panel-box {
      padding: 1.1rem;
    }
  }
  @media (max-width: 440px) {
    .mini-metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
