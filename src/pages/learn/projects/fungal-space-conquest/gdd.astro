---
import '../../../../styles/projects/doc-showcase.css';
import '../../../../styles/projects/nav-breadcrumb.css';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import DocLightbox from '../../../../components/projects/DocLightbox.astro';

// 프로젝트 강조색(에메랄드 · 시안 · 해금 골드). 공용 문서 스타일은 doc-showcase.css에 있다.
const theme = [
  '--theme-dark-wp-coral: #34d399',
  '--theme-dark-wp-peach: #22d3ee',
  '--theme-dark-wp-border: color-mix(in srgb, var(--wp-coral) 26%, var(--border))',
  '--theme-dark-wp-surface: color-mix(in srgb, var(--surface-1) 92%, #34d399 8%)',
  '--theme-dark-wp-surface-soft: color-mix(in srgb, var(--surface-2) 90%, #22d3ee 10%)',
  '--theme-dark-wp-glow: 0 18px 44px -18px rgba(52, 211, 153, 0.34)',
  '--theme-light-wp-coral: #059669',
  '--theme-light-wp-peach: #0891b2',
  '--theme-light-wp-border: rgba(5, 150, 105, 0.22)',
  '--theme-light-wp-surface: #f4fdf9',
  '--theme-light-wp-surface-soft: #effbfd',
  '--theme-light-wp-glow: 0 16px 36px -18px rgba(5, 150, 105, 0.24)',
].join('; ');
---

<BaseLayout
  title="곰팡이 우주 정복 대작전 — 게임 기획서"
  description="UE 5.9 C++ 무중력 균류 역포식 타임어택 「곰팡이 우주 정복 대작전」의 기획 배경, 핵심 루프, 촉수 능력 3종, 성장 시스템, 포식자 AI, 소행성 필드, HUD 구성"
>
  <div class="wp-page" style={theme}>
    <nav class="wp-breadcrumb" aria-label="이동 경로">
      <a href="/learn/projects">Projects</a>
      <span>/</span>
      <a href="/learn/projects/fungal-space-conquest">곰팡이 우주 정복 대작전</a>
      <span>/</span>
      <span class="current">게임 기획서</span>
    </nav>

    <!-- HERO -->
    <header class="wp-hero">
      <div class="wp-hero-top">
        <div class="wp-hero-copy">
          <div class="wp-pills">
            <span class="wp-pill status">
              <span class="wp-dot"></span>
              COMPLETED · UE 5.9
            </span>
            <span class="wp-pill theme-tag">DOC 01 · GAME DESIGN</span>
            <span class="wp-pill wave-tag">APAWN × CHAOS × NIAGARA</span>
          </div>

          <h1>곰팡이 우주 정복 대작전 — 게임 기획서</h1>
          <p class="wp-lead">
            무중력 소행성대를 떠다니는 균류 세포가 촉수로 소행성을 전염시켜 성장하고, 자신을 노리는 <strong>포식자 곰팡이를 역으로 포식</strong>하며 클리어 시간을 겨루는 3D 타임어택 액션 게임의 기획서입니다.
            핵심 루프, 촉수 능력 3종, 성장과 위협 판정, 포식자 AI, 소행성 필드, HUD 구성을 현재 구현 기준으로 정리했으며, 세부 수치와 클래스 이름은 각 섹션의 상세 보기에 수록했습니다.
          </p>

          <div class="wp-hero-actions">
            <a
              href="https://github.com/pargame/FungalSpaceConquest"
              class="wp-btn primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub · FungalSpaceConquest ↗
            </a>
            <a href="#loop" class="wp-btn ghost">핵심 루프 ↓</a>
            <a href="/learn/projects/fungal-space-conquest/devlog" class="wp-btn ghost">DOC 02 · 포트폴리오 →</a>
            <a href="/learn/projects/fungal-space-conquest" class="wp-btn ghost">← 프로젝트 홈</a>
          </div>
        </div>

        <figure class="media-card hero-shot">
          <img
            src="/images/projects/fungal-space-conquest/blog-pie-idle.png"
            alt="별빛이 비치는 소행성대 한가운데에 떠 있는 반투명한 균류 세포 플레이어 본체."
            width="1920"
            height="1080"
            class="zoomable-img"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>
            <strong>PIE Capture · 무중력 소행성대의 균류 세포</strong> — 플레이어는 중력이 없는 공간에서 물리 구체로 비행하며, 주변 소행성을 촉수로 붙잡아 성장의 재료로 삼습니다.
          </figcaption>
        </figure>
      </div>

      <div class="wp-exec-grid" aria-label="핵심 기획 요약">
        <div class="exec-card coral">
          <span class="exec-k">ZERO-G APAWN</span>
          <strong class="exec-v">무중력 360° 비행</strong>
          <span class="exec-d">보행용 캐릭터 대신 물리 구체 폰을 직접 제어하며, 쿼터니언 궤도 카메라로 짐벌락 없이 전방위를 비행합니다.</span>
        </div>
        <div class="exec-card peach">
          <span class="exec-k">TENDRIL ABILITIES</span>
          <strong class="exec-v">촉수 능력 3종</strong>
          <span class="exec-d">전염과 견인을 맡는 긴 촉수, 포식자를 약화시키는 그물 촉수, 위기 탈출용 분사 촉수를 처치 수에 따라 해금합니다.</span>
        </div>
        <div class="exec-card mint">
          <span class="exec-k">PREDATOR REVERSAL</span>
          <strong class="exec-v">생체량 기반 역포식</strong>
          <span class="exec-d">플레이어의 생체량과 포식자의 전염 요구량을 실시간으로 비교해, 충분히 성장하면 포식자를 역으로 포식할 수 있습니다.</span>
        </div>
        <div class="exec-card coral">
          <span class="exec-k">RULE-DRIVEN CLEAR</span>
          <strong class="exec-v">규칙 기반 클리어 · 리더보드</strong>
          <span class="exec-d">클리어 조건과 리더보드 정렬 기준을 에디터 설정으로 정의하며, 기본 조건은 포식자 6마리 처치와 미네랄 200개입니다.</span>
        </div>
      </div>
    </header>

    <!-- 00. BACKGROUND & LOOP -->
    <section class="wp-section" id="loop">
      <div class="wp-section-head">
        <span class="wp-eyebrow">00 // BACKGROUND &amp; CORE LOOP</span>
        <h2>기획 배경과 핵심 루프</h2>
      </div>

      <p class="wp-section-lead">
        언리얼 엔진의 APawn을 직접 제어해야만 살릴 수 있는 소재를 찾는 데서 출발했습니다. 중력과 지면 보행을 전제로 한 ACharacter 대신, 무중력 공간에서 물리 구체가 자유 궤도로 비행하며 촉수로 소행성을 끌어당기는 콘셉트를 선정했고, 여기에 성장과 역포식을 결합한 타임어택 구조를 설계했습니다.
      </p>

      <figure class="arch-figure" aria-labelledby="loopTitle">
        <div class="arch-diagram">
          <div id="loopTitle" class="arch-row-label">CORE LOOP (탐색에서 시작해 성장 · 역포식 · 해금을 거쳐 클리어로 이어지는 흐름)</div>
          <div class="arch-pipeline">
            <div class="arch-node accent-coral">
              <div class="node-tag">01 · EXPLORE</div>
              <div class="node-title">탐색 · 소행성 전염</div>
              <ul class="node-list">
                <li>긴 촉수로 소행성을 락온해 견인</li>
                <li>표면 전염 후 배양 폭발로 미네랄 방출</li>
              </ul>
            </div>

            <div class="arch-conn" aria-hidden="true">
              <span class="conn-fn">미네랄 흡수</span>
              <span class="conn-arrow">→</span>
            </div>

            <div class="arch-node accent-mint">
              <div class="node-tag">02 · GROW</div>
              <div class="node-title">생체량 · 반지름 성장</div>
              <ul class="node-list">
                <li>흡수한 생체량에 따라 본체가 커짐</li>
                <li>카메라와 소행성 크기도 함께 확장</li>
              </ul>
            </div>

            <div class="arch-conn" aria-hidden="true">
              <span class="conn-fn">위협 판정</span>
              <span class="conn-arrow">→</span>
            </div>

            <div class="arch-node accent-peach">
              <div class="node-tag">03 · REVERSE</div>
              <div class="node-title">역포식 전환</div>
              <ul class="node-list">
                <li>충분히 크면 포식자가 사냥 가능 상태로 전환</li>
                <li>긴 촉수로 포식자를 전염시켜 처치</li>
              </ul>
            </div>

            <div class="arch-conn" aria-hidden="true">
              <span class="conn-fn">처치 수 누적</span>
              <span class="conn-arrow">→</span>
            </div>

            <div class="arch-node accent-coral">
              <div class="node-tag">04 · UNLOCK · CLEAR</div>
              <div class="node-title">능력 해금 · 클리어</div>
              <ul class="node-list">
                <li>2마리에 그물 촉수, 3마리에 분사 촉수 해금</li>
                <li>클리어 조건 달성 시 시간 기록 · 리더보드 등록</li>
              </ul>
            </div>
          </div>
        </div>
        <figcaption>
          <strong>핵심 루프</strong> — 플레이어는 소행성을 전염시켜 성장하는 동안 포식자에게 쫓기다가, 위협 판정이 뒤집히는 순간부터 포식자를 사냥합니다. 처치 수가 쌓일수록 새 촉수가 해금되어 클리어 속도가 빨라집니다.
        </figcaption>
      </figure>

      <details class="wp-code-details">
        <summary>상세 보기 — 승리 · 패배 규칙과 기획 원문 대비 변경점</summary>
        <div class="detail-body">
          <h4>승리 · 패배 규칙</h4>
          <ul>
            <li><strong>클리어</strong>: 기본 조건은 포식자 6마리 처치와 미네랄 200개 흡수(모두 충족). 조건 묶음과 비교 연산은 <code>USpaceDrifterGameRulesSettings</code>(<code>UDeveloperSettings</code>)에서 편집</li>
            <li><strong>게임 오버</strong>: 포식자 접촉 흡수 등으로 생체량이 줄어 본체 반지름이 <code>32cm</code>(<code>MinGameOverBodyRadiusCm</code>) 이하가 되면 즉시 종료</li>
            <li><strong>기록</strong>: 클리어 시간 <code>MM:SS.d</code> 확정, <code>USaveGame</code> 리더보드에 최대 20건 저장 후 상위 5건 표시</li>
          </ul>
          <h4>기획 원문 대비 변경점</h4>
          <ul>
            <li>클리어 조건: 포식자 10마리 처치 → 포식자 6마리 처치 · 미네랄 200개(모두 충족)</li>
            <li>분사 촉수(V3) 해금: 5마리 처치 → 3마리 처치</li>
            <li>재사용 대기: 그물 6.0초 → 7.8초, 분사 6.0초 → 1.0초</li>
            <li>그물 둔화: 2.5초 일시 둔화 → 영구 둔화(재적중 시 추가 감소)</li>
            <li>추가 기능: 포식자 원거리 추격 가속, ESC 일시정지 메뉴, 규칙 기반 리더보드 정렬</li>
          </ul>
        </div>
      </details>

      <nav class="wp-toc" aria-label="문서 목차">
        <a href="#abilities"><span>01</span> 조작과 촉수 능력</a>
        <a href="#growth"><span>02</span> 성장과 위협 판정</a>
        <a href="#predators"><span>03</span> 포식자 AI</a>
        <a href="#field"><span>04</span> 소행성 필드</a>
        <a href="#hud"><span>05</span> HUD · UI</a>
      </nav>
    </section>

    <!-- 01. ABILITIES -->
    <section class="wp-section" id="abilities">
      <div class="wp-section-head">
        <span class="wp-eyebrow">01 // CONTROLS &amp; TENDRIL ABILITIES</span>
        <h2>조작과 촉수 능력</h2>
      </div>

      <figure class="media-card case-shot">
        <img
          src="/images/projects/fungal-space-conquest/blog2-02-long-tendril-starlight.png"
          alt="플레이어 본체에서 뻗은 긴 촉수가 가까운 소행성 표면에 달라붙어 있는 장면."
          width="1600"
          height="1149"
          class="zoomable-img"
          loading="lazy"
        />
        <figcaption>
          <strong>PIE Capture · 긴 촉수(V1) 락온</strong> — 긴 촉수는 조준 방향의 소행성 표면에 달라붙어 본체와 대상을 서로 끌어당기며, 붙잡은 상태로 전염을 진행합니다.
        </figcaption>
      </figure>

      <div class="wp-grid-3">
        <article class="wp-card">
          <span class="wp-card-tag">V1 · LONG TENDRIL</span>
          <h3>긴 촉수 (기본)</h3>
          <p>누르고 있는 동안 소행성이나 사냥 가능한 포식자에 락온해 끌어당기고 표면을 전염시킵니다. 전염이 끝나면 대상이 배양 폭발하며 미네랄을 쏟아냅니다.</p>
        </article>
        <article class="wp-card">
          <span class="wp-card-tag">V2 · NET TENDRIL</span>
          <h3>그물 촉수 (2마리 처치)</h3>
          <p>전방 원뿔로 포자 그물을 던져 미네랄을 한꺼번에 끌어오고, 범위 안의 포식자를 영구적으로 둔화시키고 크기를 줄입니다.</p>
        </article>
        <article class="wp-card">
          <span class="wp-card-tag">V3 · SPORE JET</span>
          <h3>분사 촉수 (3마리 처치)</h3>
          <p>생체량 일부를 소모해 전방으로 순간 가속하는 긴급 탈출 수단으로, 포식자에게 붙잡히기 직전의 위기를 벗어날 때 사용합니다.</p>
        </article>
      </div>

      <details class="wp-code-details spaced">
        <summary>상세 보기 — 조작키 · 능력별 수치 · 클래스</summary>
        <div class="detail-body">
          <h4>조작</h4>
          <ul>
            <li><strong>마우스</strong>: 3인칭 쿼터니언 궤도 시점 회전(짐벌락 없는 360° 비행)</li>
            <li><strong>Space</strong>: 선택한 촉수 발동(긴 촉수는 누르는 동안 유지, 그물 · 분사는 단발)</li>
            <li><strong>1 · 2 · 3 또는 Tab</strong>: 해금된 촉수 전환, <strong>ESC</strong>: 일시정지 메뉴(계속 · 그래픽 설정 · 재시작 · 종료)</li>
          </ul>
          <h4>능력별 수치</h4>
          <ul>
            <li><strong>V1</strong> <code>ULongTendrilAbility</code>: 스피어 스윕 락온, 사거리 비례 인력 · 최대 속도 증폭, 가용 생체량 비례 전염 속도와 사전 실패 판정, 전염 직후 재발사 잠금 <code>1.4초</code></li>
            <li><strong>V2</strong> <code>UNetTendrilAbility</code>: 재사용 대기 <code>7.8초</code>, 포식자 이동 속도 <code>×0.35</code> 영구 둔화(재적중 시 <code>×0.85</code>씩 추가 감소, 하한 <code>20%</code>), 적중당 반지름 <code>−15%</code>(하한 <code>50%</code>)</li>
            <li><strong>V3</strong> <code>UJetTendrilAbility</code>: 재사용 대기 <code>1.0초</code>, 가용 생체량 <code>8%</code>(최소 <code>4</code>) 소모, 전방 임펄스 <code>+1400cm/s</code></li>
            <li>공통 베이스 <code>USpaceTendrilAbility</code>: <code>EditInlineNew</code> · <code>DefaultToInstanced</code> 서브오브젝트, 발동 중에만 조건부 Tick</li>
          </ul>
        </div>
      </details>
    </section>

    <!-- 02. GROWTH -->
    <section class="wp-section" id="growth">
      <div class="wp-section-head">
        <span class="wp-eyebrow">02 // GROWTH &amp; THREAT JUDGEMENT</span>
        <h2>성장과 위협 판정</h2>
      </div>

      <figure class="media-card case-shot">
        <img
          src="/images/projects/fungal-space-conquest/blog2-04-net-reeling-in.png"
          alt="플레이어 본체 쪽으로 청록색 미네랄 조각이 당겨져 들어가는 장면."
          width="1600"
          height="1149"
          class="zoomable-img"
          loading="lazy"
        />
        <figcaption>
          <strong>PIE Capture · 미네랄 흡수</strong> — 배양 폭발로 흩어진 미네랄을 흡수하면 생체량이 늘고, 생체량에 따라 본체 반지름과 물리 질량이 함께 커집니다.
        </figcaption>
      </figure>

      <div class="case-grid">
        <article class="case-card intent">
          <span class="case-badge">GROWTH CURVE</span>
          <h3>생체량 기반 성장 체감</h3>
          <p>
            본체 반지름은 생체량의 거듭제곱으로 늘어나고 물리 질량은 반지름의 세제곱을 따릅니다.
            카메라 암 길이와 소켓 오프셋도 본체 크기에 맞춰 확장되어 거대해지는 감각이 유지되며, 긴 촉수의 인력은 사거리에 비례해 증폭되어 질량이 커져도 조작이 둔해지지 않습니다.
          </p>
        </article>

        <article class="case-card intent">
          <span class="case-badge">SINGLE SOURCE OF TRUTH</span>
          <h3>단일 위협 판정 함수</h3>
          <p>
            플레이어의 가용 생체량과 포식자의 전염 요구량을 비교하는 하나의 판정 함수가 피격, 역포식 가능 여부, HUD 마커 표시를 모두 결정합니다.
            그물 촉수로 포식자를 축소시키거나 플레이어가 충분히 성장하면 포식자가 사냥 가능 상태로 바뀌어, 접촉해도 피해를 입지 않고 긴 촉수로 역포식할 수 있습니다.
          </p>
        </article>
      </div>

      <details class="wp-code-details">
        <summary>상세 보기 — 성장 · 카메라 · 판정 수치</summary>
        <div class="detail-body">
          <ul>
            <li>반지름: 시작 <code>75cm</code>, 게임 오버 <code>32cm</code>, 최대 <code>400cm</code>, 성장 지수 <code>BiomassToRadiusExponent = 0.40</code>, 물리 질량은 배율의 세제곱</li>
            <li>카메라: 암 길이 <code>Scale^0.72</code>, 소켓 오프셋 <code>Scale^1.0</code></li>
            <li>판정: <code>IsEnemyThreatToPlayer()</code>가 가용 생체량과 전염 요구량을 비교, 사냥 가능 상태는 시안 림으로 표시</li>
            <li>접촉 흡수: 위협 상태 포식자와 접촉 시 가용 생체량을 초당 <code>28%</code> 흡수당함</li>
          </ul>
        </div>
      </details>
    </section>

    <!-- 03. PREDATORS -->
    <section class="wp-section" id="predators">
      <div class="wp-section-head">
        <span class="wp-eyebrow">03 // PREDATOR AI</span>
        <h2>포식자 AI</h2>
      </div>

      <div class="wp-grid-3">
        <article class="wp-card">
          <span class="wp-card-tag">ATTACK TICKETS</span>
          <h3>공격 티켓</h3>
          <p>여러 포식자가 활성 상태여도 동시에 돌진하는 개체는 최대 2마리로 제한합니다. 나머지는 차례를 기다리며, 교체에는 히스테리시스를 두어 교체 대상이 자주 바뀌지 않도록 했습니다.</p>
        </article>
        <article class="wp-card">
          <span class="wp-card-tag">ENCIRCLEMENT</span>
          <h3>포위 링과 개체 분산</h3>
          <p>티켓이 없는 포식자는 플레이어를 일정 거리의 링에서 선회하며 압박하고, 모든 포식자가 서로 최소 간격을 유지해 한곳에 뭉치지 않습니다.</p>
        </article>
        <article class="wp-card">
          <span class="wp-card-tag">SPAWN SCALING</span>
          <h3>스폰과 난이도 확장</h3>
          <p>포식자는 플레이어가 도달했던 최대 크기를 기준으로 조금 더 크게 등장해, 작아진 상태에서 약한 포식자만 반복 사냥하는 플레이를 막습니다. 시간과 미네랄 획득량에 따라 최대 수가 늘어납니다.</p>
        </article>
      </div>

      <details class="wp-code-details spaced">
        <summary>상세 보기 — 티켓 · 링 · 스폰 · 추격 수치</summary>
        <div class="detail-body">
          <ul>
            <li>공격 티켓: <code>MaxAttackingEnemies = 2</code>, 교체 히스테리시스 <code>350cm</code>, 비위협 유예 <code>0.5초</code>, 그물 둔화 중 티켓 보호</li>
            <li>포위 링: 표면 거리 <code>950~1450cm</code>, 개체 간 최소 표면 간격 <code>550cm</code>(가중치 <code>2.2</code>)</li>
            <li>스폰: 최대 도달 반지름의 <code>1.12~1.28</code>배, 시작 1마리에서 <code>90초</code> 또는 미네랄 <code>50</code>개마다 1마리씩(둘 중 큰 값 적용) 늘어 최대 <code>6</code>마리, 처치 후 <code>10초</code> 재등장, 필드가 비면 <code>2초</code> 만에 재등장</li>
            <li>추격: 최대 <code>480cm/s</code>, 표면 거리 <code>1200cm</code>부터 <code>4800cm</code>까지 추격 속도 최대 <code>×2.6</code> 가속</li>
            <li>시야 보호: 카메라 근접 시 포식자 시각 메시를 일시적으로 숨겨 시야 가림 방지</li>
          </ul>
        </div>
      </details>
    </section>

    <!-- 04. ASTEROID FIELD -->
    <section class="wp-section" id="field">
      <div class="wp-section-head">
        <span class="wp-eyebrow">04 // ASTEROID FIELD</span>
        <h2>소행성 필드</h2>
      </div>

      <figure class="media-card case-shot">
        <img
          src="/images/projects/fungal-space-conquest/blog2-01-star-asteroid-minerals.png"
          alt="원거리 항성 빛 아래 크기가 다양한 소행성들이 흩어져 있고 일부 표면에 청록색 미네랄이 붙어 있는 장면."
          width="1600"
          height="1149"
          class="zoomable-img"
          loading="lazy"
        />
        <figcaption>
          <strong>PIE Capture · 절차적 소행성대</strong> — 단일 시드로 생성한 소행성들이 플레이어 주변을 둘러싸며, 표면에는 전염 후 흡수할 수 있는 미네랄이 배치됩니다.
        </figcaption>
      </figure>

      <div class="wp-grid-3">
        <article class="wp-card">
          <span class="wp-card-tag">PREBAKED POOL</span>
          <h3>사전 생성 풀</h3>
          <p>게임 시작 시 소행성의 절차적 메시와 충돌체를 미리 만들어 두고 재사용해, 플레이 중 새 소행성을 만드는 비용이 들지 않습니다.</p>
        </article>
        <article class="wp-card">
          <span class="wp-card-tag">2-TIER PHYSICS</span>
          <h3>2단계 물리</h3>
          <p>플레이어 근처의 소행성만 Chaos 강체 물리로 시뮬레이션하고, 멀리 있는 소행성은 가벼운 등속 이동으로만 처리해 물리 연산량을 일정하게 유지합니다.</p>
        </article>
        <article class="wp-card">
          <span class="wp-card-tag">SIZE SCALING</span>
          <h3>플레이어 크기 비례 스케일링</h3>
          <p>플레이어가 커질수록 새로 배치되는 소행성도 함께 커져, 크기 · 질량 · 전염 비용 · 미네랄 보상이 성장 단계에 맞게 유지됩니다.</p>
        </article>
      </div>

      <details class="wp-code-details spaced">
        <summary>상세 보기 — 풀 크기 · 물리 전환 · 스케일 수치</summary>
        <div class="detail-body">
          <ul>
            <li>풀: <code>AAsteroidFieldManager</code>가 <code>1,150</code>개를 사전 생성해 재사용(활성 개수는 레벨 설정값), 소행성은 자체 Tick 없음</li>
            <li>물리: 플레이어 근처 최대 <code>48</code>개만 Chaos 강체, 나머지는 <code>StepKinematicDrift</code> 등속 이동, 전환 경계에 히스테리시스 적용</li>
            <li>스케일: 플레이어 반지름 배율의 <code>0.75</code>제곱으로 <code>1.0~3.5</code>배 균일 스케일, 메시 재생성 없이 질량(<code>s³</code>) · 전염 비용 · 미네랄 보상 연동</li>
          </ul>
        </div>
      </details>
    </section>

    <!-- 05. HUD -->
    <section class="wp-section" id="hud">
      <div class="wp-section-head">
        <span class="wp-eyebrow">05 // HUD &amp; UI</span>
        <h2>HUD · UI 구성</h2>
      </div>

      <div class="wp-grid-3">
        <article class="wp-card">
          <span class="wp-card-tag">TITLE</span>
          <h3>타이틀 화면</h3>
          <p>라이브 3D 우주 배경 위에서 플레이어 이름을 입력하고 Space로 출격합니다. 조작 안내, 상위 5건 리더보드와 초기화, 옵션 버튼을 함께 제공합니다.</p>
        </article>
        <article class="wp-card">
          <span class="wp-card-tag">IN-GAME HUD</span>
          <h3>인게임 HUD</h3>
          <p>경과 시간, 목표 진행도, 생체량 게이지, 반지름, 속도, 사거리, 미네랄 수를 좌상단 · 좌하단 · 우상단에 나누어 표시하고, 하단 중앙에 촉수 슬롯과 재사용 대기를 둡니다.</p>
        </article>
        <article class="wp-card">
          <span class="wp-card-tag">RESULT · PAUSE</span>
          <h3>결과 · 일시정지 화면</h3>
          <p>게임이 끝나면 클리어 또는 게임 오버 결과와 리더보드를 보여 주고, 잠시 뒤 Space로 바로 재시작합니다. ESC로 언제든 일시정지 메뉴를 열 수 있습니다.</p>
        </article>
      </div>

      <details class="wp-code-details spaced">
        <summary>상세 보기 — 화면 배치 · 피드백 연출</summary>
        <div class="detail-body">
          <ul>
            <li>구현: 순수 Slate 기반 <code>USpaceDrifterHUDWidget</code>(<code>RebuildWidget</code>)</li>
            <li>좌상단: 경과 시간 <code>MM:SS.d</code>, 목표 진행도, 활성 포식자 수 / 좌하단: 생체량 이중 게이지(잔여 · 전염 투자 중), 현재 · 최대 반지름</li>
            <li>우상단: 비행 속도, 유효 사거리, 누적 미네랄 / 하단 중앙: 촉수 슬롯 3개(잠금 진행도, 해금 글로우, 재사용 대기)</li>
            <li>중앙: 사거리 연동 조준선, 포식자 개별 마커 최대 <code>8</code>개(위협 · 사냥 가능 · 둔화 구분), 피격 시 4면 붉은 비네트</li>
            <li>상단 중앙: 전술 이벤트 알림 배너, 잠긴 촉수를 누르면 경고 배너 표시</li>
            <li>해금 연출: 화면 중앙 대형 팝업 <code>3.2초</code>, 4면 시안 · 골드 플래시, 슬롯 해금 글로우</li>
          </ul>
        </div>
      </details>

