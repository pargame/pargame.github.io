const codeChunkScan = `// Source/UEStudy/Sandbox/MiniProject/AsteroidFieldManager.cpp — RunFieldScan 청크 그룹 로드/언로드 & 우선순위 큐
void AAsteroidFieldManager::RunFieldScan(int32 ChunkLoadBudget, bool bForceFullScan)
{
	// 1. 정지 스캔 스킵: 큐가 비어 있고 청크 경계 내 250cm 미만 이동 시 전체 3D 격자 스캔 생략
	if (!bForceFullScan && bHasEvaluatedChunkScan && PendingChunkQueue.Num() == 0
		&& CenterChunk == LastScannedChunkCoord && ChunkScanMoveThresholdCm > 0.0f
		&& FVector::DistSquared(StreamCenter, LastScannedStreamCenter) < FMath::Square(ChunkScanMoveThresholdCm))
	{
		SyncStatsCounters();
		return;
	}

	// 2. Pass 1: 이탈 반경(DeactivateRadiusCm) 밖 청크들을 통째로 언로드 (락온/근접 유예 제외)
	TArray<FIntVector> ChunksToUnload;
	for (const TPair<FIntVector, FActiveChunkRecord>& Pair : ActiveChunks)
	{
		if (IsChunkOutsideUnloadRange(Pair.Key, StreamCenter, DeactivateRadiusSq)
			&& !ShouldDeferChunkUnload(Pair.Value, PlayerLocation, LatchedTarget, ProtectedNearPlayerSq))
		{
			ChunksToUnload.Add(Pair.Key);
		}
	}
	for (const FIntVector& UnloadCoord : ChunksToUnload)
	{
		UnloadChunk(UnloadCoord, NowTime);
	}

	// 3. Pass 2: 활성 구(ActivateRadiusCm) 내 미로드 청크 수집 및 전방 우선순위 정렬
	const int32 RangeInChunks = FMath::CeilToInt((ActivateRadiusCm + ChunkSizeCm * 0.5f) / ChunkSizeCm);
	TArray<FPendingChunkCandidate> Candidates;
	// ... (반경 내 미로드 청크 수집)
	Candidates.Sort([](const FPendingChunkCandidate& A, const FPendingChunkCandidate& B) {
		return A.PriorityScore < B.PriorityScore;
	});

	// 4. 프레임당 분산 로드 (MaxChunksPerScan = 4)
	for (const FPendingChunkCandidate& Cand : Candidates)
	{
		if (ActiveAsteroidCount >= MaxActiveAsteroids)
		{
			if (!TryEvictRearChunkForCapacity(StreamCenter, ForwardDir, PlayerLocation, LatchedTarget,
				ProtectedNearPlayerSq, Cand.PriorityScore, NowTime, ActiveAsteroidCount))
			{
				break;
			}
		}
		LoadChunk(Cand.ChunkCoord, StreamCenter, PlayerLocation, LatchedTarget, NowTime,
			ActiveLocations, ExternalLocations, ActiveAsteroidCount);
	}
}`;

const codeChunkProtectionAndEviction = `// Source/UEStudy/Sandbox/MiniProject/AsteroidFieldManager.cpp — 언로드 유예 보호망 & 후방 청크 원자적 퇴거
bool AAsteroidFieldManager::ShouldDeferChunkUnload(
	const FActiveChunkRecord& ChunkRecord,
	const FVector& PlayerLocation,
	const AActor* LatchedTarget,
	double ProtectedNearPlayerSq) const
{
	for (int32 PoolIdx : ChunkRecord.AsteroidPoolIndices)
	{
		if (!PoolEntries.IsValidIndex(PoolIdx)) continue;
		const FAsteroidPoolEntry& Entry = PoolEntries[PoolIdx];
		if (Entry.State != EAsteroidPoolState::Active || !IsValid(Entry.Asteroid)) continue;

		// 촉수가 꽂혀 있는 락온 대상 소행성이 포함되어 있다면 언로드 유예
		if (LatchedTarget && Entry.Asteroid.Get() == LatchedTarget) return true;

		// 물리 충돌 반동으로 플레이어 근처(ActivateRadius * 0.8)로 날아온 바위가 눈앞에서 증발하지 않도록 보호
		if (FVector::DistSquared(Entry.Asteroid->GetActorLocation(), PlayerLocation) < ProtectedNearPlayerSq) return true;
	}
	return false;
}

bool AAsteroidFieldManager::TryEvictRearChunkForCapacity(
	const FVector& StreamCenter, const FVector& ForwardDir,
	const FVector& PlayerLocation, const AActor* LatchedTarget,
	double ProtectedNearPlayerSq, double CandidatePriorityScore,
	double NowTime, int32& InOutCurrentActiveCount)
{
	if (!bEnableRearChunkSwap) return false;

	bool bFoundVictimChunk = false;
	FIntVector VictimCoord = FIntVector::ZeroValue;
	double WorstRearScore = CandidatePriorityScore + 150.0;

	for (const TPair<FIntVector, FActiveChunkRecord>& Pair : ActiveChunks)
	{
		if (Pair.Value.AsteroidPoolIndices.Num() == 0) continue;
		if (ShouldDeferChunkUnload(Pair.Value, PlayerLocation, LatchedTarget, ProtectedNearPlayerSq)) continue;

		const double Score = ComputeChunkPriorityScore(Pair.Key, StreamCenter, ForwardDir);
		if (Score > WorstRearScore)
		{
			WorstRearScore = Score;
			VictimCoord = Pair.Key;
			bFoundVictimChunk = true;
		}
	}

	if (!bFoundVictimChunk) return false;

	const int32 FreedCount = ActiveChunks.FindRef(VictimCoord).AsteroidPoolIndices.Num();
	if (UnloadChunk(VictimCoord, NowTime))
	{
		InOutCurrentActiveCount = FMath::Max(0, InOutCurrentActiveCount - FreedCount);
		return true; // 전방 청크 로드를 위한 슬롯 즉시 확보
	}
	return false;
}`;

const codeForwardExpansionSpawn = `// Source/UEStudy/Sandbox/MiniProject/AsteroidFieldManager.h & .cpp — 전방 타원형 확장 및 코사인 가중 편향 스폰
UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|ForwardExpansion")
float ForwardBaseExtensionCm = 1800.0f; // 기본 전방 확장 거리 (18m)

UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|ForwardExpansion")
float ForwardVelocityMaxExtensionCm = 6500.0f; // 고속 이동 시 전방 최대 확장 (65m)

UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|ForwardExpansion")
float VelocityReferenceSpeedCmPerSec = 1600.0f; // 최대 확장에 도달하는 기준 속력 (16m/s)

UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|ForwardExpansion")
float ForwardInnerExtensionFraction = 0.85f; // 내부 금지선 A도 전방으로 밀어낼 비율

UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|ForwardExpansion")
float ForwardSpawnBiasWeight = 0.85f; // 전방 반구 집중 샘플링 가중치 (코사인 가중치 0.58제곱)

void AAsteroidFieldManager::ComputeDirectionalRadii(
	const FVector& OffsetFromPlayer,
	const FVector& ForwardDir,
	float ForwardExtensionCm,
	float& OutMinSpawnRadiusCm,
	float& OutMaxDespawnRadiusCm) const
{
	const float Dist = OffsetFromPlayer.Size();
	const float ForwardAlign = (Dist > KINDA_SMALL_NUMBER)
		? FVector::DotProduct(OffsetFromPlayer / Dist, ForwardDir)
		: 0.0f;

	// 전방 반구(-0.20 ~ +0.85) 구간에 걸쳐 A와 B를 진행 방향으로 확장 (후방은 기본 A/B 고정)
	const float ForwardLobe = FMath::SmoothStep(-0.20f, 0.85f, ForwardAlign);
	const float OuterExt = FMath::Max(ForwardExtensionCm, 0.0f) * ForwardLobe;
	const float InnerExt = OuterExt * FMath::Clamp(ForwardInnerExtensionFraction, 0.0f, 1.0f);

	OutMinSpawnRadiusCm = InnerNoSpawnRadiusCm + InnerExt;
	OutMaxDespawnRadiusCm = FMath::Max(OuterDespawnRadiusCm + OuterExt, OutMinSpawnRadiusCm + 1200.0f);
}

FVector AAsteroidFieldManager::SampleDirectionInShell(
	const FVector& ForwardDir,
	bool bUseForwardBias,
	FRandomStream& Stream) const
{
	if (!bUseForwardBias || ForwardSpawnBiasWeight <= KINDA_SMALL_NUMBER || Stream.GetFraction() > ForwardSpawnBiasWeight)
	{
		FVector UnitDir = Stream.VRand();
		return UnitDir.IsNearlyZero() ? FVector::ForwardVector : UnitDir.GetSafeNormal();
	}

	// 코사인 가중 원뿔(전방 중심 밀집)로 샘플링하여 88.4% 이상을 플레이어 전방 반구에 집중 배치
	const FVector SafeFwd = ForwardDir.IsNearlyZero() ? FVector::ForwardVector : ForwardDir.GetSafeNormal();
	const FVector UpRef = (FMath::Abs(SafeFwd.Z) < 0.92f) ? FVector::UpVector : FVector::RightVector;
	const FVector BasisRight = FVector::CrossProduct(UpRef, SafeFwd).GetSafeNormal();
	const FVector BasisUp = FVector::CrossProduct(SafeFwd, BasisRight).GetSafeNormal();

	const float U = Stream.GetFraction();
	const float CosTheta = FMath::Lerp(-0.08f, 1.0f, FMath::Pow(U, 0.58f));
	const float SinTheta = FMath::Sqrt(FMath::Max(0.0f, 1.0f - CosTheta * CosTheta));
	const float Phi = Stream.FRandRange(0.0f, UE_TWO_PI);

	const FVector Dir = SafeFwd * CosTheta + (BasisRight * FMath::Cos(Phi) + BasisUp * FMath::Sin(Phi)) * SinTheta;
	return Dir.IsNearlyZero() ? SafeFwd : Dir.GetSafeNormal();
}`;

const codeTendrilBranchAndRetract = `// Source/UEStudy/Sandbox/MiniProject/SpaceDrifterPawn.h & .cpp — 근거리 가지 억제 & 형태 고정 체내 수축
UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "SpaceDrifter|LongTendril")
float LongTendrilBranchMinTrunkCm = 420.0f; // 4.2m 이하 근거리 발사 시 곁가지 0개 보장

int32 ASpaceDrifterPawn::ComputeLongTendrilBranchCountForLength(float TargetTrunkLenCm) const
{
	if (LongTendrilBranchFrequency <= KINDA_SMALL_NUMBER || TargetTrunkLenCm <= LongTendrilBranchMinTrunkCm)
	{
		return 0; // 근거리 착탄 시 빗자루 뭉침 방지
	}
	const float FullMaxLen = FMath::Max(LongTendrilMaxLength, LongTendrilBranchMinTrunkCm + 100.0f);
	const int32 FullCount = FMath::Clamp(FMath::RoundToInt((FullMaxLen / 100.0f) * LongTendrilBranchFrequency), 0, 64);
	const float LenRatio = FMath::Clamp(
		(TargetTrunkLenCm - LongTendrilBranchMinTrunkCm) / FMath::Max(FullMaxLen - LongTendrilBranchMinTrunkCm, 100.0f),
		0.0f, 1.0f);
	return FMath::Clamp(FMath::RoundToInt(static_cast<float>(FullCount) * FMath::Pow(LenRatio, 1.35f)), 0, 64);
}

// 회수 및 인양(Reeling In) 시 줄기 길이 단축에 따라 가지가 깜빡이지 않고 체내로 슬라이딩 흡수
if (!bIsExtendingTendril || (bHasLatchedTarget && TendrilExtendAlpha >= TendrilPullActivationAlpha && CurrentLiveLenCm < PeakTrunkLengthCm - 1.0f))
{
	bIsTendrilReelingIn = true; // 형태 고정 플래그 ON
}
const float DeployedRefLenCm = bHasLockedTendrilAim
	? FMath::Max(bIsTendrilReelingIn ? PeakTrunkLengthCm : LockedInitialTargetLenCm, 50.0f)
	: FMath::Max(LongTendrilMaxLength, 50.0f);

// Niagara FX로 전달: 조형 고정 + 몸체 안쪽 진입 오프셋만 전달
TargetFX->SetIntParameter(TEXT("User.SideBranchCount"), DesiredBranchCount);
TargetFX->SetFloatParameter(TEXT("User.DeployedRefLengthCm"), DeployedRefLenCm);
TargetFX->SetFloatParameter(TEXT("User.TrunkRetractOffsetCm"), TrunkRetractOffsetCm);`;
