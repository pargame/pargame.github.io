                </div>
              </div>
              <Code code={codeMsvcFix} lang="cpp" themes={{ light: 'github-light', dark: 'tokyo-night' }} />
            </div>

            <div class="code-block-wrap">
              <div class="code-header">
                <span class="file-name">Source/UEStudy/UEStudy.Build.cs // 퍼블릭 배포본</span>
