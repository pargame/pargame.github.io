---
import '../../../../styles/projects/doc-basic.css';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const endpoints = [
  { method: 'GET', path: '/islands', desc: '현재 활성화된 클라우드섬 목록 조회 (유명 섬 고정 항목 포함)' },
  { method: 'POST', path: '/islands', desc: '새 클라우드섬 코드 업로드 (공유 기간 1/5/30/60분 선택)' },
  { method: 'DELETE', path: '/islands/<id>', desc: '작성자 IP 일치 검증 후 본인 게시물 삭제' },
  { method: 'GET / DELETE', path: '/islands/me', desc: '내 IP로 등록한 게시물 조회 및 일괄 삭제' },
  { method: 'POST', path: '/islands/<id>/reveal', desc: '접속 코드 열람 요청 (30초 쿨타임 적용)' },
  { method: 'GET / POST', path: '/maintenance', desc: '점검 상태 조회 및 관리자 토큰(X-Admin-Token) 기반 점검 모드 전환' },
];

const opsCommands = [
  { cmd: 'pokopia-start', desc: 'Flask 서버 + Cloudflare Tunnel 백그라운드 시작 (launchd)' },
  { cmd: 'pokopia-stop', desc: '서버 및 Cloudflare Tunnel 종료' },
  { cmd: 'pokopia-alert / alert-off', desc: '종료 예고 배너 활성화 및 해제' },
  { cmd: 'pokopia-status', desc: 'launchd 프로세스 및 API 응답 상태 점검' },
  { cmd: './deploy.sh', desc: '정적 파일 ?v=<git-hash> 캐시 버스팅 자동 치환 및 커밋·푸시' },
];
---

<BaseLayout
  title="포코피아 (Pokopia) — 서비스 개요"
  description="pokoclouds.com 클라우드섬 공유 플랫폼의 백엔드 API, 스팸 방지 정책, 다국어 UI 및 배포 자동화 설계"
>
  <div class="doc-page" style="--theme-dark-d-accent: #10b981; --theme-light-d-accent: #059669">
    <nav class="doc-breadcrumb" aria-label="이동 경로">
      <a href="/learn/projects">Projects</a>
      <span>/</span>
      <a href="/learn/projects/pocopia">포코피아 (Pokopia)</a>
      <span>/</span>
      <span class="current">서비스 개요</span>
    </nav>

    <header class="doc-hero">
      <div class="doc-pills">
        <span class="doc-pill status">LIVE · pokoclouds.com</span>
        <span class="doc-pill">Python · Flask</span>
        <span class="doc-pill">Cloudflare Tunnel</span>
      </div>
      <h1>클라우드섬 공유 플랫폼 아키텍처 &amp; 운영 설계</h1>
      <p class="doc-lead">
        별도 회원가입 없이 즉시 클라우드섬 코드를 공유하고 일정 시간 뒤 자동 만료되도록 설계한 경량 웹 서비스입니다.
        단일 <strong>Flask 인메모리 서버</strong>, <strong>바닐라 JS 다국어(ko/en/ja) UI</strong>, 그리고 <strong>Cloudflare Tunnel</strong>을 조합해
        운영 부담과 인프라 비용을 최소화했습니다.
      </p>
    </header>

    <section class="doc-section">
      <span class="eyebrow">01 // REST API</span>
      <h2>백엔드 API 구조 (app.py)</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Method</th>
              <th>Endpoint</th>
              <th>역할</th>
            </tr>
          </thead>
          <tbody>
            {endpoints.map((ep) => (
              <tr>
                <td class="mono">{ep.method}</td>
                <td><code>{ep.path}</code></td>
                <td>{ep.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="doc-section">
      <span class="eyebrow">02 // GUARDRAILS &amp; FRONTEND</span>
      <h2>스팸 방지 정책 및 클라이언트 UX</h2>
      <div class="card-grid">
        <article class="info-card">
          <h3>입력 검증 &amp; 어뷰징 억제</h3>
          <ul>
            <li>IP당 최대 <strong>2개</strong> 동시 게시물 제한 및 작성자 IP 기반 삭제 인증</li>
            <li>코드 열람 시 <strong>30초 쿨타임</strong> 적용으로 무분별한 코드 수집 방지</li>
            <li>코드 형식(Z/I/O 제외 8자리 영문 대문자+숫자) 실시간 필터링</li>
            <li>고정 섬(<code>PINNED_ISLANDS</code>)은 만료·삭제 대상에서 분리 관리</li>
          </ul>
        </article>
        <article class="info-card">
          <h3>반응형 다국어 프론트엔드</h3>
          <ul>
            <li>프레임워크 의존성 없는 정적 HTML/CSS/JS 구성</li>
            <li><strong>5초 폴링</strong> 목록 갱신 + 브라우저 <code>Date.now()</code> 기반 1초 카운트다운</li>
            <li>한국어 · English · 日本語 3개 국어(<code>i18n.js</code>) 즉시 전환</li>
            <li><code>Cache-Control: no-cache</code> 및 Git 해시 쿼리 기반 캐시 버스팅</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="doc-section">
      <span class="eyebrow">03 // OPERATIONS &amp; DEPLOY</span>
      <h2>운영 자동화 도구</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>명령어 / 스크립트</th>
              <th>기능</th>
            </tr>
          </thead>
          <tbody>
            {opsCommands.map((c) => (
              <tr>
                <td><code>{c.cmd}</code></td>
                <td>{c.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <footer class="doc-footer">
      <a href="/learn/projects/pocopia" class="back-btn">← 프로젝트 홈</a>
      <div class="footer-right">
        <a href="https://pokoclouds.com" class="ext-btn" target="_blank" rel="noopener noreferrer">
          pokoclouds.com ↗
        </a>
        <a href="https://github.com/pargame/pocopia" class="back-btn" target="_blank" rel="noopener noreferrer">
          GitHub ↗
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
  gap: 1.2rem;
}
.info-card {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.4rem;
}
.info-card h3 {
  margin: 0 0 0.8rem;
  font-size: 1.1rem;
}
.info-card ul {
  margin: 0;
  padding-left: 1.15rem;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  color: var(--text-2);
  font-size: 0.9rem;
  line-height: 1.6;
}
.info-card strong {
  color: var(--text-1);
}
.footer-right {
  display: flex;
  gap: 0.7rem;
  flex-wrap: wrap;
}
</style>
