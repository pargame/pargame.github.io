import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { Code } from 'astro:components';

const codeCliArgs = `// CLIProvider.swift — 질의응답 전용 CLI 실행 인자
func arguments(for context: ContextPackage) throws -> [String] {
    let schema = Prompt.schema(for: context.kind)
    let message = Prompt.userMessage(for: context)
    let modelArgs = model.isEmpty ? [] : ["--model", model]
    // 질의응답에 필요 없는 도구 · 스킬 · 설정 로드를 꺼서 호출당 토큰과 지연을 줄인다.
    switch kind {
    case .anthropic:
        let lean = ["--tools", "", "--strict-mcp-config", "--setting-sources", "", "--disable-slash-commands", "--no-session-persistence"]
        return ["-p", "--output-format", "json", "--json-schema", schema, "--system-prompt", Prompt.system] + lean + modelArgs + [message]
    case .google:
        // agy는 시스템 프롬프트 옵션이 없어 본문 앞에 붙인다.
        return ["--disable-slash-commands", "--output-format", "json", "--json-schema", schema] + modelArgs + ["-p=\\(Prompt.system)\\n\\n\\(message)"]
    case .openai:
        throw ProviderError.notSupported(kind.cliDisplayName)
    }
}`;

const codeReconcile = `// AIController.swift — 문서 변경 시 쓸모없어진 요청 취소
func reconcile(_ document: WhyNodeDocument) {
    guard let center else { return }
    // 참조선 찾기는 결과를 반영할 때 지금 맵으로 다시 검증하므로 끊지 않는다.
    for request in center.requests(in: ObjectIdentifier(document)) where request.key.kind != .links {
        let status: NodeStatus = request.key.kind == .answer ? .pending : .done
        if !Self.isCurrent(document.map[request.key.node], status: status, question: request.question) {
            center.cancel(request.id)
        }
    }
}`;

const codePhysics = `// Physics.swift — 틱마다 이동량 상한 · 비유한 속도 차단 · 정지 판정
    velocity[i] *= 1 - Self.velocityDecay
    let speed2 = (velocity[i] * velocity[i]).sum()
    if !speed2.isFinite {
        velocity[i] = .zero
    } else if speed2 > Self.maxSpeed * Self.maxSpeed {
        velocity[i] *= Self.maxSpeed / speed2.squareRoot()
    }
    position[i] += velocity[i]
    fastest = max(fastest, (velocity[i] * velocity[i]).sum())
}
// 처음 몇 틱은 속도가 붙기 전이므로 건너뛴다.
if ticks > 20, fastest.squareRoot() < Self.restSpeed { alpha = 0 }`;

const codeAutoFit = `// NodeBubble.swift — 단어가 끊기지 않고 원 안에 들어가는 가장 큰 배율
private var fittedScale: CGFloat {
    let width = NodeBubble.titleWidth * size
    let text = displayText
    let safe = Self.fitScales.filter { Self.longestWordWidth(text, scale: $0) <= width }
    return safe.first { Self.textHeight(text, scale: $0, width: width) <= fitHeight } ?? Self.fitScales.last!
}`;

const codeDedupe = `// Validation.swift — 정규화 후 완전 일치 · 문자 바이그램 Jaccard로 표면 중복 제거
static func dedupe(_ candidates: [String], against existing: [String], threshold: Double) -> ([String], [String]) {
    var references = existing.map(normalize)
    var kept: [String] = []
    var removed: [String] = []
    for candidate in candidates {
        let text = candidate.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !text.isEmpty else { continue }
        let normalized = normalize(text)
        let duplicate = normalized.isEmpty || references.contains { other in
            other == normalized || jaccard(bigrams(other), bigrams(normalized)) >= threshold
        }
        if duplicate {
            removed.append(text)
        } else {
            kept.append(text)
            references.append(normalized)
        }
    }
    return (kept, removed)
}`;

