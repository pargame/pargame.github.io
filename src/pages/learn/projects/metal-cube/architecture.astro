---
import '../../../../styles/projects/doc-basic.css';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const referenceFrames = [
  { order: '1', name: 'Local Space (개체 고유 공간)', origin: '개별 개체의 중심점', purpose: '개체 고유의 기하학적 형태를 외부 환경과 무관하게 독립 정의' },
  { order: '2', name: 'World Space (세계 공간)', origin: '가상 세계의 절대 원점', purpose: '독립된 개체들을 단일 공유 공간에 배치하여 상호 위치 관계 확립' },
  { order: '3', name: 'View Space (관찰자 공간)', origin: '관찰자(카메라)의 위치', purpose: '세계의 모든 요소를 관찰자의 시선과 위치를 기준으로 재정렬' },
  { order: '4', name: 'NDC (정규화 투영 공간)', origin: '시야 절두체의 중심', purpose: '3차원 공간을 기하학적으로 압축하여 시야 범위 내 좌표를 정규화' },
  { order: '5', name: 'Screen Space (화면 공간)', origin: '디스플레이 기준 모서리', purpose: '연속된 정규화 좌표를 실제 출력 장치의 이산적 화소 격자 인덱스에 대응' },
];

const modules = [
  { file: 'include/Math3D.hpp', stages: '공통 수학 기반', desc: '기준 좌표계 전이(Change of Basis)를 위한 4×4 동차 좌표 행렬 연산 및 C++23 다중 첨자 연산자(operator[col, row])' },
  { file: 'include/World.hpp', stages: '1–2단계', desc: '공간·개체의 존재론적 정의 및 프레임 독립적 시간 전이(WorldState)' },
  { file: 'include/Observer.hpp', stages: '3–4단계', desc: '관찰자(카메라) 시점 변환 및 3D → 2D 원근 투영(Observer)' },
  { file: 'include/Shaders.hpp', stages: '4 & 7단계', desc: '정점 셰이더 내 단계별 좌표계 전이(Local → World → View → Clip) 및 프래그먼트 셰이더 광학적 상호작용 해석' },
  { file: 'include/Renderer.hpp', stages: '4–9단계', desc: '후면 컬링, 이산화, Z-버퍼 폐색 해결, sRGB 인지 매핑, 3중 버퍼링(Triple Buffering + std::counting_semaphore) 및 표출(CubeRenderer)' },
  { file: 'metal_rotating_cube.cpp', stages: '런타임 조율', desc: '네이티브 윈도우 초기화 및 프레임 루프 조율(ViewDelegate)' },
];

const stages = [
  { num: '01', title: '공간·개체 정의', summary: '가상 공간 기저와 개체의 기하 형상(Geometry)·물성(Material)·광원(Light)을 Local Space 데이터로 실체화' },
  { num: '02', title: '시간 전이·세계 배치', summary: '시간 흐름(Δt)과 입력에 따른 상태 전이 S(t+Δt)를 계산하고 개체를 World Space에 배치' },
  { num: '03', title: '관찰자 정립·시점 변환', summary: '카메라 위치·응시 방향·시야각을 기준으로 세계 좌표를 관찰자 상대 좌표(View Space)로 변환' },
  { num: '04', title: '가시 영역 선별·차원 축소', summary: '절두체 밖 영역을 배제(Culling)하고 3D 기하를 깊이(Depth)를 보존한 2D 투영 평면으로 압축' },
  { num: '05', title: '공간 이산화·표본화', summary: '연속 2D 투영 평면을 디스플레이 화소 격자(Pixel Grid) 위치에서 표본화하여 디지털화' },
  { num: '06', title: '폐색 해결·가시 표면 확정', summary: '동일 화소에 겹친 표면 중 깊이(Z-buffer)가 가장 앞선 가시 표면만 확정하고 피폐색면 기각' },
  { num: '07', title: '광학적 상호작용 해석', summary: '입사 광원 에너지와 표면 법선·물성 간 상호작용을 계산해 시선 방향 복사휘도(Radiance) 산출' },
  { num: '08', title: '인지적 매핑·양자화', summary: '선형 빛 에너지를 디스플레이 동적 범위와 sRGB 색 공간에 매핑 후 유한 비트 정수로 양자화' },
  { num: '09', title: '시간 격리 동기화·물리 표출', summary: 'Triple Buffering과 세마포어로 CPU/GPU 프레임을 격리하고 주사율에 맞춰 화면에 원자적 표출' },
];
---

<BaseLayout
  title="Metal Cube — 아키텍처"
  description="순수 C++26과 metal-cpp로 구현한 9단계 의미론적 3D 렌더링 파이프라인 아키텍처"
>
  <div class="doc-page" style="--d-status: var(--success); --d-on-accent: #0b1120; --theme-dark-d-accent: #38bdf8; --theme-light-d-accent: #0284c7">
    <nav class="doc-breadcrumb" aria-label="이동 경로">
      <a href="/learn/projects">Projects</a>
      <span>/</span>
      <a href="/learn/projects/metal-cube">Metal Cube</a>
      <span>/</span>
      <span class="current">아키텍처</span>
    </nav>

    <header class="doc-hero">
      <div class="doc-pills">
        <span class="doc-pill status">COMPLETED · C++26</span>
        <span class="doc-pill">metal-cpp · MSL</span>
        <span class="doc-pill">Apple Silicon</span>
      </div>
      <h1>9단계 의미론적 3D 렌더링 파이프라인 &amp; C++26 설계</h1>
      <p class="doc-lead">
        특정 엔진이나 API에 종속되지 않고, <strong>3차원 연속 공간의 수학적 상태 집합(R³ × t)</strong>을
        <strong>2차원 이산 평면의 물리적 광신호(N² × RGB)</strong>로 실시간 번역하는 9단계 인과 모델을 정의하고,
        이를 Apple Silicon용 순수 <code>metal-cpp</code> 모듈과 1:1로 매핑해 구현했습니다.
      </p>
    </header>

    <section class="doc-section">
      <span class="eyebrow">01 // SEMANTIC 9-STAGE PIPELINE</span>
      <h2>9단계 렌더링 인과 모델</h2>
      <div class="stage-grid">
        {stages.map((s) => (
          <article class="stage-card">
            <span class="stage-num">STAGE {s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="doc-section">
      <span class="eyebrow">02 // CHANGE OF BASIS</span>
      <h2>기준 좌표계의 상대성 사슬</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>순서</th>
              <th>좌표계 명칭</th>
              <th>기준점 (Origin)</th>
              <th>의미론적 목적</th>
            </tr>
          </thead>
          <tbody>
            {referenceFrames.map((f) => (
              <tr>
                <td class="mono">{f.order}</td>
                <td><strong>{f.name}</strong></td>
                <td>{f.origin}</td>
                <td>{f.purpose}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="doc-section">
      <span class="eyebrow">03 // 1:1 MODULE ARCHITECTURE</span>
      <h2>설계 문서와 1:1 대응하는 C++26 모듈 구조</h2>
      <div class="module-list">
        {modules.map((m) => (
          <article class="module-item">
            <div class="module-head">
              <code>{m.file}</code>
              <span class="module-stage">{m.stages}</span>
            </div>
            <p>{m.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="doc-section">
      <span class="eyebrow">04 // MODERN C++26 &amp; MEMORY SAFETY</span>
      <h2>구현 핵심 포인트</h2>
      <ul class="key-points">
        <li><strong>Zero Objective-C Bridge:</strong> Apple 공식 <code>metal-cpp</code>와 <code>metal-cpp-extensions</code>만 사용해 순수 C++ 번역 단위로 네이티브 Metal 파이프라인을 구동합니다.</li>
        <li><strong>완전한 RAII 수명 관리:</strong> <code>NS::SharedPtr</code>와 <code>std::unique_ptr</code>로 Metal 디바이스·파이프라인·버퍼 자원을 관리해 수동 <code>release</code>/<code>delete</code> 호출을 제거했습니다.</li>
        <li><strong>C++20/23/26 표준 기능 적용:</strong> 다중 첨자 <code>operator[col, row]</code>, <code>std::counting_semaphore</code> 기반 3중 버퍼링, <code>constexpr std::array</code>, <code>&lt;numbers&gt;</code>, <code>&lt;print&gt;</code>, C++26 <code>= delete("reason")</code> 및 플레이스홀더 <code>_</code>를 실전 코드에 반영했습니다.</li>
      </ul>
    </section>

    <footer class="doc-footer">
      <a href="/learn/projects/metal-cube" class="back-btn">← 프로젝트 홈</a>
      <a href="https://github.com/pargame/metal-cube" class="ext-btn" target="_blank" rel="noopener noreferrer">
        GitHub에서 코드 보기 ↗
      </a>
    </footer>
  </div>
</BaseLayout>

<style>
.stage-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
}
.stage-card {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}
.stage-num {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--d-accent);
}
.stage-card h3 {
  margin: 0;
  font-size: 1.02rem;
}
.stage-card p {
  margin: 0;
  font-size: 0.88rem;
  color: var(--text-2);
  line-height: 1.6;
}
.module-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1rem;
}
.module-item {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.2rem;
}
.module-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.55rem;
}
.module-head code {
  font-size: 0.86rem;
  color: var(--d-accent);
  font-weight: 700;
}
.module-stage {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-3);
  background: var(--surface-2);
  padding: 0.16rem 0.5rem;
  border-radius: 999px;
}
.module-item p {
  margin: 0;
  font-size: 0.88rem;
  color: var(--text-2);
  line-height: 1.6;
}
.key-points {
  margin: 0;
  padding-left: 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  color: var(--text-2);
  line-height: 1.7;
}
.key-points strong {
  color: var(--text-1);
}
</style>
