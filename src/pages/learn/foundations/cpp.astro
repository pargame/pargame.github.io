    <!-- 7.1절: C 스타일 원시 배열의 물리적 메모리 연속성과 sizeof -->
    <section class="lesson-section" id="sec-7-1">
      <h3>7.1 C 스타일 원시 배열의 물리적 메모리 연속성과 sizeof</h3>

      <p>
        C++ 공식 표준 규약(ISO C++ 배열 선언 규약 [dcl.array])에서 <strong>배열(Array)</strong>은 동일한 타입 <code>T</code>의 객체들이
        물리적 메모리 공간상에 <strong>연속적(Contiguously)</strong>으로 빈틈없이 배치된 고정 크기 시퀀스로 정의됩니다.
        컴파일러는 배열 선언 시 지정된 원소 개수 <code>N</code>과 원소 타입의 크기 <code>sizeof(T)</code>를 곱한 만큼의 단일 메모리 블록을 스택 또는 데이터 영역에 확보합니다.
      </p>

      <div class="memory-layout-box">
        <div style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: var(--accent);">
          [스택 메모리 배치: int arr[4] = &#123;10, 20, 30, 40&#125;; (총 16 바이트 연속 블록)]
        </div>
        <div class="memory-row">
          <div class="mem-cell data" style="flex: 1;">
            <small style="opacity: 0.7;">0x1000</small>
            <code>arr[0] = 10</code>
            <small>4B</small>
          </div>
          <div class="mem-cell data" style="flex: 1;">
            <small style="opacity: 0.7;">0x1004</small>
            <code>arr[1] = 20</code>
            <small>4B</small>
          </div>
          <div class="mem-cell data" style="flex: 1;">
            <small style="opacity: 0.7;">0x1008</small>
            <code>arr[2] = 30</code>
            <small>4B</small>
          </div>
          <div class="mem-cell data" style="flex: 1;">
            <small style="opacity: 0.7;">0x100C</small>
            <code>arr[3] = 40</code>
            <small>4B</small>
          </div>
        </div>
        <div class="callout callout-info" style="margin-top: 0.8rem; margin-bottom: 0;">
          <ul style="margin: 0; padding-left: 1.2rem; font-size: 0.88rem; line-height: 1.6;">
            <li><code>arr</code> (시작 주소): <code>0x1000</code> (&amp;arr[0]과 동일)</li>
            <li><code>arr + 1</code> (포인터 연산): <code>0x1004</code> (<code>sizeof(int) = 4바이트</code> 전진)</li>
            <li><code>sizeof(arr)</code> (배열 전체 크기): <code>4 * 4 = 16바이트</code></li>
          </ul>
        </div>
      </div>

      <h4>원시 배열의 4대 초기화 문법 규약</h4>
      <p>
        원시 배열은 선언 시점의 초기화 리스트 작성 방식에 따라 원소의 기본 초기화 여부가 엄격히 결정됩니다.
      </p>

      <div class="spec-table-wrap">
        <table class="spec-table">
          <colgroup>
            <col style="width: 26%" />
            <col style="width: 32%" />
            <col style="width: 42%" />
          </colgroup>
          <thead>
            <tr>
              <th>초기화 문법</th>
              <th>코드 예시</th>
              <th>표준 동작 및 메모리 상태</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>기본 미초기화</strong></td>
              <td><code>int a[5];</code></td>
              <td>스택 프레임의 기존 비트 패턴이 그대로 남아 <strong>쓰레기값(Indeterminate Value)</strong>을 보유합니다. 읽기 시 UB가 발생합니다.</td>
            </tr>
            <tr>
              <td><strong>완전 리스트 초기화</strong></td>
              <td><code>int b[3] = &#123;1, 2, 3&#125;;</code></td>
              <td>지정된 원소 수만큼 정확히 메모리에 순차 기록됩니다. 크기 생략(<code>int b[] = &#123;1, 2, 3&#125;;</code>) 시 컴파일러가 3으로 자동 추론합니다.</td>
            </tr>
            <tr>
              <td><strong>부분 초기화 (0 채움)</strong></td>
              <td><code>int c[5] = &#123;1, 2&#125;;</code></td>
              <td>명시되지 않은 나머지 원소(<code>c[2]</code>, <code>c[3]</code>, <code>c[4]</code>)는 타입의 기본값인 <strong>0(값 초기화)</strong>으로 자동 채워집니다.</td>
            </tr>
            <tr>
              <td><strong>전체 0 초기화</strong></td>
              <td><code>int d[5] = &#123;&#125;;</code> (또는 <code>= &#123;0&#125;;</code>)</td>
              <td>배열의 모든 원소가 0으로 안전하게 초기화됩니다. 안전한 C++ 코드의 필수 권장 사항입니다.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h4>첨자 연산자([])와 sizeof 원소 개수 계산 규약</h4>
      <p>
        C++에서 배열 인덱싱 연산자 <code>arr[i]</code>는 표준에 의해 <code>*(arr + i)</code>로 완벽히 치환됩니다.
        덧셈의 교환법칙에 의해 <code>i[arr]</code> 역시 문법적으로 <code>*(i + arr)</code>이 되어 유효하지만, 가독성을 해치므로 실무에서는 절대 사용하지 않습니다.
        또한 배열 전체 바이트 크기 <code>sizeof(arr)</code>를 개별 원소 크기 <code>sizeof(arr[0])</code>로 나누면 컴파일 타임에 원소 개수를 계산할 수 있습니다:
      </p>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">array_sizeof_count.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;
#include &lt;cstddef&gt;

int main() &#123;
    int scores[5] = &#123;90, 85, 78, 92, 88&#125;;

    // 배열의 총 바이트 수 (5 * 4 = 20 바이트)
    std::size_t total_bytes = sizeof(scores);
    // 단일 원소 바이트 수 (4 바이트)
    std::size_t elem_bytes = sizeof(scores[0]);
    // 컴파일 시점 원소 개수 산출 (20 / 4 = 5)
    std::size_t count = total_bytes / elem_bytes;

    std::println("총 메모리 크기: &#123;&#125; 바이트 (원소당 &#123;&#125; 바이트)", total_bytes, elem_bytes);
    std::println("배열 원소 개수: &#123;&#125; 개", count);
    return 0;
&#125;</code></pre>
      </div>
    </section>

    <!-- 7.2절: 포인터 퇴화(Decay) 메커니즘과 경계 정보 유실의 보안 취약점 -->
    <section class="lesson-section" id="sec-7-2">
      <h3>7.2 포인터 퇴화(Array-to-pointer Decay) 메커니즘과 경계 정보 유실</h3>

      <p>
        C/C++ 초심자가 겪는 가장 당혹스러운 언어적 함정 중 하나가 <strong>포인터 퇴화(Array-to-pointer Decay)</strong>입니다.
        배열은 <code>sizeof</code> 연산자나 단항 주소 연산자 <code>&amp;</code>의 피연산자로 사용되는 경우를 제외하고,
        표현식에서 평가되는 즉시 <strong>첫 번째 원소를 가리키는 포인터(<code>&amp;arr[0]</code>)로 암시적 형변환</strong>됩니다.
      </p>

      <div class="memory-layout-box">
        <div style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: var(--accent);">
          [스택 프레임 전이: main() ➔ print_array(numbers) 호출 시 포인터 퇴화(Decay)]
        </div>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: stretch; margin-top: 0.4rem;">
          <!-- 좌측: 호출자(main) 원본 배열 프레임 -->
          <div style="flex: 1; min-width: 260px; background: var(--surface-2); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 0.8rem;">
            <div style="font-size: 0.78rem; font-weight: 700; color: var(--text-1); margin-bottom: 0.5rem;">
              caller: <code>main()</code> 스택 프레임
            </div>
            <div style="font-size: 0.75rem; color: var(--text-2); margin-bottom: 0.4rem;">
              <code>int numbers[5] = &#123;1, 2, 3, 4, 5&#125;;</code> (20 바이트 전체 블록)
            </div>
            <div class="memory-row">
              <div class="mem-cell data" style="flex: 1;"><code>[1]</code></div>
              <div class="mem-cell data" style="flex: 1;"><code>[2]</code></div>
              <div class="mem-cell data" style="flex: 1;"><code>[3]</code></div>
              <div class="mem-cell data" style="flex: 1;"><code>[4]</code></div>
              <div class="mem-cell data" style="flex: 1;"><code>[5]</code></div>
            </div>
            <div style="font-size: 0.75rem; color: #10b981; margin-top: 0.5rem; font-weight: 600;">
              ✓ 컴파일러가 원소 5개 인식 (sizeof == 20)
            </div>
          </div>

          <!-- 우측: 피호출자(print_array) 포인터 프레임 -->
          <div style="flex: 1; min-width: 260px; background: var(--surface-2); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 0.8rem;">
            <div style="font-size: 0.78rem; font-weight: 700; color: var(--text-1); margin-bottom: 0.5rem;">
              callee: <code>print_array(int* arr)</code> 스택 프레임
            </div>
            <div style="font-size: 0.75rem; color: var(--text-2); margin-bottom: 0.4rem;">
              <code>int* arr</code> (시작 주소만 복사된 단일 포인터 변수)
            </div>
            <div class="memory-row">
              <div class="mem-cell padding" style="flex: 1; font-style: normal; color: var(--accent);">
                <code>0x7ffee1234</code> (&amp;numbers[0])
              </div>
            </div>
            <div style="font-size: 0.75rem; color: #ef4444; margin-top: 0.5rem; font-weight: 600;">
              ⚠ 원소 개수 정보(5) 영구 유실 (sizeof == 8)
            </div>
          </div>
        </div>
      </div>

      <div class="callout callout-warn">
        <div class="callout-title">함수 매개변수 선언문 int arr[10]의 허상</div>
        <p>
          C++ 함수 선언에서 <code>void foo(int arr[10])</code> 또는 <code>void foo(int arr[])</code>로 작성하더라도,
          표준 번역 규칙에 의해 컴파일러는 이를 완전히 <code>void foo(int* arr)</code>로 재작성(Rewrite)합니다.
          대괄호 안의 숫자 10은 컴파일러에 의해 완전히 무시되며, 함수 내부에서 <code>sizeof(arr)</code>를 수행하면 배열 크기가 아니라 <strong>64비트 아키텍처 기준 포인터 크기인 8바이트</strong>가 반환됩니다.
        </p>
      </div>

      <h4>경계 정보 유실로 인한 버퍼 오버플로우 보안 취약점</h4>
      <p>
        포인터로 퇴화된 배열은 자신이 보유한 원소의 한계(Upper Bound)를 전혀 알지 못합니다.
        따라서 포인터 산술을 통해 할당된 5개의 범위를 초과하여 <code>arr[10]</code>이나 <code>*(arr + 10)</code>에 접근하더라도
        컴파일 타임에 아무런 경고나 차단이 일어나지 않으며, 인접한 스택 변수를 덮어쓰거나 세그멘테이션 오류(Segmentation Fault)를 일으키는 <strong>심각한 보안 취약점(CWE-119: Memory Buffer Bounds Exceeded)</strong>을 유발합니다.
      </p>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">decay_trap.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;

// 컴파일러는 아래 매개변수를 const int* arr로 번역함!
void print_decay_size(const int arr[100]) &#123;
    // 주의! sizeof(arr)는 400 바이트가 아니라 8 바이트(포인터 크기)를 반환! (-Wsizeof-array-argument)
    std::println("함수 내부 포인터 시작 주소: &#123;&#125; (원소 개수 정보 유실)", static_cast&lt;const void*&gt;(arr));
&#125;

int main() &#123;
    int real_array[100] = &#123;0&#125;;
    std::println("main 스코프 sizeof(real_array): &#123;&#125; 바이트", sizeof(real_array));

    print_decay_size(real_array);
    return 0;
&#125;</code></pre>
      </div>
    </section>

    <!-- 7.3절: 다차원 배열의 메모리 연속성(행 우선, Row-major)과 2차원 인덱싱 -->
    <section class="lesson-section" id="sec-7-3">
      <h3>7.3 다차원 배열의 메모리 연속성(행 우선, Row-major)과 캐시 지역성</h3>

      <p>
        C++에는 진정한 의미의 "2차원 격자 메모리"가 존재하지 않습니다.
        <code>int grid[2][3]</code>과 같은 다차원 배열은 사실 <strong>"3개짜리 int 배열을 원소로 갖는 2개짜리 배열"</strong>로 정의됩니다.
        따라서 물리 메모리에는 모든 행(Row)이 끊김 없이 일렬로 직렬화되는 <strong>행 우선 순서(Row-major Order)</strong>로 배치됩니다.
      </p>

      <div class="diagram-box">
        <div class="diagram-title">행 우선(Row-major) 직렬화 메모리 레이아웃 및 2차원 주소 계산 공식</div>
        <pre class="ascii-diagram">
선언: int grid[2][3] = &#123; &#123;10, 20, 30&#125;, &#123;40, 50, 60&#125; &#125;;

논리적 형태: (2행 3열)
  Row 0: [ 10, 20, 30 ]
  Row 1: [ 40, 50, 60 ]

물리적 연속 메모리 배치:
+-------------------------------------------------------------------------------+
| grid[0][0] | grid[0][1] | grid[0][2] | grid[1][0] | grid[1][1] | grid[1][2] |
|   (10)     |   (20)     |   (30)     |   (40)     |   (50)     |   (60)     |
+-------------------------------------------------------------------------------+
| &lt;---------- Row 0 (12 바이트) ----------&gt; | &lt;---------- Row 1 (12 바이트) ----------&gt; |
0x2000       0x2004       0x2008       0x200C       0x2010       0x2014

* 2차원 주소 오프셋 공식:
  &amp;grid[r][c] == BaseAddress + (r * COLS + c) * sizeof(int)</pre>
      </div>

      <h4>하드웨어 캐시 라인(Spatial Locality)과 순회 방향의 성능 차이</h4>
      <p>
        현대 CPU는 메모리를 읽을 때 4바이트 단일 데이터가 아니라 <strong>64바이트 캐시 라인(Cache Line)</strong> 단위로 L1/L2 고속 캐시에 적재합니다.
        따라서 행 우선 순서에 맞춰 가로(Row-wise)로 순회하면 인접 데이터가 캐시에 이미 로드되어 있어 <strong>캐시 히트(Cache Hit)</strong>가 극대화됩니다.
        반면 열(Column-wise) 방향으로 건너뛰며 순회하면 캐시 라인을 벗어나는 <strong>캐시 미스(Cache Miss)</strong>가 폭증하여 수 배에서 수십 배의 성능 저하가 발생합니다:
      </p>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">matrix_cache_locality.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;

constexpr int ROWS = 2;
constexpr int COLS = 3;

int main() &#123;
    int matrix[ROWS][COLS] = &#123;
        &#123;10, 20, 30&#125;,
        &#123;40, 50, 60&#125;
    &#125;;

    // 올바른 순회: 공간 지역성(Spatial Locality)을 활용한 행 우선 순회
    std::println("--- 행 우선 순회 (캐시 최적화) ---");
    for (int r = 0; r &lt; ROWS; ++r) &#123;
        for (int c = 0; c &lt; COLS; ++c) &#123;
            std::print("&#123;&#125; ", matrix[r][c]);
        &#125;
        std::println("");
    &#125;

    // 2차원 배열의 퇴화 타입: int**가 아니라 int(*)[COLS] (배열 포인터)임!
    int (*row_ptr)[COLS] = matrix;
    std::println("포인터 산술을 통한 grid[1][2]: &#123;&#125;", *(*(row_ptr + 1) + 2));
    return 0;
&#125;</code></pre>
      </div>
    </section>

    <!-- 7.4절: C++20 표준 뷰 std::span -->
    <section class="lesson-section" id="sec-7-4">
      <h3>7.4 C++20 표준 뷰 std::span: 안전한 경계 제어와 서브스팬 슬라이싱</h3>

      <p>
        C++20에서 표준에 도입된 <code>std::span&lt;T&gt;</code>(헤더 <code>&lt;span&gt;</code>)는
        포인터 퇴화의 위험성과 C 스타일 원시 포인터 매개변수를 완전히 대체하는 <strong>비소유 연속 메모리 뷰(Non-owning View)</strong>입니다.
        내부적으로 <code>data()</code> 포인터와 <code>size()</code> 길이 정보라는 단 2개의 필드만 보유하므로
        64비트 환경에서 오직 <strong>16바이트의 가벼운 크기</strong>를 가지며, 값으로 복사(Pass-by-value)해도 오버헤드가 사실상 전무합니다.
      </p>

      <div class="diagram-box">
        <div class="diagram-title">std::span의 내부 구조와 다형적 연속 메모리 참조 모델</div>
        <pre class="ascii-diagram">
std::span&lt;int&gt; sp (총 16바이트 경량 래퍼)
+-----------------------+-----------------------+
|  ptr_ (8 바이트)      |  size_ (8 바이트)     |
|  = &amp;buffer[1]         |  = 3                  |
+-----------------------+-----------------------+
           |
           v
+----------+------------------------------------+
| buffer:  | [0] | [1] | [2] | [3] | [4] |      | (원시 배열, std::vector, std::array 무관)
+----------+------------------------------------+
                   &lt;--- sp의 관측 범위 ---&gt;</pre>
      </div>

      <h4>정적 익스텐트 vs 동적 익스텐트</h4>
      <p>
        <code>std::span</code>은 컴파일 타임에 길이가 고정되는 정적 익스텐트와 런타임에 길이가 결정되는 동적 익스텐트를 모두 지원합니다:
      </p>
      <ul>
        <li><strong>동적 익스텐트 (기본형: <code>std::span&lt;T&gt;</code>)</strong>: <code>size()</code>가 런타임 멤버로 관리되어 어떤 크기의 버퍼라도 유연하게 받을 수 있습니다.</li>
        <li><strong>정적 익스텐트 (고정형: <code>std::span&lt;T, N&gt;</code>)</strong>: 컴파일 타임에 크기 N이 타입에 박제되어 <code>sizeof(span)</code>이 단 8바이트(포인터 1개)로 극대화 최적화됩니다.</li>
      </ul>

      <h4>서브스팬(subspan)을 통한 무복사 슬라이싱 실무 패턴</h4>
      <p>
        기존 C 스타일에서는 버퍼의 일부분을 다룰 때 <code>(ptr + offset, length)</code>를 쌍으로 넘겨야 했지만,
        <code>std::span</code>은 <code>subspan(offset, count)</code> 메서드를 통해 추가적인 메모리 할당 없이 즉시 새로운 뷰를 생성합니다:
      </p>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">span_modern_usage.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;
#include &lt;span&gt;
#include &lt;vector&gt;
#include &lt;array&gt;

// C 스타일 배열, std::vector, std::array 모두를 동일한 시그니처로 수용
void print_buffer(std::span&lt;const int&gt; view) &#123;
    std::print("[크기 &#123;&#125;]: ", view.size());
    for (int elem : view) &#123;
        std::print("&#123;&#125; ", elem);
    &#125;
    std::println("");
&#125;

int main() &#123;
    int raw_arr[5] = &#123;10, 20, 30, 40, 50&#125;;
    std::vector&lt;int&gt; vec = &#123;100, 200, 300&#125;;
    std::array&lt;int, 4&gt; std_arr = &#123;1, 2, 3, 4&#125;;

    // 서로 다른 컨테이너가 복사 없이 std::span으로 일원화
    print_buffer(raw_arr);
    print_buffer(vec);
    print_buffer(std_arr);

    // subspan을 활용한 무복사 슬라이싱 (인덱스 1부터 3개 추출)
    std::span&lt;const int&gt; full_view&#123;raw_arr&#125;;
    std::span&lt;const int&gt; sliced_view = full_view.subspan(1, 3); // 20, 30, 40
    std::print("슬라이스 결과: ");
    print_buffer(sliced_view);

    return 0;
&#125;</code></pre>
      </div>
    </section>

    <!-- 7.5절: 문자열 메모리 모델 삼각 비교 -->
    <section class="lesson-section" id="sec-7-5">
      <h3>7.5 문자열 메모리 모델: C 문자열, std::string, std::string_view 삼각 비교</h3>

      <p>
        C++에는 텍스트 데이터를 다루는 3가지 서로 다른 메커니즘이 공존합니다:
        과거 C와의 호환을 위한 <strong>C 스타일 문자열(<code>const char*</code>)</strong>,
        소유권을 갖고 힙 메모리를 관리하는 <strong><code>std::string</code></strong>,
        그리고 C++17에서 도입된 경량 읽기 전용 뷰인 <strong><code>std::string_view</code></strong>입니다.
      </p>

      <div class="spec-table-wrap">
        <table class="spec-table">
          <colgroup>
            <col style="width: 18%" />
            <col style="width: 26%" />
            <col style="width: 28%" />
            <col style="width: 28%" />
          </colgroup>
          <thead>
            <tr>
              <th>비교 항목</th>
              <th>C 문자열 (<code>const char*</code>)</th>
              <th>표준 문자열 (<code>std::string</code>)</th>
              <th>문자열 뷰 (<code>std::string_view</code>)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>메모리 소유권</strong></td>
              <td>없음 (외부 버퍼 가리킴)</td>
              <td><strong>독점 소유 (스택 버퍼 or 힙)</strong></td>
              <td>없음 (외부 문자열 관측)</td>
            </tr>
            <tr>
              <td><strong>종료 규약</strong></td>
              <td>반드시 널 문자 <code>'\0'</code>(Null-terminated) 필수</td>
              <td>내부 관리 (<code>'\0'</code> 자동 보장)</td>
              <td><strong><code>'\0'</code> 필요 없음 (포인터 + 길이)</strong></td>
            </tr>
            <tr>
              <td><strong>길이(Size) 복잡도</strong></td>
              <td>O(N) (<code>strlen</code> 전수 조사)</td>
              <td>O(1) (크기 필드 보유)</td>
              <td><strong>O(1) (크기 필드 보유)</strong></td>
            </tr>
            <tr>
              <td><strong>슬라이싱(Substr)</strong></td>
              <td>포인터 연산 (끝 지점 수정 불가)</td>
              <td><strong>O(N) 동적 힙 메모리 복사 발생</strong></td>
              <td><strong>O(1) 포인터/길이만 갱신 (무복사)</strong></td>
            </tr>
            <tr>
              <td><strong>객체 크기 (64-bit)</strong></td>
              <td>8 바이트 (포인터 1개)</td>
              <td>24~32 바이트 (SSO 버퍼 + 용량)</td>
              <td><strong>16 바이트 (포인터 + size_t)</strong></td>
            </tr>
          </tbody>
        </table>
      </div>

      <h4>댕글링 string_view(Dangling View)의 치명적 함정</h4>
      <p>
        <code>std::string_view</code>는 원본 버퍼의 주소만 바라보므로, <strong>임시 <code>std::string</code> 객체</strong>가
        표현식 평가 직후 소멸하면 소멸된 메모리를 가리키는 댕글링 뷰가 되어 즉시 미정의 동작(UB)을 유발합니다:
      </p>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">string_view_dangling_trap.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;
#include &lt;string&gt;
#include &lt;string_view&gt;

std::string get_temporary_string() &#123;
    return "Temporary Hello World";
&#125;

int main() &#123;
    // [치명적 버그!]: get_temporary_string()이 반환한 임시 string은 이 라인이 끝나면 즉시 소멸함!
    // std::string_view dangling_view = get_temporary_string();
    // std::println("&#123;&#125;", dangling_view); // 소멸된 메모리 역참조로 즉시 UB 발생!

    // [올바른 패턴]: 영속적인 실체 객체를 유지한 채 관측 뷰를 생성해야 함
    std::string persistent = "Safe Hello World";
    std::string_view safe_view = persistent;
    std::println("안전한 뷰: &#123;&#125;", safe_view);

    return 0;
&#125;</code></pre>
      </div>
    </section>

    <!-- 7.6절: 실무 스타일 가이드 비교 -->
    <section class="lesson-section" id="sec-7-6">
      <h3>7.6 실무 스타일 가이드 비교: 원시 배열 금지와 모던 뷰/컨테이너 권장</h3>

      <div class="style-comparison-card">
        <div class="style-card-header">
          <span class="style-badge">STYLE GUIDE DEBATE</span>
          <span class="style-card-title">실무 표준 관례 비교: 배열 및 뷰 인터페이스 원칙 (Google vs Core Guidelines)</span>
        </div>
        <p style="font-size: 0.92rem; color: var(--text-2); margin-bottom: 0.8rem; line-height: 1.6;">
          연속 메모리 버퍼와 문자열 슬라이스를 안전하게 다루기 위한 산업계 표준 가이드라인을 비교합니다:
        </p>
        <div class="style-grid">
          <div class="style-column">
            <div class="style-col-title">🏢 구글 C++ 스타일 가이드 (Google)</div>
            <p>
              <strong>1. 원시 C 배열 전면 퇴출:</strong><br>
              고정 크기 스택 배열은 반드시 <code>std::array</code>를 사용하고, 가변 크기 배열은 <code>std::vector</code>를 기본으로 채택합니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>2. 문자열 인자 전달 (<code>std::string_view</code>):</strong><br>
              읽기 전용 문자열 매개변수는 <code>const std::string&amp;</code>보다 <code>std::string_view</code>를 값(By-value)으로 전달하는 것을 표준으로 규정합니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>3. 경계 슬라이스 (<code>std::span</code>):</strong><br>
              원시 포인터와 길이를 쌍으로 전달하는 함수 인터페이스를 금지하고 <code>std::span</code>(또는 <code>absl::Span</code>)을 사용합니다.
            </p>
          </div>
          <div class="style-column">
            <div class="style-col-title">🌐 모던 C++ 코어 가이드라인 (Modern C++ Core Guidelines)</div>
            <p>
              <strong>1. Core Guidelines Bounds.1 (포인터 산술 및 비검사 인덱싱 금지):</strong><br>
              경계 검사가 불가능한 원시 포인터 산술과 인덱싱 연산을 금지하고 컨테이너 및 뷰를 사용할 것을 강제합니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>2. Core Guidelines I.13 (단일 포인터로 배열 전달 금지):</strong><br>
              단일 포인터(<code>T*</code>)로 배열을 전달하지 말아야 합니다. 항상 배열의 시작 주소와 길이를 함께 보장하는 <code>std::span</code>을 사용합니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>3. Core Guidelines F.24 (연속 요소 범위는 <code>std::span</code> 사용):</strong><br>
              연속 메모리 데이터를 읽기 전용으로 소비하는 함수의 매개변수는 컨테이너 종류에 종속되지 않는 <code>std::span&lt;const T&gt;</code>를 채택합니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7.7절: 터미널 실습 및 디버깅 -->
    <section class="lesson-section" id="sec-7-7">
      <h3>7.7 터미널 실습 및 디버깅: 원시 배열, std::span &amp; std::string_view 통합 검증</h3>

      <p>
        본 실습에서는 원시 배열의 메모리 연속 주소 실측, <code>std::span</code>의 다형적 수용 및 슬라이싱,
        <code>std::string_view</code>의 O(1) 부분 문자열 추출, 그리고 범위 기반 for 루프의 참조자 순회 최적화를 단일 프로그램으로 검증합니다.
      </p>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">ch07_arrays_and_views.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;
#include &lt;span&gt;
#include &lt;string&gt;
#include &lt;string_view&gt;
#include &lt;vector&gt;
#include &lt;array&gt;

// std::span을 활용한 안전한 연속 메모리 뷰
void inspect_span(std::span&lt;const int&gt; view, std::string_view label) &#123;
    std::print("[&#123;&#125;] 원소수: &#123;&#125;, 바이트: &#123;&#125;\n  원소 목록: ",
               label, view.size(), view.size_bytes());
    
    // 복사 오버헤드 없는 const auto&amp; 범위 기반 for 루프
    for (const auto&amp; elem : view) &#123;
        std::print("&#123;&#125; ", elem);
    &#125;
    std::println("");
&#125;

int main() &#123;
    std::println("=== [1] 물리 메모리 연속성 및 인덱스 실측 ===");
    int raw[4] = &#123;100, 200, 300, 400&#125;;
    for (int i = 0; i &lt; 4; ++i) &#123;
        std::println("raw[&#123;&#125;] 주소: &#123;&#125; | 값: &#123;&#125;",
                     i, static_cast&lt;const void*&gt;(&amp;raw[i]), raw[i]);
    &#125;

    std::println("\n=== [2] std::span 단일 인터페이스 다형 수용 ===");
    std::vector&lt;int&gt; dynamic_vec = &#123;11, 22, 33, 44, 55&#125;;
    std::array&lt;int, 3&gt; modern_arr = &#123;7, 8, 9&#125;;

    inspect_span(raw, "C 스타일 원시 배열");
    inspect_span(dynamic_vec, "std::vector");
    inspect_span(modern_arr, "std::array");

    std::println("\n=== [3] subspan 무복사 슬라이싱 ===");
    std::span&lt;const int&gt; vec_span&#123;dynamic_vec&#125;;
    auto middle_slice = vec_span.subspan(1, 3); // 22, 33, 44
    inspect_span(middle_slice, "vector 슬라이스(1~3)");

    std::println("\n=== [4] std::string vs std::string_view 비교 ===");
    std::string origin = "Core C++ Standard Architecture 2026";
    // 힙 복사 없이 원본 문자열의 일부분(인덱스 5부터 12자: "C++ Standard") 관측
    std::string_view sub_view = std::string_view&#123;origin&#125;.substr(5, 12);
    
    std::println("원본 string: &#123;&#125;", origin);
    std::println("무복사 string_view 슬라이스: &#123;&#125;", sub_view);
    std::println("뷰 길이: &#123;&#125; 글자, 포인터 주소: &#123;&#125;",
                 sub_view.size(), static_cast&lt;const void*&gt;(sub_view.data()));

    return 0;
&#125;</code></pre>
      </div>

      <h4>터미널 컴파일 및 실행 커맨드</h4>
