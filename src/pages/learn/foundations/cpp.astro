  }
  .note-header h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 1.5rem + 1.5vw, 2.5rem);
  }
  .topic-desc {
    font-size: 1.05rem;
    color: var(--text-2);
    line-height: 1.7;
    max-width: 850px;
  }

  /* Curriculum Roadmap Overview */
  .curriculum-overview {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2.2rem;
    margin-bottom: 3.5rem;
  }
  .section-title-wrap {
    margin-bottom: 1.8rem;
  }
  .section-title-wrap .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
  .section-title-wrap h2 {
    margin: 0 0 0.4rem;
    font-size: 1.5rem;
  }
  .section-title-wrap p {
    color: var(--text-3);
    margin: 0;
    font-size: 0.95rem;
  }

  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.4rem;
  }
  .phase-card {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: calc(var(--radius) - 2px);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
  }
  .active-phase {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--surface-2));
  }
  .phase-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }
  .phase-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent);
  }
  .phase-status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-3);
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--surface-1);
  }
  .phase-status.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    font-weight: 700;
  }
  .phase-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }
  .phase-desc {
    font-size: 0.86rem;
    color: var(--text-3);
    line-height: 1.5;
    margin: 0 0 1rem;
  }
  .phase-list {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    font-size: 0.82rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--text-2);
  }
  .phase-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .current-lesson-item {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 0.35rem !important;
    padding-bottom: 0.4rem;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.07);
  }
  .phase-chapter-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--accent);
    font-weight: 700;
    transition: all 0.15s ease;
  }
  .phase-chapter-link:hover {
    color: #93c5fd;
    text-shadow: 0 0 8px rgba(59, 130, 246, 0.5);
  }
  .goto-icon {
    font-size: 0.72rem;
    opacity: 0.7;
    transition: transform 0.15s ease;
  }
  .phase-chapter-link:hover .goto-icon {
    transform: translateX(3px);
    opacity: 1;
  }
  .sub-lesson-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-left: 1.25rem;
  }
  .sub-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.45rem;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-2);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .sub-chip:hover {
    color: #ffffff;
    background: rgba(59, 130, 246, 0.22);
    border-color: var(--accent);
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.35);
    transform: translateY(-1px);
  }
  .pending-item {
    opacity: 0.65;
  }
  .pending-tag {
    font-size: 0.68rem;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-3);
    font-family: var(--font-mono);
  }
  .current-lesson {
    color: var(--accent);
    font-weight: 700;
  }
  .lesson-num {
    font-family: var(--font-mono);
    color: var(--text-3);
    font-size: 0.75rem;
  }

  /* Lesson Article Section */
  .lesson-article {
    max-width: 900px;
    margin: 0 auto;
  }
  .lesson-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .lesson-badge {
    color: var(--accent);
    font-weight: 700;
  }
  .read-time {
    color: var(--text-3);
  }
  .lesson-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    scroll-margin-top: 5rem;
  }
  .lesson-header h2 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem);
  }
  .lesson-intro {
    font-size: 1.05rem;
    color: var(--text-2);
    line-height: 1.7;
    margin: 0;
  }

  /* Table of Contents */
  .content-toc {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.2rem 1.6rem;
    margin-bottom: 3rem;
  }
  .toc-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 0.6rem;
  }
  .content-toc ul {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .content-toc a {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color var(--dur-fast);
  }
  .content-toc a:hover {
    color: var(--accent);
  }

  /* Lesson Sections */
  .lesson-section {
    margin-bottom: 4rem;
    scroll-margin-top: 5rem;
  }
  .lesson-section h3 {
    font-size: 1.45rem;
    margin: 0 0 1rem;
    color: var(--text-1);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .lesson-section h4 {
    font-size: 1.15rem;
    margin: 1.8rem 0 0.6rem;
    color: var(--text-1);
  }
  .lesson-section p {
    color: var(--text-2);
    line-height: 1.8;
    margin: 0 0 1.2rem;
  }

  /* Pipeline Card */
  .pipeline-card {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin: 2rem 0;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.8rem;
  }
  .pipeline-step {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.2rem;
  }
  .step-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .pipeline-step h4 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }
  .pipeline-step p {
    font-size: 0.92rem;
    margin: 0 0 0.8rem;
  }
  .tool-flag {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent-2);
    background: var(--surface-1);
    padding: 4px 8px;
    border-radius: 4px;
    display: inline-block;
  }
  .pipeline-arrow {
    text-align: center;
    color: var(--text-3);
    font-weight: bold;
    font-size: 1.2rem;
  }

  /* Code Block */
  .code-block-wrap {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 1.5rem 0 2rem;
  }
  .code-header {
    background: var(--surface-2);
    padding: 0.5rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .code-block-wrap pre {
    margin: 0;
    padding: 1.2rem 1.4rem;
    overflow-x: auto;
    line-height: 1.65;
  }
  .code-block-wrap code {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text-1);
  }

  /* Spec Table */
  .spec-table-wrap {
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    text-align: left;
  }
  .spec-table th, .spec-table td {
    padding: 0.85rem 1rem;
    border: 1px solid var(--border-subtle);
  }
  .spec-table th {
    background: var(--surface-2);
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .spec-table td {
    background: var(--surface-1);
    color: var(--text-2);
    line-height: 1.6;
  }
  /* 1열 너비 확보(최소 22%~28% 규약) 및 단어 단위 무분별 개행 방지 */
  .spec-table th:first-child,
  .spec-table td:first-child {
    width: 26%;
    min-width: 165px;
    word-break: keep-all;
    white-space: normal;
  }
  /* colgroup이 선언된 테이블은 colgroup 설정을 최우선 적용 */
  .spec-table:has(colgroup) th:first-child,
  .spec-table:has(colgroup) td:first-child {
    width: auto;
    min-width: unset;
  }
  .nowrap-code {
    white-space: nowrap !important;
  }
  .spec-table code {
    color: var(--accent);
  }

  /* Stream Diagram */
  .stream-diagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin: 2rem 0;
  }
  .stream-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1rem 1.4rem;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }
  .stream-box.program {
    border-color: var(--accent);
  }
  .stream-box.hardware {
    border-color: var(--accent-2);
  }
  .box-title {
    font-size: 0.75rem;
    color: var(--text-3);
  }
  .stream-pipe {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .pipe-arrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }
  .buffer-zone {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px dashed var(--accent);
    border-radius: 4px;
    color: var(--text-1);
  }

  /* Concept Breakdown */
  .concept-breakdown {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    margin-top: 1.5rem;
  }
  .concept-item {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 1.4rem;
  }
  .concept-item h4 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
    color: var(--accent);
  }
  .concept-item ul {
    margin: 0.6rem 0;
    padding-left: 1.2rem;
    color: var(--text-2);
    line-height: 1.7;
    font-size: 0.92rem;
  }
  .rule-tip {
    margin-top: 0.8rem;
    padding: 0.6rem 0.9rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-left: 3px solid var(--accent);
    font-size: 0.88rem;
    color: var(--text-1);
  }

  /* Callouts */
  .callout {
    border-radius: var(--radius);
    padding: 1.2rem 1.4rem;
    margin: 1.5rem 0;
    line-height: 1.65;
  }
  .callout-info {
    background: color-mix(in srgb, var(--accent) 8%, var(--surface-1));
    border: 1px solid var(--accent);
  }
  .callout-warn {
    background: color-mix(in srgb, var(--warn) 8%, var(--surface-1));
    border: 1px solid var(--warn);
  }
  .callout-title {
    font-weight: 700;
    margin-bottom: 0.4rem;
    font-size: 0.95rem;
  }
  .callout-info .callout-title { color: var(--accent); }
  .callout-warn .callout-title { color: var(--warn); }
  .callout p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-2);
  }

  /* Syntax Grid */
  .syntax-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.4rem;
    margin: 1.5rem 0;
  }
  .syntax-card {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 1.2rem;
  }
  .syntax-card.full-width {
    grid-column: 1 / -1;
  }
  .syntax-card h4 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    color: var(--text-1);
  }
  .syntax-card p {
    font-size: 0.9rem;
    margin: 0 0 0.8rem;
  }
  .syntax-card pre {
    background: var(--code-bg);
    padding: 0.8rem;
    border-radius: 6px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-1);
  }

  /* Terminal Guide */
  .terminal-guide {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin: 1.5rem 0 2rem;
  }
  .term-step {
    display: flex;
    gap: 1.2rem;
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 1.4rem;
  }
  .term-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-2);
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--surface-2);
    height: fit-content;
  }
  .term-content {
    flex: 1;
  }
  .term-content h4 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }
  .term-content p {
    font-size: 0.92rem;
    margin: 0 0 0.6rem;
  }
  .cli-command {
    background: var(--code-bg);
    border: 1px solid var(--border-subtle);
    padding: 0.6rem 0.9rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.6rem;
  }
  .cmd-desc {
    color: var(--text-3);
    font-size: 0.78rem;
  }
  .term-content ul {
    margin: 0.6rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.88rem;
    color: var(--text-2);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  /* Error Grid */
  .error-trouble-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.2rem;
    margin: 1.5rem 0;
  }
  .trouble-card {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--danger);
    border-radius: var(--radius);
    padding: 1.2rem;
    font-size: 0.88rem;
  }
  .err-header {
    margin-bottom: 0.6rem;
  }
  .err-type {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--danger);
    font-weight: 700;
  }
  .err-header code {
    font-size: 0.78rem;
    color: var(--text-1);
    background: var(--surface-2);
    display: block;
    margin-top: 0.3rem;
    padding: 3px 6px;
  }
  .trouble-card p {
    margin: 0 0 0.4rem;
    line-height: 1.5;
  }
  .trouble-card .fix {
    color: var(--accent);
    margin: 0;
  }

  /* Lesson Summary & Footer */
  .lesson-summary {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .summary-box {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.8rem;
  }
  .summary-box h3 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    color: var(--accent);
  }
  .summary-box ul {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--text-2);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .chapter-separator {
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--border), var(--accent), var(--border), transparent);
    margin: 4.5rem 0 2rem;
    position: relative;
    scroll-margin-top: 4rem;
  }

  .chapter-scroll-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--accent);
    color: var(--surface-0);
    padding: 0.5rem 0.95rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: all var(--dur-fast);
  }
  .chapter-scroll-btn:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
    color: var(--surface-0);
  }

  .memory-layout-box {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
    margin: 1.5rem 0;
  }
  .memory-row {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .mem-cell {
    padding: 0.65rem 0.6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    border-right: 1px solid var(--border-subtle);
    text-align: center;
  }
  .mem-cell:last-child {
    border-right: none;
  }
  .mem-cell.data {
    background: color-mix(in srgb, var(--accent) 15%, var(--surface-2));
    color: var(--text-1);
  }
  .mem-cell.padding {
    background: color-mix(in srgb, #ef4444 14%, var(--surface-2));
    color: #f87171;
    font-style: italic;
  }

  /* Style Guide Comparison Card */
  .style-comparison-card {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.3rem 1.5rem;
    margin: 1.8rem 0;
  }
  .style-card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }
  .style-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .style-card-title {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-1);
  }
  .style-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 0.8rem;
  }
  .style-column {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1rem;
  }
  .style-col-title {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-1);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
