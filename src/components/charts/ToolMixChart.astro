---
export interface ToolMixRow {
  model: string;
  total: number;
  shell: number;
  read: number;
  edit: number;
  other: number;
  dividerBefore?: boolean;
}

interface Props {
  title: string;
  subtitle: string;
  footnote: string;
  rows: ToolMixRow[];
}

const { title, subtitle, footnote, rows } = Astro.props;
---

<figure class="chart-box wide">
  <div class="chart-head">
    <h3>{title}</h3>
    <p>{subtitle}</p>
  </div>

  <div class="chart-legend">
    <span><i class="sw shell"></i>셸 명령 (run_command 등)</span>
    <span><i class="sw read"></i>파일 읽기 · 탐색</span>
    <span><i class="sw edit"></i>파일 편집 · 작성</span>
    <span><i class="sw other"></i>MCP · 웹 · 기타</span>
  </div>

  <div class="mix-list" role="list" aria-label={title}>
    {rows.map((r) => (
      <>
        {r.dividerBefore && (
          <div class="family-divider" aria-hidden="true">
            <span>Gemini 4 계열</span>
          </div>
        )}
        <div class="mix-row" role="listitem">
          <div class="row-label">
            <span class="model-name">{r.model}</span>
            <span class="row-meta">총 {r.total.toLocaleString()}회</span>
          </div>
          <div class="mix-track">
            <div class="seg shell" style={`width: ${r.shell}%`} title={`셸 명령 ${r.shell}%`}>
              {r.shell >= 15 && <span>{Math.round(r.shell)}%</span>}
            </div>
            <div class="seg read" style={`width: ${r.read}%`} title={`읽기·탐색 ${r.read}%`}>
              {r.read >= 15 && <span>{Math.round(r.read)}%</span>}
            </div>
            <div class="seg edit" style={`width: ${r.edit}%`} title={`편집·작성 ${r.edit}%`}>
              {r.edit >= 15 && <span>{Math.round(r.edit)}%</span>}
            </div>
            <div class="seg other" style={`width: ${r.other}%`} title={`MCP·기타 ${r.other}%`}>
              {r.other >= 15 && <span>{Math.round(r.other)}%</span>}
            </div>
          </div>
        </div>
      </>
    ))}
  </div>

  <figcaption class="chart-foot">{footnote}</figcaption>

  <details class="raw-table">
    <summary>원본 수치 표 펼쳐 보기</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>모델</th>
            <th>총 호출</th>
            <th>셸 명령</th>
            <th>읽기 · 탐색</th>
            <th>편집 · 작성</th>
            <th>MCP · 기타</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>{r.model}</td>
              <td>{r.total.toLocaleString()}</td>
              <td>{r.shell}%</td>
              <td>{r.read}%</td>
              <td>{r.edit}%</td>
              <td>{r.other}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .chart-box {
    margin: 2rem 0;
    padding: 1.5rem 1.6rem;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .chart-head h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    color: var(--text-1);
  }
  .chart-head p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-3);
    line-height: 1.5;
  }
  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1rem 0 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-3);
  }
  .chart-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sw {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    display: inline-block;
  }
  .sw.shell, .seg.shell { background: var(--info); }
  .sw.read, .seg.read { background: var(--success); }
  .sw.edit, .seg.edit { background: var(--accent-2); }
  .sw.other, .seg.other { background: var(--warn); }

  .mix-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .family-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.3rem 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
  }
  .family-divider::before,
  .family-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-subtle);
  }

  .mix-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 0.9rem;
    align-items: center;
  }
  .row-label {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .model-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-1);
    line-height: 1.3;
  }
  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .mix-track {
    display: flex;
    height: 24px;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }
  .seg {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-inverse);
    font-variant-numeric: tabular-nums;
    overflow: hidden;
  }

  .chart-foot {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.82rem;
    color: var(--text-2);
    line-height: 1.55;
  }

  .raw-table {
    margin-top: 0.85rem;
  }
  .raw-table summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
  .table-scroll {
    overflow-x: auto;
    margin-top: 0.65rem;
  }
  .raw-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .raw-table th, .raw-table td {
    padding: 0.48rem 0.65rem;
    text-align: left;
    border-bottom: 1px solid var(--border-subtle);
  }
  .raw-table th {
    color: var(--text-2);
    background: var(--surface-2);
  }
  .raw-table td {
    color: var(--text-2);
  }

  @media (max-width: 720px) {
    .chart-box { padding: 1.1rem; }
    .mix-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
