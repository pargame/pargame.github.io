---
import BaseLayout from '../layouts/BaseLayout.astro';
import tracks from '../data/tracks.json';
---

<BaseLayout title="Home" description="pargame - 소프트웨어 시스템 공학 및 컴퓨터 과학 학습 허브">
  <!-- Hero Section -->
  <section class="hero">
    <div class="terminal-tag">
      <span class="status-dot"></span>
      <span>SYSTEM READY // KERNEL v1.0.0</span>
    </div>
    
    <h1 class="hero-title">
      Deep Systems & Engine Engineering
      <span class="gradient-text">Knowledge Hub</span>
    </h1>
    
    <p class="hero-desc">
      모던 C++, 분산 시스템 동시성, 고성능 네트워크 I/O부터 언리얼 엔진과 자체 언어(nung_lang) 설계까지.<br />
      컴퓨터 과학의 본질을 파고드는 엔지니어링 아카이브입니다.
    </p>

    <div class="hero-cta">
      <a href="/learn" class="btn btn-primary">학습 허브 탐색하기 →</a>
      <a href="/posts" class="btn btn-secondary">최신 블로그 글</a>
    </div>
  </section>

  <!-- Learning Tracks Grid -->
  <section class="tracks-section">
    <div class="section-header">
      <div class="section-meta">$ ls -la /learn/tracks</div>
      <h2>Learning Tracks (학습 트랙)</h2>
      <p>체계적 학습을 위한 4대 핵심 트랙입니다. 필요에 따라 무한히 확장 가능합니다.</p>
    </div>

    <div class="track-grid">
      {tracks.map((track) => (
        <div class="track-card" style={`--track-accent: ${track.accent}`}>
          <div class="track-card-header">
            <span class="track-badge">{track.name}</span>
            <span class="topic-count">{track.topics.length} Topics</span>
          </div>

          <h3 class="track-title">{track.koreanName}</h3>
          <p class="track-desc">{track.description}</p>

          <div class="topic-list">
            {track.topics.map((topic) => (
              <a href={`/learn/${track.id}/${topic.id}`} class="topic-pill">
                <span class="hash">#</span> {topic.name}
              </a>
            ))}
          </div>

          <a href={`/learn/${track.id}`} class="track-link">
            트랙 둘러보기 <span>→</span>
          </a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 3rem 0 4.5rem;
    max-width: 850px;
  }
  .terminal-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 8px var(--success);
  }
  .hero-title {
    font-size: clamp(2.2rem, 1.8rem + 2.5vw, 3.6rem);
    line-height: 1.15;
    margin-bottom: 1.2rem;
  }
  .gradient-text {
    display: block;
    background: var(--accent-grad);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-desc {
    font-size: 1.12rem;
    color: var(--text-2);
    line-height: 1.7;
    margin-bottom: 2.2rem;
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all var(--dur-fast);
  }
  .btn-primary {
    background: var(--accent);
    color: var(--text-inverse);
  }
  .btn-primary:hover {
    background: var(--accent-strong);
    box-shadow: var(--glow);
    color: var(--text-inverse);
  }
  .btn-secondary {
    background: var(--surface-2);
    color: var(--text-1);
    border: 1px solid var(--border);
  }
  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Tracks Grid */
  .tracks-section {
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }
  .section-header {
    margin-bottom: 2.2rem;
  }
  .section-meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .section-header h2 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }
  .section-header p {
    color: var(--text-3);
  }
  .track-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .track-card {
    position: relative;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    transition: transform var(--dur), border-color var(--dur), box-shadow var(--dur);
  }
  .track-card:hover {
    transform: translateY(-3px);
    border-color: var(--track-accent);
    box-shadow: 0 8px 30px -10px color-mix(in srgb, var(--track-accent) 25%, transparent);
  }
  .track-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .track-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--track-accent);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--track-accent) 12%, transparent);
  }
  .topic-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-3);
  }
  .track-title {
    font-size: 1.35rem;
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: var(--text-1);
  }
  .track-desc {
    font-size: 0.92rem;
    color: var(--text-2);
    line-height: 1.6;
    margin-bottom: 1.4rem;
  }
  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
  }
  .topic-pill {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    color: var(--text-2);
    text-decoration: none;
    transition: all var(--dur-fast);
  }
  .topic-pill:hover {
    border-color: var(--track-accent);
    color: var(--track-accent);
  }
  .topic-pill .hash {
    color: var(--track-accent);
  }
  .track-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--track-accent);
  }
  .track-link span {
    transition: transform var(--dur-fast);
  }
  .track-card:hover .track-link span {
    transform: translateX(4px);
  }
</style>
