    <!-- 5.6 실무 스타일 가이드 비교 -->
    <section id="sec-5-6" class="lesson-section">
      <h3>5.6 실무 스타일 가이드 비교: 원시 포인터의 사용과 소유권(Ownership) 규칙 (Google vs Core Guidelines)</h3>
      <p>
        "원시 포인터(Raw Pointer, <code>T*</code>)는 직접 <code>delete</code>를 호출해야 하는 자원의 소유자인가, 
        아니면 단순히 주소를 빌려보기만 하는 관찰자인가?"는 모던 C++ 자원 관리 아키텍처의 가장 중대한 분수령입니다.
      </p>

      <!-- 실무 스타일 가이드 비교: 구글 C++ 스타일 가이드 vs 모던 C++ 코어 가이드라인 -->
      <div class="style-comparison-card">
        <div class="style-card-header">
          <span class="style-badge">STYLE GUIDE DEBATE</span>
          <span class="style-card-title">실무 표준 관례 비교: 원시 포인터와 소유권 규칙 (Google vs Core Guidelines)</span>
        </div>
        <p style="font-size: 0.92rem; color: var(--text-2); margin-bottom: 0.8rem; line-height: 1.6;">
          메모리 누수와 댕글링 포인터를 원천 차단하기 위한 두 주요 진영의 원시 포인터 사용 철학을 비교합니다:
        </p>
        <div class="style-grid">
          <!-- Google Guide -->
          <div class="style-column">
            <div class="style-col-title">🏢 구글 C++ 스타일 가이드 (Google)</div>
            <p>
              <strong>1. 스마트 포인터 강제와 소유권 분리:</strong><br>
              동적 할당 메모리의 소유권을 갖는 원시 포인터 사용을 전면 금지합니다. 자원의 독점 소유권은 반드시 <code>std::unique_ptr</code>로, 공유 소유권은 <code>std::shared_ptr</code>로만 표현합니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>2. 원시 포인터는 '비소유 관찰자(Non-owning Observer)' 전용:</strong><br>
              함수 매개변수의 원시 포인터(<code>T*</code>, <code>const T*</code>)는 오직 객체를 소유하지 않고 단순히 주소를 빌려보거나, 인자가 <code>nullptr</code>일 수 있는 선택적(Optional) 전달에만 허용됩니다. 절대 원시 포인터에 대해 수동 <code>delete</code>를 호출하지 않습니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>3. 명시적 포인터 출력 인자 관례:</strong><br>
              과거부터 함수 내부에서 값이 변경되는 출력 인자는 호출부에서 <code>func(&amp;val)</code> 형태로 주소 연산자가 드러나 변경 사실을 알 수 있도록 포인터를 강제했으나, 최신 가이드는 값 반환을 우선 권장합니다.
            </p>
          </div>

          <!-- Core Guidelines -->
          <div class="style-column">
            <div class="style-col-title">🌐 모던 C++ 코어 가이드라인 (Modern C++ Core Guidelines)</div>
            <p>
              <strong>1. Core Guidelines I.11 &amp; F.22 (원시 포인터 소유권 부여 금지):</strong><br>
              원시 포인터(<code>T*</code>)는 메모리 누수의 주범이므로 단 1바이트의 자원도 소유해서는 안 됩니다. 소유권이 필요한 경우 <code>std::unique_ptr</code>를 쓰거나, 명시적으로 <code>gsl::owner&lt;T*&gt;</code>를 표기해야 합니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>2. Core Guidelines I.13 (단일 포인터로 배열 전달 금지):</strong><br>
              원시 포인터는 오직 '단일 객체'의 주소를 가리킬 때만 사용해야 합니다. 연속된 배열 메모리를 가리키거나 포인터 산술(<code>ptr + i</code>)로 순회하는 것을 엄격히 금지하며, 배열 범위는 반드시 <strong><code>std::span</code> (C++20)</strong>이나 <code>std::string_view</code>로 전달합니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>3. Core Guidelines F.60 (nullptr이 유효한 경우에만 포인터 인자 사용):</strong><br>
              참조자(<code>T&amp;</code>)는 항상 유효한 객체를 전제하므로, 인자가 전달되지 않을 수 있는 <code>nullptr</code> 상태가 유효한 비즈니스 로직에 한해서만 <code>const T*</code> 포인터를 허용합니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5.7 터미널 실습 및 디버깅 -->
    <section id="sec-5-7" class="lesson-section">
      <h3>5.7 터미널 실습 및 컴파일러 오류 디버깅</h3>
      <p>
        5단원에서 다룬 메모리 주소 추출, 역참조 수정, <code>nullptr</code> 검증, 포인터 산술 연산, <code>std::ptrdiff_t</code> 거리 계산,
        그리고 명령행 인자(<code>argc</code>, <code>argv</code>) 순회를 하나의 통합 프로그램으로 실습합니다.
      </p>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">ch05_pointers.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;
#include &lt;cstddef&gt;

// 함수 오버로딩 테스트: nullptr vs int 모호성 해결 검증
void process_input(int value) &#123;
    std::println("[process_input] 정수 값 처리: &#123;&#125;", value);
&#125;

void process_input(const char* text_ptr) &#123;
    if (text_ptr == nullptr) &#123;
        std::println("[process_input] 널 포인터 수신 (안전 가드 통과)");
        return;
    &#125;
    std::println("[process_input] 문자열 포인터 역참조: '&#123;&#125;'", text_ptr);
&#125;

int main(int argc, char* argv[]) &#123;
    std::println("=== 1. 주소 추출(&amp;)과 역참조(*) 변수 수정 ===");
    int score&#123;88&#125;;
    int* p_score&#123;&amp;score&#125;;

    std::println("수정 전 score: &#123;&#125; (주소: &#123;&#125;)", score, static_cast&lt;void*&gt;(p_score));
    *p_score = 95; // 원본 변수 직접 갱신
    std::println("수정 후 score: &#123;&#125;", score);

    std::println("\n=== 2. nullptr의 타입 안전성과 오버로딩 ===");
    process_input(42);       // process_input(int) 호출
    process_input(nullptr);  // 정확히 process_input(const char*) 호출

    std::println("\n=== 3. 포인터 산술과 std::ptrdiff_t 거리 계산 ===");
    double metrics[4]&#123;1.1, 2.2, 3.3, 4.4&#125;;
    double* start_ptr = metrics;
    double* end_ptr   = metrics + 3;

    std::println("start_ptr: &#123;&#125;, end_ptr: &#123;&#125;", 
                 static_cast&lt;void*&gt;(start_ptr), static_cast&lt;void*&gt;(end_ptr));
    std::println("배열 보폭: (end_ptr - start_ptr) = &#123;&#125;개 원소", end_ptr - start_ptr);

    // 포인터 전진 순회
    std::print("포인터 산술 순회: ");
    for (double* p = start_ptr; p &lt;= end_ptr; ++p) &#123;
        std::print("&#123;&#125; ", *p);
    &#125;
    std::println("");

    std::println("\n=== 4. 명령행 인자(argc, argv) 메모리 순회 ===");
    std::println("실행 인자 총합: &#123;&#125;개", argc);
    for (int i&#123;0&#125;; i &lt; argc; ++i) &#123;
        std::println("  argv[&#123;&#125;] = '&#123;&#125;'", i, argv[i]);
    &#125;

    return 0;
&#125;</code></pre>
      </div>

