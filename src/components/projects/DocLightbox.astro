---
// 문서 페이지 공용 이미지 확대 보기. .zoomable-img 이미지를 누르면 캡션과 함께 크게 보여 준다.
---

<div class="wp-lightbox" id="wp-lightbox" aria-hidden="true" role="dialog" aria-label="이미지 확대 보기">
  <button type="button" class="wp-lightbox-close" id="wp-lightbox-close" aria-label="닫기">×</button>
  <img id="wp-lightbox-img" src="" alt="" />
  <p id="wp-lightbox-cap"></p>
</div>

<script>
  const lightbox = document.getElementById('wp-lightbox');
  const lbImg = document.getElementById('wp-lightbox-img') as HTMLImageElement | null;
  const lbCap = document.getElementById('wp-lightbox-cap');
  const lbClose = document.getElementById('wp-lightbox-close') as HTMLButtonElement | null;
  let lastFocused: HTMLElement | null = null;

  document.querySelectorAll<HTMLImageElement>('.zoomable-img').forEach((img) => {
    img.tabIndex = 0;
    const openImage = () => {
      if (!lightbox || !lbImg) return;
      lastFocused = document.activeElement as HTMLElement | null;
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      if (lbCap) {
        lbCap.textContent = img.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? img.alt;
      }
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
      lbClose?.focus();
    };
    img.addEventListener('click', openImage);
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openImage();
      }
    });
  });

  const closeLightbox = () => {
    if (!lightbox?.classList.contains('open')) return;
    lightbox.classList.remove('open');
    lightbox.setAttribute('aria-hidden', 'true');
    lastFocused?.focus();
  };

  lbClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
