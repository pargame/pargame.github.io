float ASpaceDrifterPawn::EvaluateNetFunnelRadiusCm(float NormalizedT, float CurrentReachAlpha) const
{
	// NS_Tendril_GossamerSpores 의 Spoke/WebRing HLSL 반경 식과 1:1 일치
	const float ClampedT = FMath::Clamp(NormalizedT, 0.0f, 1.0f);
	const float U = FMath::Clamp((ClampedT - 0.36f) / 0.64f, 0.0f, 1.0f);
	const float Bloom = FMath::Lerp(0.18f, 1.0f, FMath::Clamp((CurrentReachAlpha - 0.54f) / 0.46f, 0.0f, 1.0f));
	return 11.0f * FMath::Sin(ClampedT * UE_PI) + 250.0f * (U * U * (0.25f + 0.75f * U)) * Bloom;
}

void ASpaceDrifterPawn::SweepAndCaptureMinerals(
	const FVector& StartPos,
	float MaxNetLenCm,
	float CurrentReachAlpha,
	float TimeSec)
{
	// AlongCm 범위([35.0f, ReachTipCm + PaddingCm])와 단면 반경(NetRadiusAtT + PaddingCm) 모두 통과 시 포획
	const float NetRadiusAtT = EvaluateNetFunnelRadiusCm(ClampedT, CurrentReachAlpha);
	if (RadialDist > NetRadiusAtT + PaddingCm)
	{
		continue;
	}
	if (Mineral->BeginNetCapture(this, ClampedT, RadialDir2D, RadialFrac))
	{
		CaughtNetMinerals.AddUnique(Mineral);
	}
}`;

const codeMineralSync = `// Source/UEStudy/Sandbox/MiniProject/SpaceMineral.cpp & SpaceDrifterPawn.cpp — 0프레임 오차 동기화 & 흡수
bool ASpaceMineral::BeginNetCapture(
	ASpaceDrifterPawn* CapturerPawn,
	float InNetAnchorT,
	const FVector2D& InRadialDir2D,
	float InRadialFraction)
{
	if (!CapturerPawn || !IsAvailableForCapture())
	{
		return false;
	}

	const FVector OutwardUp = GetActorUpVector();
	DetachFromActor(FDetachmentTransformRules::KeepWorldTransform);
	HostAsteroidPtr.Reset();

	if (AAsteroidFieldManager* Mgr = OwnerManager.Get())
	{
		Mgr->MarkMineralConsumed(ActiveMineralHash);
	}

	CapturerPtr = CapturerPawn;
	MineralState = ESpaceMineralState::BeingAbsorbed;
	CaptureStartWorldPos = GetActorLocation() + OutwardUp * 12.0f;
	NetAnchorT = FMath::Clamp(InNetAnchorT, 0.08f, 0.99f);
	NetRadialDir2D = InRadialDir2D.IsNearlyZero() ? FVector2D(1.0f, 0.0f) : InRadialDir2D.GetSafeNormal();
	NetRadialFraction = FMath::Clamp(InRadialFraction, 0.0f, 0.88f);
	NetBindBlendAlpha = 0.0f;
	AbsorbElapsed = 0.0f;
	bFallbackDirectPull = false;

	// 위치 갱신은 ASpaceDrifterPawn의 그물 촉수 틱에서 0프레임 오차로 직접 동기화
	PrimaryActorTick.SetTickFunctionEnable(false);
	return true;
}

bool ASpaceMineral::SyncToNetPosition(
	float DeltaTime,
	const FVector& NetWorldPos,
	const FVector& PawnBodyPos,
	float AbsorbContactRadius,
	bool bIsRetracting,
	float NetEasedReach)
{
	AbsorbElapsed += DeltaTime;
	NetBindBlendAlpha = FMath::Min(1.0f, NetBindBlendAlpha + DeltaTime * 14.0f);
	const float SmoothBind = FMath::SmoothStep(0.0f, 1.0f, NetBindBlendAlpha);
	const FVector SyncedLoc = FMath::Lerp(CaptureStartWorldPos, NetWorldPos, SmoothBind);

	SetActorLocation(SyncedLoc, false, nullptr, ETeleportType::TeleportPhysics);
	AddActorLocalRotation(FRotator(150.0f * DeltaTime, 220.0f * DeltaTime, 110.0f * DeltaTime));

	const float DistToPawn = FVector::Distance(SyncedLoc, PawnBodyPos);
	const float ShrinkAlpha = FMath::Clamp(DistToPawn / 220.0f, 0.25f, 1.0f);
	SetActorScale3D(BaseScale3D * ShrinkAlpha);

	if (DistToPawn <= AbsorbContactRadius || (bIsRetracting && NetEasedReach <= 0.06f) || AbsorbElapsed >= 5.0f)
	{
		FinishAbsorption();
		return true;
	}

	return false;
}`;

const codeChunkSpatialConfig = `// Source/UEStudy/Sandbox/MiniProject/AsteroidFieldManager.h — 청크 단위 공간 분할 & 전방 예측 구형 파라미터
UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|Spatial")
float ChunkSizeCm = 2000.0f; // 20m 정육면체 청크(Chunk) 공간 단위

UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|Spatial")
float ActivateRadiusCm = 4600.0f; // 전방 예측 스트리밍 구 활성 반경

UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|Spatial")
float DeactivateRadiusCm = 5600.0f; // 히스테리시스 이탈 언로드 반경

UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|Spatial")
float MinSafeSpawnRadiusCm = 520.0f; // 플레이어 즉사 충돌 방지 안전 반경

UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "AsteroidField|Spatial")
