    <!-- 6.1 참조자의 본질 -->
    <section id="sec-6-1" class="lesson-section">
      <h3>6.1 참조자(Reference, T&amp;)의 본질: 메모리 별칭(Alias)과 포인터와의 차이</h3>
      <p>
        C++에서 <strong>참조자(Reference, <code>T&amp;</code>)</strong>는 이미 존재하는 어떤 변수의 <strong>또 다른 이름(별칭, Alias)</strong>입니다.
        컴파일러 내부(어셈블리 단계)에서는 보통 포인터(주소 보관)와 유사한 기계어로 변환되지만,
        C++ 언어 추상화 모델 관점에서 참조자는 <em>독립된 메모리 주소를 갖는 새로운 객체가 아니라 원본 객체 그 자체</em>로 취급됩니다.
      </p>

      <div class="concept-breakdown">
        <div class="concept-item">
          <h4>1. 선언 즉시 초기화 필수 (No Uninitialized References)</h4>
          <p>
            포인터는 <code>int* p;</code> 처럼 초기화 없이 선언하거나 <code>nullptr</code>로 비워둘 수 있지만,
            참조자는 반드시 선언과 동시에 실재하는 유효한 lvalue 객체에 바인딩되어야 합니다.
            따라서 C++에는 <strong>"초기화되지 않은 참조자"</strong>나 <strong>"널 참조자(Null Reference)"</strong>라는 개념이 문법상 원천 차단됩니다.
          </p>
        </div>

        <div class="concept-item">
          <h4>2. 재바인딩 불가 (No Re-seating)</h4>
          <p>
            참조자는 한 번 특정 객체에 묶이면 평생 그 객체만을 가리킵니다.
            이미 선언된 참조자에 다른 변수를 대입(<code>ref = other;</code>)하면, 참조자가 다른 변수를 가리키도록 변경되는 것이 아니라 
            <strong>가리키고 있던 원본 객체에 새 값이 덮어써집니다.</strong>
          </p>
        </div>

        <div class="concept-item">
          <h4>3. 주소와 크기의 투명성</h4>
          <p>
            참조자에 주소 연산자(<code>&amp;ref</code>)를 취하면 참조자 자신의 주소가 아닌 <strong>원본 객체의 주소</strong>가 반환됩니다.
            마찬가지로 <code>sizeof(ref)</code>를 실행하면 포인터 크기(8바이트)가 아니라 <strong>원본 타입의 크기(<code>sizeof(T)</code>)</strong>가 반환됩니다.
          </p>
        </div>
      </div>

      <h4>포인터 vs 참조자 4대 핵심 문법 비교</h4>
      <div class="spec-table-wrap">
        <table class="spec-table">
          <colgroup>
            <col style="width: 22%;" />
            <col style="width: 39%;" />
            <col style="width: 39%;" />
          </colgroup>
          <thead>
            <tr>
              <th>비교 항목</th>
              <th>포인터 (<code>T*</code>)</th>
              <th>참조자 (<code>T&amp;</code>)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>문법 및 접근</strong></td>
              <td>간접 참조 연산자(<code>*ptr</code>, <code>ptr-&gt;member</code>) 필요</td>
              <td>일반 변수와 완전히 동일하게 직접 사용 (<code>ref</code>, <code>ref.member</code>)</td>
            </tr>
            <tr>
              <td><strong>초기화 및 널(Null)</strong></td>
              <td>초기화 생략 가능, <code>nullptr</code> 허용</td>
              <td><strong>선언 즉시 초기화 필수, 널 상태 불가</strong></td>
            </tr>
            <tr>
              <td><strong>재바인딩(Re-seating)</strong></td>
              <td>언제든 다른 주소로 변경 가능 (<code>ptr = &amp;other;</code>)</td>
              <td><strong>최초 바인딩 영구 고정 (재바인딩 절대 불가)</strong></td>
            </tr>
            <tr>
              <td><strong>sizeof 연산 결과</strong></td>
              <td>항상 주소 크기 (64비트 아키텍처에서 8바이트)</td>
              <td><strong>원본 대상 타입의 크기 (<code>sizeof(T)</code>)</strong></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">reference_alias.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;

int main() &#123;
    int original&#123;50&#125;;
    int&amp; ref&#123;original&#125;; // original에 대한 참조자(별칭) 바인딩

    // 1. 값 수정 파급: ref를 수정하면 original이 직접 수정됨
    ref = 100;
    std::println("original: &#123;&#125;, ref: &#123;&#125;", original, ref); // 둘 다 100

    // 2. 주소의 완전한 일치 (&amp;ref == &amp;original)
    std::println("&amp;original: &#123;&#125;, &amp;ref: &#123;&#125;", 
                 static_cast&lt;void*&gt;(&amp;original), static_cast&lt;void*&gt;(&amp;ref));

    // 3. 재바인딩 불가 실증: 다른 변수 대입 시 대상이 바뀌지 않고 값이 덮어써짐
    int another&#123;999&#125;;
    ref = another; // ref가 another를 가리키는 것이 아니라, original에 999가 대입됨!
    std::println("대입 후 original: &#123;&#125;, another: &#123;&#125;", original, another); // original: 999

    // 4. sizeof 연산 결과
    std::println("sizeof(ref): &#123;&#125; B (int 크기와 동일)", sizeof(ref)); // 4바이트 출력

    return 0;
&#125;</code></pre>
      </div>
    </section>

    <!-- 6.2 const 참조와 수명 연장 -->
    <section id="sec-6-2" class="lesson-section">
      <h3>6.2 const lvalue 참조(const T&amp;)와 임시 객체 수명 연장(Lifetime Extension)</h3>
      <p>
        일반적인 비-const 참조(<code>T&amp;</code>)는 메모리 주소를 갖는 영속 객체(lvalue)에만 바인딩될 수 있습니다.
        숫자 리터럴(<code>10</code>)이나 표현식의 중간 연산 결과 같은 임시 값(rvalue)은 
        "수정할 수 있는 원본 변수"가 아니므로 바인딩 시 컴파일 에러가 발생합니다.
      </p>

      <div class="concept-breakdown">
        <div class="concept-item">
          <h4>1. <code>const T&amp;</code>의 임시 객체 수명 연장 규칙 (ISO C++ 임시 객체 수명 연장 규약 [class.temporary])</h4>
          <p>
            C++ 표준 규약은 <strong><code>const</code> lvalue 참조자(<code>const T&amp;</code>)가 rvalue(임시 객체나 리터럴)에 바인딩될 때, 
            컴파일러가 스택에 보이지 않는 임시 객체를 생성하고 그 임시 객체의 수명을 <code>const</code> 참조자의 스코프 끝까지 연장</strong>하도록 보장합니다.
          </p>
        </div>

        <div class="concept-item">
          <h4>2. 함수 매개변수 설계에서의 혁신적 이점</h4>
          <p>
            이 규약 덕분에 함수 매개변수를 <code>const T&amp;</code>로 선언하면 다음과 같은 막강한 유연성을 얻습니다:
          </p>
          <ul>
            <li><strong>복사 오버헤드 0:</strong> 대형 객체(문자열, 벡터, 구조체)를 넘길 때 복사본을 만들지 않고 8바이트 주소로 안전하게 전달합니다.</li>
            <li><strong>모든 값 형태 수용:</strong> 영속 변수(lvalue)는 물론, 리터럴(<code>"hello"</code>)이나 임시 객체(<code>std::string("world")</code>)까지 단 하나의 함수 시그니처로 모두 받아들일 수 있습니다.</li>
            <li><strong>불변성 보장:</strong> 함수 내부에서 실수로 원본 데이터를 변경하는 것을 컴파일 타임에 원천 차단합니다.</li>
          </ul>
        </div>
      </div>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">const_ref_lifetime.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;
#include &lt;string&gt;

std::string create_greeting() &#123;
    return "반환된 임시 문자열"; // rvalue 임시 객체 반환
&#125;

int main() &#123;
    // int&amp; bad_ref = 10; // 컴파일 에러! non-const 참조에 rvalue 바인딩 불가
    
    // 1. 리터럴 바인딩 및 수명 연장
    const int&amp; safe_num = 10; // 정상: 컴파일러가 임시 int(10)을 생성하고 수명 연장
    std::println("safe_num: &#123;&#125;", safe_num);

    // 2. 함수 반환 임시 객체의 수명 연장
    // 본래 함수가 끝나면 파괴되어야 할 임시 std::string 객체가 msg_ref의 수명 동안 유지됨
    const std::string&amp; msg_ref = create_greeting();
    std::println("msg_ref: '&#123;&#125;' (수명 연장 정상 접근)", msg_ref);

    return 0;
&#125;</code></pre>
      </div>
    </section>

    <!-- 6.3 포인터 vs 참조자 심층 선택 가이드 -->
    <section id="sec-6-3" class="lesson-section">
      <h3>6.3 포인터 vs 참조자 심층 선택 가이드</h3>
      <p>
        C++ 실무에서 가장 흔히 마주치는 설계 질문은 <strong>"함수 매개변수나 멤버 변수를 정의할 때 포인터(<code>T*</code>)를 써야 하는가, 참조자(<code>T&amp;</code>)를 써야 하는가?"</strong>입니다.
        모던 C++에서는 명확한 판단 기준에 따라 선택합니다.
      </p>

      <h4>포인터 vs 참조자 선택 의사결정 기준</h4>
      <div class="spec-table-wrap">
        <table class="spec-table">
          <colgroup>
            <col style="width: 25%;" />
            <col style="width: 25%;" />
            <col style="width: 50%;" />
          </colgroup>
          <thead>
            <tr>
              <th>설계 요구사항</th>
              <th>추천 도구</th>
              <th>선택 근거 및 기술적 이유</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>반드시 존재하는 유효 객체</strong></td>
              <td><strong>참조자 (<code>T&amp;</code>, <code>const T&amp;</code>)</strong></td>
              <td>널(Null) 체크 오버헤드가 없으며, 댕글링 가능성을 최소화하고 문법이 직관적임</td>
            </tr>
            <tr>
              <td><strong>값이 없을 수 있음 (Nullable)</strong></td>
              <td><strong>포인터 (<code>T*</code>)</strong> 또는 <code>std::optional</code></td>
              <td><code>nullptr</code>를 명시적 센티널로 넘겨 "선택적 인자"임을 인터페이스에 선언</td>
            </tr>
            <tr>
              <td><strong>연산자 오버로딩 인터페이스</strong></td>
              <td><strong>참조자 (<code>T&amp;</code>)</strong></td>
              <td><code>stream &lt;&lt; a</code>, <code>arr[i] = v</code> 처럼 일반 연산자 문법을 유지하기 위해 필수</td>
            </tr>
            <tr>
              <td><strong>가리키는 대상을 교체해야 함</strong></td>
              <td><strong>포인터 (<code>T*</code>)</strong></td>
              <td>참조자는 재바인딩이 불가능하므로, 링크드 리스트 순회나 대상 교체는 포인터 필수</td>
            </tr>
            <tr>
              <td><strong>대형 객체의 읽기 전용 전달</strong></td>
              <td><strong><code>const T&amp;</code></strong></td>
              <td>복사 오버헤드를 완전히 없애고(0비용), 원본 수정을 방지하는 모던 C++의 표준 관례</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="callout callout-info">
        <div class="callout-title">💡 핵심 설계 격언: 기본값은 참조자, 포인터는 특별한 이유가 있을 때만</div>
        <p>
          Bjarne Stroustrup은 <em>"Use references when you can, and pointers when you must."</em>라고 강조했습니다.
          참조자는 문법적으로 널(Null)을 허용하지 않으므로 코드의 사전조건(Pre-condition)을 강력하게 보장합니다.
          포인터는 오직 '널 상태 허용'이나 '재할당'이 필수적인 경우로 국한하는 것이 안전한 아키텍처의 비결입니다.
        </p>
      </div>
    </section>

    <!-- 6.4 명시적 타입 변환과 const 안정성 -->
    <section id="sec-6-4" class="lesson-section">
      <h3>6.4 명시적 타입 변환과 const 안정성 (static_cast 기초 및 const_cast)</h3>
      <p>
        C 언어 시절의 괄호 캐스트 <code>(int)value</code>는 컴파일러의 타입 검사를 강제로 무력화하여
        의도치 않은 메모리 왜곡과 치명적 버그를 유발했습니다.
        C++은 변환의 의도와 안전성에 따라 <strong>4대 명시적 캐스팅 키워드</strong>를 제공하며,
        그중 가장 기본이 되는 것이 <code>static_cast</code>와 <code>const_cast</code>입니다.
      </p>

      <div class="concept-breakdown">
        <div class="concept-item">
          <h4>1. 컴파일 타임 검증: <code>static_cast&lt;T&gt;(expr)</code></h4>
          <p>
            논리적으로 연관된 타입 간의 안전한 변환을 <strong>컴파일 타임에 검증</strong>합니다.
          </p>
          <ul>
            <li><strong>기본 수치형 변환:</strong> <code>double</code>을 <code>int</code>로 변환하여 소수점을 절삭할 때, 축소 변환(Narrowing)을 프로그래머가 의도했음을 명시합니다.</li>
            <li><strong>불법 변환 차단:</strong> 전혀 관련 없는 포인터 간 변환(예: <code>int*</code>를 <code>double*</code>로 변환)을 시도하면 컴파일러가 즉시 에러를 발생시켜 안전을 보호합니다.</li>
          </ul>
        </div>

        <div class="concept-item">
          <h4>2. 상수성 해제: <code>const_cast&lt;T&gt;(expr)</code>와 미정의 동작(UB)</h4>
          <p>
            포인터나 참조자에서 오직 <strong><code>const</code> 또는 <code>volatile</code> 한정자만을 떼어내는(Remove)</strong> 특수 캐스트입니다.
          </p>
          <ul>
            <li><strong>유일한 합법적 용도:</strong> <code>const</code> 키워드가 도입되기 전에 작성된 구식 C 라이브러리 함수(시그니처가 <code>void legacy_func(char* p);</code>이지만 실제로는 값을 수정하지 않는 함수)를 호출할 때 <code>const_cast&lt;char*&gt;(str)</code> 형태로 넘기는 경우에만 한정됩니다.</li>
            <li><strong>치명적 미정의 동작 (Undefined Behavior):</strong> 애초에 <code>const int x = 10;</code> 처럼 <strong>진짜 상수 메모리(Read-Only Data Segment)로 선언된 객체</strong>의 상수성을 <code>const_cast</code>로 벗겨내어 값을 수정하려 들면, 컴파일러 최적화로 인해 값이 바뀌지 않거나 런타임 세그멘테이션 폴트(Bus Error)로 프로세스가 즉시 크래시됩니다 (ISO C++ 표준: '상수 객체 수정 금지' 규약 [dcl.type.cv] p4).</li>
          </ul>
        </div>
      </div>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">static_and_const_cast.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;

// 레거시 API 모사: 실제로는 수정하지 않지만 시그니처에 const가 빠져 있음
void legacy_c_print(char* str) &#123;
    std::println("레거시 출력: &#123;&#125;", str);
&#125;

int main() &#123;
    // 1. static_cast: 안전한 컴파일 타임 수치 변환
    double pi = 3.141592;
    int truncated = static_cast&lt;int&gt;(pi); // 소수점 유실 의도를 컴파일러에 명시
    std::println("static_cast 절삭 결과: &#123;&#125;", truncated);

    // int* p_bad = static_cast&lt;int*&gt;(&amp;pi); // 컴파일 에러! 무관한 포인터 변환 차단

    // 2. const_cast: 레거시 인터페이스 연동 (합법적 용도)
    char mutable_buf[] = "Hello System";
    const char* view_ptr = mutable_buf; // 본래 수정 가능한 버퍼
    legacy_c_print(const_cast&lt;char*&gt;(view_ptr)); // 합법적 상수성 제거

    // 3. const_cast의 치명적 함정 (미정의 동작 UB!)
    const int real_constant = 100; // 읽기 전용 메모리에 상주할 수 있는 진짜 상수
    int* dangerous_ptr = const_cast&lt;int*&gt;(&amp;real_constant);
    (void)dangerous_ptr; // 역참조 쓰기 시도 자체가 UB이므로 포인터 획득만 확인
    // *dangerous_ptr = 200; // 미정의 동작(UB)! 컴파일러 최적화 왜곡 또는 런타임 크래시 유발

    return 0;
&#125;</code></pre>
      </div>
    </section>

    <!-- 6.5 댕글링 참조의 위험성 -->
    <section id="sec-6-5" class="lesson-section">
      <h3>6.5 댕글링 참조(Dangling Reference)의 위험성과 지역 변수 반환의 UB 참사</h3>
      <p>
        포인터에서 이미 해제된 힙 메모리를 가리키는 것을 댕글링 포인터라 하듯,
        참조자에서도 이미 수명이 다해 소멸된 객체를 계속 참조하는 상태를 <strong>댕글링 참조(Dangling Reference)</strong>라 부릅니다.
        C++ 초심자가 저지르는 가장 흔하고 치명적인 버그 중 하나는 <strong>함수 내부의 지역(스택) 변수를 참조자로 반환하는 것</strong>입니다.
      </p>

      <div class="concept-breakdown">
        <div class="concept-item">
          <h4>스택 프레임 소멸과 댕글링 메커니즘</h4>
          <p>
            4.2절에서 다룬 Call Stack 규약에 따라, 함수가 종료(<code>return</code>)되면 해당 함수의 스택 프레임은 즉시 되감기(Stack Unwinding)되어 무효화됩니다.
            만약 지역 변수의 참조(<code>int&amp;</code>)나 주소를 반환하면, 호출자는 <em>이미 파괴되어 다른 함수에 의해 언제든 덮어씌워질 수 있는 쓰레기 메모리</em>의 별칭을 쥐게 됩니다.
          </p>
        </div>

        <div class="concept-item">
          <h4>올바른 해결책: 값 반환 (Return by Value)</h4>
          <p>
            기본 스칼라 타입이나 작은 객체는 고민 없이 <strong>값으로 반환(<code>T</code>)</strong>해야 합니다.
            모던 C++ 컴파일러는 복사 생략(RVO, Return Value Optimization)을 수행하므로 복사 비용이 완전히 제거되어 100% 안전하고 빠릅니다.
          </p>
        </div>
      </div>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">dangling_reference_trap.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;

// [치명적 안티 패턴]: 컴파일러가 -Wreturn-stack-address 경고 발생!
const int&amp; bad_function() &#123;
    int local_val&#123;42&#125;;
    return local_val; // 함수 종료 즉시 local_val 스택 메모리 소멸 -> 댕글링 참조!
&#125;

// [모던 C++ 표준 모범 패턴]: 값 반환 (RVO로 복사 0비용)
int safe_function() &#123;
    int local_val&#123;42&#125;;
    return local_val; // 안전하게 레지스터/반환 슬롯으로 값 전달
&#125;

int main() &#123;
    // const int&amp; corrupted = bad_function(); // UB! 읽을 때 쓰레기 값 또는 크래시
    int valid = safe_function(); // 100% 안전
    std::println("안전한 반환 값: &#123;&#125;", valid);
    return 0;
&#125;</code></pre>
      </div>
    </section>

    <!-- 6.6 실무 스타일 가이드 비교 -->
    <section id="sec-6-6" class="lesson-section">
      <h3>6.6 실무 스타일 가이드 비교: 참조자 설계와 const 규약 (Google vs Core Guidelines)</h3>
      <p>
        함수 시그니처에서 인자를 수정할 때 "비-const 참조(<code>T&amp;</code>)를 쓸 것인가, 포인터(<code>T*</code>)를 쓸 것인가"는
        코드 가독성과 안전성을 둘러싼 오랜 스타일 가이드 논쟁점입니다.
      </p>

      <!-- 실무 스타일 가이드 비교: 구글 C++ 스타일 가이드 vs 모던 C++ 코어 가이드라인 -->
      <div class="style-comparison-card">
        <div class="style-card-header">
          <span class="style-badge">STYLE GUIDE DEBATE</span>
          <span class="style-card-title">실무 표준 관례 비교: 참조자 설계와 const 규약 (Google vs Core Guidelines)</span>
        </div>
        <p style="font-size: 0.92rem; color: var(--text-2); margin-bottom: 0.8rem; line-height: 1.6;">
          출력 인자의 명시성과 널 안전성을 둘러싼 구글 스타일 가이드와 C++ 코어 가이드라인의 설계 철학을 비교합니다:
        </p>
        <div class="style-grid">
          <!-- Google Guide -->
          <div class="style-column">
            <div class="style-col-title">🏢 구글 C++ 스타일 가이드 (Google)</div>
            <p>
              <strong>1. 입력 인자는 <code>const T&amp;</code> 표준화:</strong><br>
              복사 오버헤드가 있는 모든 복합 객체 입력 매개변수는 반드시 <code>const T&amp;</code>로 전달합니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>2. 수정/출력 인자에 포인터(<code>T*</code>) 강제:</strong><br>
              구글은 호출부 가독성을 위해 비-const 참조(<code>T&amp;</code>)를 지양합니다. <code>func(val);</code> 형태는 <code>val</code>이 수정되는지 읽는 이가 알기 어렵지만, <code>func(&amp;val);</code> 처럼 주소 연산자(<code>&amp;</code>)가 보이면 "값이 수정된다"는 사실을 명확히 인지할 수 있기 때문입니다. (최신 개정판에서는 값 반환을 우선 권장)
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>3. const 정확성 (Const Correctness):</strong><br>
              변경되지 않는 모든 지역 변수, 함수 매개변수, 클래스 멤버 함수(메서드)에 예외 없이 <code>const</code>를 명시할 것을 강제합니다.
            </p>
          </div>

          <!-- Core Guidelines -->
          <div class="style-column">
            <div class="style-col-title">🌐 모던 C++ 코어 가이드라인 (Modern C++ Core Guidelines)</div>
            <p>
              <strong>1. Core Guidelines F.16 &amp; F.17 (인플레이스 수정은 <code>T&amp;</code>):</strong><br>
              코어 가이드라인은 구글의 포인터 출력 관례를 반대합니다. "포인터는 널(nullptr)이 유효할 때만 써야 한다"는 원칙에 따라, 객체가 반드시 존재해야 하는 수정 매개변수는 널 체크 오버헤드가 없는 <strong>비-const 참조(<code>T&amp;</code>)</strong>를 사용해야 합니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>2. Core Guidelines F.20 (출력 매개변수 지양 및 값 반환):</strong><br>
              결과를 외부 변수에 채워주는 '출력 매개변수' 자체를 지양하고, 컴파일러 RVO가 보장되는 <strong>값 반환(Return by value)</strong> 또는 구조화된 바인딩(<code>auto [a, b] = f();</code>)을 적극 권장합니다.
            </p>
            <p style="margin-top: 0.6rem;">
              <strong>3. Core Guidelines Con.1 (기본 불변성 원칙):</strong><br>
              "기본적으로 모든 객체는 <code>const</code>여야 한다." 오직 값이 변경되어야 하는 정당한 이유가 있을 때만 비-const로 선언하는 방어적 프로그래밍을 요구합니다.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6.7 터미널 실습 및 디버깅 -->
    <section id="sec-6-7" class="lesson-section">
      <h3>6.7 터미널 실습 및 컴파일러 오류 디버깅</h3>
      <p>
        6단원에서 학습한 참조자 별칭 바인딩, <code>const T&amp;</code> 임시 객체 수명 연장, <code>static_cast</code> 명시적 타입 변환,
        그리고 안전한 값 반환을 하나의 완전한 프로그램으로 실습합니다.
      </p>

      <div class="code-block-wrap">
        <div class="code-header">
          <span class="file-name">ch06_references.cpp</span>
          <span class="code-lang">C++26</span>
        </div>
        <pre><code>#include &lt;print&gt;
#include &lt;string&gt;

// 1. 참조자를 통한 인플레이스 원본 수정
void add_bonus(int&amp; score, int bonus) &#123;
    score += bonus; // 호출자의 원본 변수 직접 변경
&#125;

// 2. const 참조를 통한 복사 0비용 읽기 전용 열람
void print_profile(const std::string&amp; name, const int&amp; score) &#123;
    std::println("프로필 열람 -&gt; 이름: '&#123;&#125;', 점수: &#123;&#125;점", name, score);
&#125;

// 3. 안전한 값 반환 함수 (RVO 적용)
std::string format_badge(int score) &#123;
    if (score &gt;= 90) return "VIP Gold";
    return "Standard";
&#125;

int main() &#123;
    std::println("=== 1. 참조자 별칭과 원본 동기화 ===");
    int player_score&#123;85&#125;;
    int&amp; score_alias = player_score;

    add_bonus(player_score, 10);
    std::println("보너스 지급 후 점수: &#123;&#125; (별칭 점수: &#123;&#125;)", player_score, score_alias);

    std::println("\n=== 2. const 참조와 임시 객체 수명 연장 ===");
    // 리터럴과 임시 문자열 객체가 const 참조자에 바인딩되어 함수 실행 동안 수명 유지
    print_profile("Alice", 95); 

    std::println("\n=== 3. static_cast 명시적 타입 변환 ===");
    double raw_ratio = 12.875;
    int int_level = static_cast&lt;int&gt;(raw_ratio); // 안전한 소수점 절삭
    std::println("원본 ratio: &#123;&#125; -&gt; static_cast 변환 레벨: &#123;&#125;", raw_ratio, int_level);

    std::println("\n=== 4. 안전한 값 반환(RVO)과 댕글링 방지 ===");
    std::string badge = format_badge(player_score);
    std::println("부여된 뱃지: '&#123;&#125;'", badge);

    return 0;
&#125;</code></pre>
