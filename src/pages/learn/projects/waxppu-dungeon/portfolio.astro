---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { Code } from 'astro:components';

const codeChaosImpact = `// WaxDestructibleComponent.cpp — 국소 Dynamic 전환 + ExternalClusterStrain 인가
ImpactMaskFalloff->SetRadialFalloff(
	1.0f, 0.0f, 1.0f, 0.0f, Radius, WorldImpactPoint, EFieldFalloffType::Field_FallOff_None);
ImpactDynamicState->SetUniformInteger(
	static_cast<int32>(EObjectStateTypeEnum::Chaos_Object_Dynamic));
ImpactLocalDynamic->SetCullingField(
	ImpactMaskFalloff, ImpactDynamicState, EFieldCullingOperationType::Field_Culling_Outside);
ShellCollection->ApplyPhysicsField(
	true, EGeometryCollectionPhysicsTypeEnum::Chaos_DynamicState, nullptr, ImpactLocalDynamic);

ImpactStrainFalloff->SetRadialFalloff(
	EffectiveStrain, 0.85f, 1.0f, 0.0f, Radius, WorldImpactPoint, EFieldFalloffType::Field_Falloff_Linear);
ShellCollection->ApplyPhysicsField(
	true, EGeometryCollectionPhysicsTypeEnum::Chaos_ExternalClusterStrain, nullptr, ImpactStrainFalloff);`;

const codeHybridAudio = `// WaxDestructibleComponent.cpp — 에너지 폴백 · Fechner식 로그 압축 · Poisson 지수 쿨다운
const float DensityGain = FMath::Max(0.65f,
	1.0f / FMath::Pow(static_cast<float>(FMath::Max(1, RecentCollisionTimes.Num())), 0.35f));

const float Mass = FMath::Max(0.2f, CollisionInfo.Mass);
const float ImpulseMag = CollisionInfo.AccumulatedImpulse.Size();
const float ImpactEnergy = (ImpulseMag > KINDA_SMALL_NUMBER)
	? (0.5f * ImpulseMag * NormalSpeed)
	: (0.5f * Mass * NormalSpeed * NormalSpeed); // 임펄스 누락 시 운동에너지 폴백

const float Pressure = FMath::Sqrt(FMath::Max(0.0f, ImpactEnergy));
const float NormPressure = FMath::Clamp((Pressure - 40.0f) / 700.0f, 0.0f, 1.5f);
const float LoudnessAlpha = FMath::Clamp(
	FMath::Loge(1.0f + 5.0f * NormPressure) / FMath::Loge(6.0f), 0.0f, 1.0f);

const float Intensity = FMath::Lerp(0.06f, 0.36f, LoudnessAlpha) * FMath::FRandRange(0.88f, 1.10f) * DensityGain;
const float ExpDelay = -FMath::Loge(FMath::Max(0.05f, FMath::FRand())) * MinCollisionAudioInterval;
NextAllowedCollisionSoundTime = Now + FMath::Clamp(
	ExpDelay, MinCollisionAudioInterval * 0.5f, MinCollisionAudioInterval * 3.0f);`;

const codeButterLoco = `// WaxLocomotionComponent.cpp — 양방향 최단각 선택(HopAlign) & 바닥 접지 캡슐 보정
const float CurrentYaw = OwnerMonster->GetActorRotation().Yaw;
const float DesiredYaw = DirToPlayer.Rotation().Yaw;
const float DeltaFwd  = FMath::FindDeltaAngleDegrees(CurrentYaw, DesiredYaw);
const float DeltaBack = FMath::FindDeltaAngleDegrees(CurrentYaw, DesiredYaw + 180.0f);
const bool bUseBackFace = FMath::Abs(DeltaBack) < FMath::Abs(DeltaFwd);
const float DeltaYaw = bUseBackFace ? DeltaBack : DeltaFwd;

void UWaxButterLocomotionComponent::SetCapsuleHalfHeightKeepFloor(float NewHalfHeight)
{
	if (UCapsuleComponent* Capsule = OwnerMonster->GetCapsuleComponent())
	{
		const float OldHalfHeight = Capsule->GetUnscaledCapsuleHalfHeight();
		if (!FMath::IsNearlyEqual(OldHalfHeight, NewHalfHeight, 0.25f))
		{
			const float DeltaZ = NewHalfHeight - OldHalfHeight;
			Capsule->SetCapsuleHalfHeight(NewHalfHeight, true);
			OwnerMonster->AddActorWorldOffset(FVector(0.0f, 0.0f, DeltaZ), false);
			if (BodyPivot) { BodyPivot->AddRelativeLocation(FVector(0.0f, 0.0f, -DeltaZ)); }
		}
	}
}`;

const codeTargetingMPC = `// WaxPpuLabCharacter.cpp — 부유 타겟 구체 중심 계산 & MPC 파라미터 푸시
const FVector SphereCenter = GetFloatingTargetSphereCenter();
if (UMaterialParameterCollectionInstance* MPCInst = GetWorld()->GetParameterCollectionInstance(TargetingMPC))
{
	MPCInst->SetVectorParameterValue(TEXT("TargetSphereCenter"), FLinearColor(SphereCenter.X, SphereCenter.Y, SphereCenter.Z, 1.0f));
	MPCInst->SetScalarParameterValue(TEXT("TargetSphereRadius"), WaxImpactRadius);
	MPCInst->SetVectorParameterValue(TEXT("MarkerColor"), TargetDecalColor);
	MPCInst->SetScalarParameterValue(TEXT("EmissiveBoost"), TargetDecalEmissiveBoost);
	MPCInst->SetScalarParameterValue(TEXT("MarkerOpacity"), TargetDecalOpacity);
	MPCInst->SetScalarParameterValue(TEXT("EdgeSoftness"), TargetDecalEdgeSoftness);
}`;
