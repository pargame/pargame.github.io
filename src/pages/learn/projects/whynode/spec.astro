  }
  .wp-breadcrumb a {
    color: var(--text-2);
    text-decoration: none;
  }
  .wp-breadcrumb a:hover {
    color: var(--wp-coral);
  }
  .wp-breadcrumb .current {
    color: var(--wp-peach);
    font-weight: 600;
  }

  /* HERO */
  .wp-hero {
    display: flex;
    flex-direction: column;
    gap: 1.7rem;
    padding: 2.2rem;
    border-radius: 24px;
    border: 1px solid var(--wp-border);
    background:
      radial-gradient(circle at 88% 18%, color-mix(in srgb, var(--wp-peach) 16%, transparent), transparent 46%),
      radial-gradient(circle at 12% 92%, color-mix(in srgb, var(--wp-coral) 16%, transparent), transparent 44%),
      var(--wp-surface);
    box-shadow: var(--wp-glow);
  }
  .wp-hero-top {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 1.8rem;
    align-items: center;
  }

  .wp-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.95rem;
  }
  .wp-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
  }
  .wp-pill.status {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    color: var(--wp-coral);
    background: color-mix(in srgb, var(--wp-coral) 14%, transparent);
    border-color: color-mix(in srgb, var(--wp-coral) 38%, transparent);
  }
  .wp-dot {
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 50%;
    background: var(--wp-coral);
    box-shadow: 0 0 8px var(--wp-coral);
  }
  .wp-pill.theme-tag {
    color: var(--wp-peach);
    background: color-mix(in srgb, var(--wp-peach) 13%, transparent);
    border-color: color-mix(in srgb, var(--wp-peach) 35%, transparent);
  }
  .wp-pill.wave-tag {
    color: var(--wp-mint);
    background: color-mix(in srgb, var(--wp-mint) 12%, transparent);
    border-color: color-mix(in srgb, var(--wp-mint) 32%, transparent);
  }

  .wp-hero h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.85rem, 1.4rem + 1.6vw, 2.55rem);
    line-height: 1.18;
    background: linear-gradient(125deg, var(--wp-coral), var(--wp-peach) 62%, var(--wp-mint));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .wp-lead {
    color: var(--text-2);
    font-size: 0.98rem;
    line-height: 1.72;
    margin: 0 0 1.25rem;
  }
  .wp-lead strong {
    color: var(--text-1);
  }

  .wp-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .wp-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.54rem 0.98rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: all var(--dur-fast);
  }
  .wp-btn.primary {
    background: linear-gradient(135deg, var(--wp-coral), var(--wp-peach));
    color: #ffffff;
    border: 1px solid transparent;
  }
  .wp-btn.primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
  .wp-btn.ghost {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-2);
  }
  .wp-btn.ghost:hover {
    border-color: var(--wp-coral);
    color: var(--wp-coral);
  }

  /* MEDIA CARD (PIE CAPTURES) */
  .media-card {
    margin: 0;
    min-width: 0;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-1);
  }
  .media-card.case-shot {
    margin-bottom: 1.2rem;
  }
  .media-card img {
    display: block;
    width: 100%;
    height: auto;
    cursor: zoom-in;
    transition: transform var(--dur);
  }
  .media-card img:hover {
    transform: scale(1.015);
  }
  .media-card figcaption {
    padding: 0.72rem 0.95rem;
    background: var(--surface-2);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.82rem;
    color: var(--text-2);
    line-height: 1.55;
  }
  .media-card figcaption strong {
    color: var(--text-1);
  }

  .wp-exec-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .exec-card {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .exec-card.coral { border-top: 3px solid var(--wp-coral); }
  .exec-card.peach { border-top: 3px solid var(--wp-peach); }
  .exec-card.mint { border-top: 3px solid var(--wp-mint); }
  .exec-k {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-3);
  }
  .exec-v {
    font-family: var(--font-mono);
    font-size: 0.94rem;
    color: var(--text-1);
  }
  .exec-d {
    font-size: 0.78rem;
    color: var(--text-2);
    line-height: 1.46;
  }

  .wp-section-head {
    margin-bottom: 1.1rem;
  }
  .wp-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--wp-coral);
    margin-bottom: 0.3rem;
  }
  .wp-section-head h2 {
    margin: 0;
    font-size: clamp(1.32rem, 1.12rem + 0.75vw, 1.8rem);
  }
  .wp-section-lead {
    margin: 0 0 1.25rem;
    color: var(--text-2);
    line-height: 1.72;
    font-size: 0.94rem;
    max-width: 78ch;
  }

  /* SYSTEM ARCHITECTURE DIAGRAM */
  .arch-figure {
    margin: 0 0 1.3rem;
  }
  .arch-diagram {
    padding: 1.45rem;
    border-radius: 20px;
    background: var(--surface-1);
    border: 1px solid var(--wp-border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .arch-row-label {
    font-family: var(--font-mono);
    font-size: 0.71rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--wp-coral);
  }
  .arch-row-label.sub {
    margin-top: 0.45rem;
    padding-top: 0.95rem;
    border-top: 1px dashed var(--border);
    color: var(--wp-peach);
  }
  .arch-pipeline {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: 0.6rem;
    align-items: stretch;
  }
  .arch-node {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
  }
  .arch-node.accent-coral { border-top: 3px solid var(--wp-coral); }
  .arch-node.accent-peach { border-top: 3px solid var(--wp-peach); }
  .arch-node.accent-mint { border-top: 3px solid var(--wp-mint); }
  .node-tag {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-3);
  }
  .node-title {
    font-family: var(--font-mono);
    font-size: 0.87rem;
    font-weight: 700;
    color: var(--text-1);
    word-break: break-word;
  }
  .node-list {
    margin: 0.18rem 0 0;
    padding-left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.24rem;
    font-size: 0.77rem;
    color: var(--text-2);
    line-height: 1.45;
  }
  .node-desc {
    margin: 0.12rem 0 0;
    font-size: 0.79rem;
    color: var(--text-2);
    line-height: 1.5;
  }
  .arch-conn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    padding: 0 0.1rem;
    text-align: center;
  }
  .conn-fn {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    color: var(--wp-mint);
    white-space: nowrap;
  }
  .conn-arrow {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-3);
  }
  .arch-bottom-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .arch-figure figcaption {
    margin-top: 0.7rem;
    font-size: 0.84rem;
    color: var(--text-3);
    line-height: 1.6;
  }
  .arch-figure figcaption strong {
    color: var(--text-2);
  }

  /* QUICK TOC */
  .wp-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .wp-toc a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.75rem;
    border-radius: 999px;
    background: var(--surface-1);
    border: 1px solid var(--border);
    color: var(--text-2);
    font-size: 0.8rem;
    text-decoration: none;
    transition: all var(--dur-fast);
  }
  .wp-toc a span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--wp-coral);
  }
  .wp-toc a:hover {
    border-color: var(--wp-coral);
    color: var(--text-1);
  }

  /* CASE STUDY GRID */
  .case-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem;
    margin-bottom: 1rem;
  }
  .case-card {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .case-card.intent {
    border-top: 3px solid var(--wp-peach);
  }
  .case-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--wp-peach);
  }
  .case-card h3 {
    margin: 0;
    font-size: 1.08rem;
  }
  .case-card p {
    margin: 0;
    font-size: 0.89rem;
    color: var(--text-2);
    line-height: 1.66;
  }
  .case-card.troubleshoot {
    padding: 0;
    background: transparent;
    border: none;
    gap: 0.85rem;
  }
  .ts-step {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    flex: 1;
  }
  .ts-step.problem { border-left: 3px solid var(--wp-coral); }
  .ts-step.solution { border-left: 3px solid var(--wp-mint); }
  .ts-tag {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .ts-step.problem .ts-tag { color: var(--wp-coral); }
  .ts-step.solution .ts-tag { color: var(--wp-mint); }
  .ts-step h3 {
    margin: 0;
    font-size: 1.02rem;
  }
  .ts-step p {
    margin: 0;
    font-size: 0.87rem;
    color: var(--text-2);
    line-height: 1.64;
  }

  .wp-bullet-list {
    margin: 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.87rem;
    color: var(--text-2);
    line-height: 1.6;
  }
  .wp-bullet-list strong {
    color: var(--text-1);
  }

  .wp-param-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
    margin-top: 0.3rem;
  }
  .wp-param-strip span {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: var(--text-2);
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    padding: 0.22rem 0.52rem;
    border-radius: 8px;
  }

  .wp-preset-mini {
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
    margin-top: 0.3rem;
    padding: 0.68rem 0.85rem;
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    font-size: 0.81rem;
    color: var(--text-2);
  }
  .wp-preset-mini strong {
    color: var(--wp-coral);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .wp-fsm-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding: 0.58rem 0.82rem;
    border-radius: 12px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.77rem;
  }
  .wp-fsm-bar span {
    color: var(--wp-peach);
    font-weight: 700;
  }
  .wp-fsm-bar i {
    font-style: normal;
    color: var(--text-3);
  }

  /* CODE DETAILS (ALL CODE COLLAPSED BY DEFAULT) */
  .wp-code-details {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }
  .wp-code-details summary {
    cursor: pointer;
    padding: 0.82rem 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.79rem;
    font-weight: 600;
    color: var(--text-2);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .wp-code-details summary::before {
    content: '▸';
    color: var(--wp-coral);
    transition: transform var(--dur-fast);
  }
  .wp-code-details[open] summary::before {
    transform: rotate(90deg);
  }
  .wp-code-details summary:hover {
    color: var(--text-1);
  }
  .code-wrap {
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    overflow-x: auto;
  }
  .code-wrap :global(pre) {
    margin: 0 !important;
    padding: 1rem 1.15rem !important;
    border-radius: 0 !important;
  }

  .detail-body {
    border-top: 1px solid var(--border-subtle);
    padding: 0.95rem 1.15rem 1.05rem;
    font-size: 0.84rem;
    color: var(--text-2);
    line-height: 1.62;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .detail-body h4 {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--wp-peach);
  }
  .detail-body ul {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .detail-body p {
    margin: 0;
  }
  .wp-code-details.spaced {
    margin-top: 1rem;
  }
  .arch-figure + .wp-code-details {
    margin: -0.4rem 0 1.3rem;
  }

  /* 3-COL GRID */
  .wp-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .wp-card {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.52rem;
  }
  .wp-card-tag {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 700;
    color: var(--wp-mint);
    letter-spacing: 0.06em;
  }
  .wp-card h3 {
    margin: 0;
    font-size: 1.03rem;
  }
  .wp-card p {
    margin: 0;
    font-size: 0.87rem;
    color: var(--text-2);
    line-height: 1.64;
  }
  .wp-card p strong {
    color: var(--text-1);
  }

  /* ENV & BUDGET BOX */
  .env-box {
    background: var(--wp-surface-soft);
    border: 1px solid var(--wp-border);
    border-radius: 18px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }
  .env-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.25rem;
    font-size: 0.83rem;
    color: var(--text-2);
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .env-meta strong {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: var(--wp-coral);
    margin-right: 0.3rem;
  }
  .wp-split-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .env-col {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.1rem;
  }
  .env-col.keep { border-top: 3px solid var(--wp-mint); }
  .env-col.disable { border-top: 3px solid var(--wp-coral); }
  .env-col-head {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 0.7rem;
  }
  .env-col-head.mint { color: var(--wp-mint); }
  .env-col-head.coral { color: var(--wp-coral); }
  .env-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
  }
  .env-col li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.79rem;
    padding-bottom: 0.38rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .env-col li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .env-col code {
    font-size: 0.74rem;
    color: var(--text-1);
    word-break: break-all;
  }
  .env-col span {
    color: var(--text-3);
    white-space: nowrap;
    font-size: 0.76rem;
  }

  /* KNOWN LIMITATIONS */
  .limit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.05rem;
  }
  .limit-card {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 3px solid var(--wp-peach);
    border-radius: 16px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.48rem;
  }
  .limit-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .limit-tag {
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 700;
    color: var(--wp-peach);
    letter-spacing: 0.05em;
  }
  .limit-head code {
    font-size: 0.71rem;
    color: var(--text-3);
  }
  .limit-card h3 {
    margin: 0;
    font-size: 0.97rem;
  }
  .limit-card p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-2);
    line-height: 1.58;
  }
  .limit-fix {
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--border-subtle);
    font-size: 0.82rem;
    color: var(--text-2);
    line-height: 1.52;
  }
  .limit-fix strong {
    color: var(--wp-mint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* ROADMAP */
  .wp-roadmap-steps {
    list-style: none;
    padding: 0;
    margin: 0 0 1.8rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .wp-roadmap-steps li {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
  }
  .wp-roadmap-steps li.final-step {
    border-color: color-mix(in srgb, var(--wp-mint) 48%, var(--border));
    background: color-mix(in srgb, var(--surface-1) 90%, var(--wp-mint) 10%);
  }
  .rm-idx {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--wp-coral);
  }
  .final-step .rm-idx { color: var(--wp-mint); }
  .wp-roadmap-steps h3 {
    margin: 0;
    font-size: 0.94rem;
  }
  .wp-roadmap-steps p {
    margin: 0;
    font-size: 0.81rem;
    color: var(--text-2);
    line-height: 1.54;
  }

  .wp-bottom-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
