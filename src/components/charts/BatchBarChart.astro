---
export interface BatchRow {
  model: string;
  family: 'flash' | 'gemini4';
  level: 'High' | 'Medium';
  toolTurns: number;
  batchPct: number;
  avgTools: string;
  skewNote?: string;
  dividerBefore?: boolean;
}

interface Props {
  title: string;
  subtitle: string;
  footnote: string;
  maxPct?: number;
  rows: BatchRow[];
}

const { title, subtitle, footnote, maxPct = 45, rows } = Astro.props;
const ticks = [0, 10, 20, 30, 40];
---

<figure class="chart-box wide">
  <div class="chart-head">
    <h3>{title}</h3>
    <p>{subtitle}</p>
  </div>

  <div class="chart-legend">
    <span><i class="swatch flash"></i>Gemini 3.8 Flash</span>
    <span><i class="swatch g4"></i>Gemini 4 계열</span>
    <span><i class="swatch skewed"></i>단일 세션 70%+ 편중</span>
  </div>

  <div class="bar-list" role="list" aria-label={title}>
    {rows.map((r) => {
      const widthPct = Math.max(0.8, Math.min(100, (r.batchPct / maxPct) * 100));
      return (
        <>
          {r.dividerBefore && (
            <div class="family-divider" aria-hidden="true">
              <span>Gemini 4 계열</span>
            </div>
          )}
          <div class="bar-row" role="listitem">
            <div class="row-label">
              <span class="model-name">{r.model}</span>
              <span class="row-meta">
                {r.toolTurns.toLocaleString()}턴
                {r.skewNote && <span class="skew-pill">{r.skewNote}</span>}
              </span>
            </div>
            <div class="bar-track">
              <div
                class={`bar-fill ${r.family} ${r.level.toLowerCase()} ${r.skewNote ? 'is-skewed' : ''}`}
                style={`width: ${widthPct}%`}
              />
            </div>
            <div class="row-val">
              <strong>{r.batchPct.toFixed(1)}%</strong>
              <span class="avg-pill">{r.avgTools}</span>
            </div>
          </div>
        </>
      );
    })}

    <div class="axis-row" aria-hidden="true">
      <div></div>
      <div class="axis-track">
        {ticks.map((t) => (
          <span class="axis-tick" style={`left: ${(t / maxPct) * 100}%`}>{t}%</span>
        ))}
      </div>
      <div></div>
    </div>
  </div>

  <figcaption class="chart-foot">{footnote}</figcaption>

  <details class="raw-table">
    <summary>원본 수치 표 펼쳐 보기</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>모델</th>
            <th>도구 호출 턴</th>
            <th>병렬 배치율 (≥2개)</th>
            <th>호출 시 평균 도구 수</th>
            <th>표본 참고</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>{r.model}</td>
              <td>{r.toolTurns.toLocaleString()}턴</td>
              <td>{r.batchPct.toFixed(1)}%</td>
              <td>{r.avgTools}</td>
              <td>{r.skewNote ?? '분산 세션'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .chart-box {
    margin: 2rem 0;
    padding: 1.5rem 1.6rem;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .chart-head h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    color: var(--text-1);
  }
  .chart-head p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-3);
    line-height: 1.5;
  }
  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1rem 0 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-3);
  }
  .chart-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    display: inline-block;
  }
  .swatch.flash { background: var(--text-3); }
  .swatch.g4 { background: var(--accent); }
  .swatch.skewed {
    background: repeating-linear-gradient(
      -45deg,
      var(--accent),
      var(--accent) 3px,
      color-mix(in srgb, var(--accent) 45%, transparent) 3px,
      color-mix(in srgb, var(--accent) 45%, transparent) 6px
    );
  }

  .bar-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .family-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.35rem 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
  }
  .family-divider::before,
  .family-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-subtle);
  }

  .bar-row {
    display: grid;
    grid-template-columns: 220px 1fr 122px;
    gap: 0.9rem;
    align-items: center;
  }
  .row-label {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .model-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-1);
    line-height: 1.3;
  }
  .row-meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .skew-pill {
    font-size: 0.66rem;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
    color: var(--warn);
    background: color-mix(in srgb, var(--warn) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--warn) 32%, transparent);
  }

  .bar-track {
    height: 22px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    border-radius: 5px;
  }
  .bar-fill.flash.high { background: var(--text-3); }
  .bar-fill.flash.medium { background: color-mix(in srgb, var(--text-3) 65%, transparent); }
  .bar-fill.gemini4.high { background: var(--accent-2); }
  .bar-fill.gemini4.medium { background: var(--accent); }
  .bar-fill.is-skewed {
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.18),
      rgba(255, 255, 255, 0.18) 5px,
      transparent 5px,
      transparent 10px
    );
  }

  .row-val {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .row-val strong {
    font-size: 0.9rem;
    color: var(--text-1);
  }
  .avg-pill {
    font-size: 0.72rem;
    padding: 0.12rem 0.42rem;
    border-radius: 5px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    color: var(--text-2);
  }

  .axis-row {
    display: grid;
    grid-template-columns: 220px 1fr 122px;
    gap: 0.9rem;
    margin-top: 0.1rem;
  }
  .axis-track {
    position: relative;
    height: 18px;
    border-top: 1px solid var(--border-subtle);
  }
  .axis-tick {
    position: absolute;
    top: 3px;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .chart-foot {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.82rem;
    color: var(--text-2);
    line-height: 1.55;
  }

  .raw-table {
    margin-top: 0.85rem;
  }
  .raw-table summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
  .table-scroll {
    overflow-x: auto;
    margin-top: 0.65rem;
  }
  .raw-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .raw-table th, .raw-table td {
    padding: 0.48rem 0.65rem;
    text-align: left;
    border-bottom: 1px solid var(--border-subtle);
  }
  .raw-table th {
    color: var(--text-2);
    background: var(--surface-2);
  }
  .raw-table td {
    color: var(--text-2);
  }

  @media (max-width: 720px) {
    .chart-box { padding: 1.1rem; }
    .bar-row {
      grid-template-columns: 1fr auto;
      gap: 0.35rem 0.6rem;
    }
    .bar-track {
      grid-column: 1 / -1;
      order: 3;
    }
    .axis-row { display: none; }
  }
</style>
