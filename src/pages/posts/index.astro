---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Posts" description="pargame - 소프트웨어 엔지니어링 기술 블로그">
  <div class="posts-header">
    <div class="meta-tag">ARTICLES & ARCHIVES</div>
    <h1>Engineering Posts (기술 블로그)</h1>
    <p class="subtitle">시스템 설계, 디버깅 회고, 성능 최적화 및 언어 구현기</p>
  </div>

  <div class="posts-list">
    <!-- Sample Welcome / Migration Post -->
    <article class="post-item">
      <div class="post-date">2026. 10. 22</div>
      <div class="post-content">
        <h2><a href="/posts/hello-midnight-terminal">블로그 리뉴얼: 가벼운 프레임워크로의 해방과 AI 페어 프로그래밍의 시작</a></h2>
        <p class="post-excerpt">
          기존 무겁고 제한적인 프레임워크를 탈피하여, Astro와 Gemini Pro AI 에이전틱 협업을 통해 나만의 독자적인 엔지니어링 지식 허브를 구축한 배경과 철학.
        </p>
        <div class="post-tags">
          <span class="tag">#Astro</span>
          <span class="tag">#GitHubPages</span>
          <span class="tag">#Architecture</span>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .posts-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 2.5rem;
  }
  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .posts-header h1 {
    margin: 0 0 0.5rem;
  }
  .subtitle {
    color: var(--text-3);
  }
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .post-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: all var(--dur-fast);
  }
  .post-item:hover {
    border-color: var(--accent);
    transform: translateX(4px);
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-3);
  }
  .post-content h2 {
    margin: 0 0 0.6rem;
    font-size: 1.25rem;
  }
  .post-content h2 a {
    text-decoration: none;
    color: var(--text-1);
  }
  .post-content h2 a:hover {
    color: var(--accent);
  }
  .post-excerpt {
    font-size: 0.95rem;
    color: var(--text-2);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .post-tags {
    display: flex;
    gap: 0.5rem;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .post-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
