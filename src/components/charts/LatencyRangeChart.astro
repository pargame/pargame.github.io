---
export interface RangeRow {
  model: string;
  family: 'flash' | 'gemini4';
  n: number;
  sessions: number;
  median: number;
  p90: number;
  skewNote?: string;
  dividerBefore?: boolean;
}

interface Props {
  title: string;
  subtitle: string;
  footnote: string;
  maxSec?: number;
  rows: RangeRow[];
}

const { title, subtitle, footnote, maxSec = 40, rows } = Astro.props;
const ticks = [0, 10, 20, 30, 40];
---

<figure class="chart-box wide">
  <div class="chart-head">
    <h3>{title}</h3>
    <p>{subtitle}</p>
  </div>

  <div class="chart-legend">
    <span><i class="dot-legend"></i>중앙값 (Median)</span>
    <span><i class="diamond-legend"></i>상위 90% (P90)</span>
    <span><i class="line-legend"></i>중앙값 ~ P90 꼬리 구간</span>
  </div>

  <div class="range-list" role="list" aria-label={title}>
    {rows.map((r) => {
      const leftPct = (r.median / maxSec) * 100;
      const rightPct = (r.p90 / maxSec) * 100;
      const spanPct = Math.max(1, rightPct - leftPct);
      return (
        <>
          {r.dividerBefore && (
            <div class="family-divider" aria-hidden="true">
              <span>Gemini 4 계열</span>
            </div>
          )}
          <div class="range-row" role="listitem">
            <div class="row-label">
              <span class="model-name">{r.model}</span>
              <span class="row-meta">
                n={r.n} · {r.sessions}세션
                {r.skewNote && <span class="skew-pill">{r.skewNote}</span>}
              </span>
            </div>
            <div class="range-track">
              {ticks.slice(1, -1).map((t) => (
                <span class="grid-line" style={`left: ${(t / maxSec) * 100}%`} aria-hidden="true" />
              ))}
              <span
                class={`range-span ${r.family}`}
                style={`left: ${leftPct}%; width: ${spanPct}%`}
              />
              <span
                class={`marker-med ${r.family}`}
                style={`left: ${leftPct}%`}
                title={`중앙값 ${r.median}s`}
              />
              <span
                class={`marker-p90 ${r.family}`}
                style={`left: ${rightPct}%`}
                title={`P90 ${r.p90}s`}
              />
            </div>
            <div class="row-val">
              <strong>{r.median}s</strong>
              <span class="sep">–</span>
              <span class="p90-val">{r.p90}s</span>
            </div>
          </div>
        </>
      );
    })}

    <div class="axis-row" aria-hidden="true">
      <div></div>
      <div class="axis-track">
        {ticks.map((t) => (
          <span class="axis-tick" style={`left: ${(t / maxSec) * 100}%`}>{t}s</span>
        ))}
      </div>
      <div></div>
    </div>
  </div>

  <figcaption class="chart-foot">{footnote}</figcaption>

  <details class="raw-table">
    <summary>원본 수치 표 펼쳐 보기</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>모델</th>
            <th>표본 스텝 (n)</th>
            <th>세션 수</th>
            <th>중앙값</th>
            <th>P90</th>
            <th>표본 참고</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>{r.model}</td>
              <td>{r.n}</td>
              <td>{r.sessions}개</td>
              <td>{r.median}s</td>
              <td>{r.p90}s</td>
              <td>{r.skewNote ?? '분산 세션'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .chart-box {
    margin: 2rem 0;
    padding: 1.5rem 1.6rem;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .chart-head h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    color: var(--text-1);
  }
  .chart-head p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-3);
    line-height: 1.5;
  }
  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin: 1rem 0 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-3);
  }
  .chart-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .dot-legend {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }
  .diamond-legend {
    width: 9px;
    height: 9px;
    background: var(--accent-2);
    transform: rotate(45deg);
    display: inline-block;
  }
  .line-legend {
    width: 18px;
    height: 4px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--accent) 45%, transparent);
    display: inline-block;
  }

  .range-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .family-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.3rem 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
  }
  .family-divider::before,
  .family-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-subtle);
  }

  .range-row {
    display: grid;
    grid-template-columns: 220px 1fr 112px;
    gap: 0.9rem;
    align-items: center;
  }
  .row-label {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .model-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-1);
    line-height: 1.3;
  }
  .row-meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .skew-pill {
    font-size: 0.66rem;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
    color: var(--warn);
    background: color-mix(in srgb, var(--warn) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--warn) 32%, transparent);
  }

  .range-track {
    position: relative;
    height: 24px;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
  }
  .grid-line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border-subtle);
  }
  .range-span {
    position: absolute;
    top: 50%;
    height: 5px;
    transform: translateY(-50%);
    border-radius: 3px;
  }
  .range-span.flash { background: color-mix(in srgb, var(--text-3) 55%, transparent); }
  .range-span.gemini4 { background: color-mix(in srgb, var(--accent) 45%, transparent); }

  .marker-med {
    position: absolute;
    top: 50%;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    border: 2px solid var(--surface-1);
  }
  .marker-med.flash { background: var(--text-2); }
  .marker-med.gemini4 { background: var(--accent); }

  .marker-p90 {
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    transform: translate(-50%, -50%) rotate(45deg);
    border: 1.5px solid var(--surface-1);
  }
  .marker-p90.flash { background: var(--text-3); }
  .marker-p90.gemini4 { background: var(--accent-2); }

  .row-val {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.28rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
  }
  .row-val strong { color: var(--text-1); }
  .sep { color: var(--text-3); }
  .p90-val { color: var(--text-2); }

  .axis-row {
    display: grid;
    grid-template-columns: 220px 1fr 112px;
    gap: 0.9rem;
    margin-top: 0.1rem;
  }
  .axis-track {
    position: relative;
    height: 18px;
    border-top: 1px solid var(--border-subtle);
  }
  .axis-tick {
    position: absolute;
    top: 3px;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .chart-foot {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.82rem;
    color: var(--text-2);
    line-height: 1.55;
  }

  .raw-table {
    margin-top: 0.85rem;
  }
  .raw-table summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
  .table-scroll {
    overflow-x: auto;
    margin-top: 0.65rem;
  }
  .raw-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .raw-table th, .raw-table td {
    padding: 0.48rem 0.65rem;
    text-align: left;
    border-bottom: 1px solid var(--border-subtle);
  }
  .raw-table th {
    color: var(--text-2);
    background: var(--surface-2);
  }
  .raw-table td {
    color: var(--text-2);
  }

  @media (max-width: 720px) {
    .chart-box { padding: 1.1rem; }
    .range-row {
      grid-template-columns: 1fr auto;
      gap: 0.35rem 0.6rem;
    }
    .range-track {
      grid-column: 1 / -1;
      order: 3;
    }
    .axis-row { display: none; }
  }
</style>
