const codeToolchainZshrc = `# ~/.zshrc — 전역 xcode-select를 훼손하지 않는 UE 5.9 툴체인 격리 스위칭
ue-on() {
    local xcode_dev="/Applications/Xcode.app/Contents/Developer"
    if [ ! -d "$xcode_dev" ]; then
        local matches=(/Applications/Xcode*26.1.1*.app/Contents/Developer(N))
        if (( \${#matches} > 0 )); then
            xcode_dev="\${matches[1]}"
        fi
    fi
    if [ ! -d "$xcode_dev" ]; then
        echo "[UE] Xcode가 설치되지 않았습니다: $xcode_dev"
        return 1
    fi
    export DEVELOPER_DIR="$xcode_dev"
    launchctl setenv DEVELOPER_DIR "$xcode_dev"
    echo "[UE] 언리얼 툴체인 활성화됨 → $(xcode-select -p)"
}

ue-off() {
    unset DEVELOPER_DIR
    launchctl unsetenv DEVELOPER_DIR
    echo "[UE] 기본 툴체인 복귀됨 → $(xcode-select -p)"
}

ue-status() {
    local launchd_dir
    launchd_dir=$(launchctl getenv DEVELOPER_DIR)
    if [ -n "$DEVELOPER_DIR" ] || [ -n "$launchd_dir" ]; then
        echo "[UE] 현재 상태: 언리얼 모드 (DEVELOPER_DIR=\${DEVELOPER_DIR:-$launchd_dir})"
    else
        echo "[UE] 현재 상태: 기본 모드 ($(xcode-select -p))"
    fi
}`;

